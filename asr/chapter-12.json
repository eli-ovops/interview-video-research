				"to": "00:03:14,020"
			},
			"offsets": {
				"from": 191220,
				"to": 194020
			},
			"text": "那都是世界上最顶尖的聪明人的"
		},
		{
			"timestamps": {
				"from": "00:03:14,020",
				"to": "00:03:14,800"
			},
			"offsets": {
				"from": 194020,
				"to": 194800
			},
			"text": "我的笑有"
		},
		{
			"timestamps": {
				"from": "00:03:16,080",
				"to": "00:03:19,080"
			},
			"offsets": {
				"from": 196080,
				"to": 199080
			},
			"text": "但他們都是說健身就喊"
		},
		{
			"timestamps": {
				"from": "00:03:20,180",
				"to": "00:03:21,820"
			},
			"offsets": {
				"from": 200180,
				"to": 201820
			},
			"text": "他們怎麼被騙了"
		},
		{
			"timestamps": {
				"from": "00:03:21,820",
				"to": "00:03:23,060"
			},
			"offsets": {
				"from": 201820,
				"to": 203060
			},
			"text": "我覺得就是剛才講"
		},
		{
			"timestamps": {
				"from": "00:03:23,420",
				"to": "00:03:26,580"
			},
			"offsets": {
				"from": 203420,
				"to": 206580
			},
			"text": "這個人那有時候屁股決定腦袋"
		},
		{
			"timestamps": {
				"from": "00:03:26,980",
				"to": "00:03:28,540"
			},
			"offsets": {
				"from": 206980,
				"to": 208540
			},
			"text": "他沒有做出改變之前"
		},
		{
			"timestamps": {
				"from": "00:03:28,540",
				"to": "00:03:29,900"
			},
			"offsets": {
				"from": 208540,
				"to": 209900
			},
			"text": "因為他不是伯基"
		},
		{
			"timestamps": {
				"from": "00:03:30,160",
				"to": "00:03:31,440"
			},
			"offsets": {
				"from": 210160,
				"to": 211440
			},
			"text": "所以他就會說"
		},
		{
			"timestamps": {
				"from": "00:03:32,460",
				"to": "00:03:33,480"
			},
			"offsets": {
				"from": 212460,
				"to": 213480
			},
			"text": "我是胖子"
		},
		{
			"timestamps": {
				"from": "00:03:33,740",
				"to": "00:03:35,020"
			},
			"offsets": {
				"from": 213740,
				"to": 215020
			},
			"text": "或者我是這個"
		},
		{
			"timestamps": {
				"from": "00:03:35,280",
				"to": "00:03:36,040"
			},
			"offsets": {
				"from": 215280,
				"to": 216040
			},
			"text": "大肚子"
		},
		{
			"timestamps": {
				"from": "00:03:36,040",
				"to": "00:03:37,580"
			},
			"offsets": {
				"from": 216040,
				"to": 217580
			},
			"text": "那我要為大肚子說話"
		},
		{
			"timestamps": {
				"from": "00:03:37,580",
				"to": "00:03:38,420"
			},
			"offsets": {
				"from": 217580,
				"to": 218420
			},
			"text": "對"
		},
		{
			"timestamps": {
				"from": "00:03:38,420",
				"to": "00:03:39,580"
			},
			"offsets": {
				"from": 218420,
				"to": 219580
			},
			"text": "對屁股決定腦袋"
		},
		{
			"timestamps": {
				"from": "00:03:39,580",
				"to": "00:03:40,400"
			},
			"offsets": {
				"from": 219580,
				"to": 220400
			},
			"text": "但這就是"
		},
		{
			"timestamps": {
				"from": "00:03:40,400",
				"to": "00:03:41,380"
			},
			"offsets": {
				"from": 220400,
				"to": 221380
			},
			"text": "我可以理解"
		},
		{
			"timestamps": {
				"from": "00:03:41,380",
				"to": "00:03:42,400"
			},
			"offsets": {
				"from": 221380,
				"to": 222400
			},
			"text": "但這是不客觀的"
		},
		{
			"timestamps": {
				"from": "00:03:42,400",
				"to": "00:03:45,000"
			},
			"offsets": {
				"from": 222400,
				"to": 225000
			},
			"text": "這是在不尊重科學和不尊重事實"
		},
		{
			"timestamps": {
				"from": "00:03:45,520",
				"to": "00:03:48,920"
			},
			"offsets": {
				"from": 225520,
				"to": 228920
			},
			"text": "对 这个就有点像是 比如说我是一个穷人"
		},
		{
			"timestamps": {
				"from": "00:03:48,920",
				"to": "00:03:51,120"
			},
			"offsets": {
				"from": 228920,
				"to": 231120
			},
			"text": "我不想怎么变成负人"
		},
		{
			"timestamps": {
				"from": "00:03:51,120",
				"to": "00:03:52,920"
			},
			"offsets": {
				"from": 231120,
				"to": 232920
			},
			"text": "对 你就是说钱没用 钱没用"
		},
		{
			"timestamps": {
				"from": "00:03:52,920",
				"to": "00:03:54,720"
			},
			"offsets": {
				"from": 232920,
				"to": 234720
			},
			"text": "哎 我就是说钱没用"
		},
		{
			"timestamps": {
				"from": "00:03:54,720",
				"to": "00:03:57,720"
			},
			"offsets": {
				"from": 234720,
				"to": 237720
			},
			"text": "而且说 你看那个钱会导致你"
		},
		{
			"timestamps": {
				"from": "00:03:57,720",
				"to": "00:04:00,520"
			},
			"offsets": {
				"from": 237720,
				"to": 240520
			},
			"text": "你说很多负人家里因为一点钱发生一起"
		},
		{
			"timestamps": {
				"from": "00:04:00,520",
				"to": "00:04:02,720"
			},
			"offsets": {
				"from": 240520,
				"to": 242720
			},
			"text": "凶杀岸 全家都被杀了"
		},
		{
			"timestamps": {
				"from": "00:04:02,720",
				"to": "00:04:05,720"
			},
			"offsets": {
				"from": 242720,
				"to": 245720
			},
			"text": "你看这个钱是 严重就是"
		},
		{
			"timestamps": {
				"from": "00:04:05,720",
				"to": "00:04:07,920"
			},
			"offsets": {
				"from": 245720,
				"to": 247920
			},
			"text": "阻碍这个家庭幸福"
		},
		{
			"timestamps": {
				"from": "00:04:07,920",
				"to": "00:04:10,420"
			},
			"offsets": {
				"from": 247920,
				"to": 250420
			},
			"text": "所以我穷是有原因的"
		},
		{
			"timestamps": {
				"from": "00:04:10,420",
				"to": "00:04:11,920"
			},
			"offsets": {
				"from": 250420,
				"to": 251920
			},
			"text": "我是选择不负"
		},
		{
			"timestamps": {
				"from": "00:04:11,920",
				"to": "00:04:13,720"
			},
			"offsets": {
				"from": 251920,
				"to": 253720
			},
			"text": "我擁有的是選擇不募"
		},
		{
			"timestamps": {
				"from": "00:04:13,720",
				"to": "00:04:17,020"
			},
			"offsets": {
				"from": 253720,
				"to": 257020
			},
			"text": "而且越聰明的人"
		},
		{
			"timestamps": {
				"from": "00:04:17,020",
				"to": "00:04:18,060"
			},
			"offsets": {
				"from": 257020,
				"to": 258060
			},
			"text": "越有這個黨"
		},
		{
			"timestamps": {
				"from": "00:04:18,060",
				"to": "00:04:20,320"
			},
			"offsets": {
				"from": 258060,
				"to": 260320
			},
			"text": "他就越容易受到這個屁股決定打他"
		},
		{
			"timestamps": {
				"from": "00:04:20,320",
				"to": "00:04:26,460"
			},
			"offsets": {
				"from": 260320,
				"to": 266460
			},
			"text": "他就說我就是似乎就是不去弄這個事"
		},
		{
			"timestamps": {
				"from": "00:04:26,460",
				"to": "00:04:29,160"
			},
			"offsets": {
				"from": 266460,
				"to": 269160
			},
			"text": "而且還發明了很多理論"
		},
		{
			"timestamps": {
				"from": "00:04:29,160",
				"to": "00:04:32,000"
			},
			"offsets": {
				"from": 269160,
				"to": 272000
			},
			"text": "可能還嘲笑這個鏈的人"
		},
		{
			"timestamps": {
				"from": "00:04:32,000",
				"to": "00:04:35,300"
			},
			"offsets": {
				"from": 272000,
				"to": 275300
			},
			"text": "就是所有我說為什麼你一戀就會遭到季度"
		},
		{
			"timestamps": {
				"from": "00:04:35,300",
				"to": "00:04:36,960"
			},
			"offsets": {
				"from": 275300,
				"to": 276960
			},
			"text": "因為周邊的就會指責你"
		},
		{
			"timestamps": {
				"from": "00:04:36,960",
				"to": "00:04:41,400"
			},
			"offsets": {
				"from": 276960,
				"to": 281400
			},
			"text": "而且他們有這個很強大的東西去侵略"
		},
		{
			"timestamps": {
				"from": "00:04:41,400",
				"to": "00:04:48,080"
			},
			"offsets": {
				"from": 281400,
				"to": 288080
			},
			"text": "所以我就觉得我为什么能跳出这个理论"
		},
		{
			"timestamps": {
				"from": "00:04:48,080",
				"to": "00:04:50,280"
			},
			"offsets": {
				"from": 288080,
				"to": 290280
			},
			"text": "虽然现在我还是大动难"
		},
		{
			"timestamps": {
				"from": "00:04:50,280",
				"to": "00:04:52,200"
			},
			"offsets": {
				"from": 290280,
				"to": 292200
			},
			"text": "所以现在走在伯祭的路上"
		},
		{
			"timestamps": {
				"from": "00:04:52,200",
				"to": "00:04:54,080"
			},
			"offsets": {
				"from": 292200,
				"to": 294080
			},
			"text": "所以代表了一个思维更新了"
		},
		{
			"timestamps": {
				"from": "00:04:54,080",
				"to": "00:04:55,920"
			},
			"offsets": {
				"from": 294080,
				"to": 295920
			},
			"text": "思维彻底更新了"
		},
		{
			"timestamps": {
				"from": "00:04:55,920",
				"to": "00:04:58,600"
			},
			"offsets": {
				"from": 295920,
				"to": 298600
			},
			"text": "思维就是改革开放"
		},
		{
			"timestamps": {
				"from": "00:04:58,600",
				"to": "00:05:02,560"
			},
			"offsets": {
				"from": 298600,
				"to": 302560
			},
			"text": "中国改革开放等个小平走上改革开放之路"
		},
		{
			"timestamps": {
				"from": "00:05:02,560",
				"to": "00:05:05,000"
			},
			"offsets": {
				"from": 302560,
				"to": 305000
			},
			"text": "改革开放之路也不好走"
		},
		{
			"timestamps": {
				"from": "00:05:05,000",
				"to": "00:05:08,040"
			},
			"offsets": {
				"from": 305000,
				"to": 308040
			},
			"text": "当时的时候就说投机倒罢"
		},
		{
			"timestamps": {
				"from": "00:05:08,040",
				"to": "00:05:10,920"
			},
			"offsets": {
				"from": 308040,
				"to": 310920
			},
			"text": "你做生意高买低卖属于投机倒罢"
		},
		{
			"timestamps": {
				"from": "00:05:10,920",
				"to": "00:05:13,200"
			},
			"offsets": {
				"from": 310920,
				"to": 313200
			},
			"text": "抓起來的呀,當然要抓起來"
		},
		{
			"timestamps": {
				"from": "00:05:13,200",
				"to": "00:05:16,840"
			},
			"offsets": {
				"from": 313200,
				"to": 316840
			},
			"text": "對吧,有的人說不對,說你的這個換這個思路了"
		},
		{
			"timestamps": {
				"from": "00:05:16,840",
				"to": "00:05:19,560"
			},
			"offsets": {
				"from": 316840,
				"to": 319560
			},
			"text": "腦子不對,不僅不抓起來還是反的"
		},
		{
			"timestamps": {
				"from": "00:05:19,560",
				"to": "00:05:24,440"
			},
			"offsets": {
				"from": 319560,
				"to": 324440
			},
			"text": "就說他能夠這個第一買,高買是他的本事"
		},
		{
			"timestamps": {
				"from": "00:05:24,440",
				"to": "00:05:27,360"
			},
			"offsets": {
				"from": 324440,
				"to": 327360
			},
			"text": "這證明他能夠讓消費者"
		},
		{
			"timestamps": {
				"from": "00:05:27,360",
				"to": "00:05:28,960"
			},
			"offsets": {
				"from": 327360,
				"to": 328960
			},
			"text": "能夠買到更便宜的東西"
		},
		{
			"timestamps": {
				"from": "00:05:28,960",
				"to": "00:05:31,280"
			},
			"offsets": {
				"from": 328960,
				"to": 331280
			},
			"text": "因為他腳賣出去,這明明是便宜嘛"
		},
		{
			"timestamps": {
				"from": "00:05:31,280",
				"to": "00:05:34,680"
			},
			"offsets": {
				"from": 331280,
				"to": 334680
			},
			"text": "對不對,那如果我在美國買一個東西便宜的"
		},
		{
			"timestamps": {
				"from": "00:05:34,680",
				"to": "00:05:35,760"
			},
			"offsets": {
				"from": 334680,
				"to": 335760
			},
			"text": "我來中國賣"
		},
		{
			"timestamps": {
				"from": "00:05:35,760",
				"to": "00:05:38,120"
			},
			"offsets": {
				"from": 335760,
				"to": 338120
			},
			"text": "其實不僅沒賣賺中國人的錢"
		},
		{
			"timestamps": {
				"from": "00:05:38,120",
				"to": "00:06:08,120"
			},
			"offsets": {
				"from": 338120,
				"to": 368120
			},
			"text": "反而给中国人带大学家科技带大学家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家家"
		},
		{
			"timestamps": {
				"from": "00:06:08,120",
				"to": "00:06:09,920"
			},
			"offsets": {
				"from": 368120,
				"to": 369920
			},
			"text": "我觉得这个思想就是"
		},
		{
			"timestamps": {
				"from": "00:06:10,160",
				"to": "00:06:12,120"
			},
			"offsets": {
				"from": 370160,
				"to": 372120
			},
			"text": "由这个闭关锁国"
		},
		{
			"timestamps": {
				"from": "00:06:12,480",
				"to": "00:06:14,000"
			},
			"offsets": {
				"from": 372480,
				"to": 374000
			},
			"text": "走向改个开放"
		},
		{
			"timestamps": {
				"from": "00:06:14,260",
				"to": "00:06:15,280"
			},
			"offsets": {
				"from": 374260,
				"to": 375280
			},
			"text": "最关键"
		},
		{
			"timestamps": {
				"from": "00:06:15,540",
				"to": "00:06:16,320"
			},
			"offsets": {
				"from": 375540,
				"to": 376320
			},
			"text": "我就最关键"
		},
		{
			"timestamps": {
				"from": "00:06:16,560",
				"to": "00:06:19,900"
			},
			"offsets": {
				"from": 376560,
				"to": 379900
			},
			"text": "所以所有人其实听到我们这个颇克斯的都不用急着练"
		},
		{
			"timestamps": {
				"from": "00:06:20,160",
				"to": "00:06:20,420"
			},
			"offsets": {
				"from": 380160,
				"to": 380420
			},
			"text": "激热"
		},
		{
			"timestamps": {
				"from": "00:06:20,660",
				"to": "00:06:22,460"
			},
			"offsets": {
				"from": 380660,
				"to": 382460
			},
			"text": "你自己去问"
		},
		{
			"timestamps": {
				"from": "00:06:22,720",
				"to": "00:06:25,260"
			},
			"offsets": {
				"from": 382720,
				"to": 385260
			},
			"text": "不用不用就我们的结论你自己去问"
		},
		{
