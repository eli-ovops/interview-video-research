				"from": 216500,
				"to": 220840
			},
			"text": "不是 当时我记得张雪峰其实还推见过有些职业也不错"
		},
		{
			"timestamps": {
				"from": "00:03:41,100",
				"to": "00:03:42,620"
			},
			"offsets": {
				"from": 221100,
				"to": 222620
			},
			"text": "其实比如说你可以去考"
		},
		{
			"timestamps": {
				"from": "00:03:42,880",
				"to": "00:03:44,940"
			},
			"offsets": {
				"from": 222880,
				"to": 224940
			},
			"text": "比如说同样的高考分数线"
		},
		{
			"timestamps": {
				"from": "00:03:45,200",
				"to": "00:03:48,000"
			},
			"offsets": {
				"from": 225200,
				"to": 228000
			},
			"text": "你不一定要考青蛙北大 因为青蛙北大是这种"
		},
		{
			"timestamps": {
				"from": "00:03:48,260",
				"to": "00:03:49,540"
			},
			"offsets": {
				"from": 228260,
				"to": 229540
			},
			"text": "竞争特别高的 对吧"
		},
		{
			"timestamps": {
				"from": "00:03:49,800",
				"to": "00:03:55,180"
			},
			"offsets": {
				"from": 229800,
				"to": 235180
			},
			"text": "同样分数 你第一名你可以考过什么中国海关学院什么福建海关学院"
		},
		{
			"timestamps": {
				"from": "00:03:55,440",
				"to": "00:03:57,220"
			},
			"offsets": {
				"from": 235440,
				"to": 237220
			},
			"text": "你听伤好像很差"
		},
		{
			"timestamps": {
				"from": "00:03:57,480",
				"to": "00:04:00,800"
			},
			"offsets": {
				"from": 237480,
				"to": 240800
			},
			"text": "但实际上那个毕业出来就进海关 那个前途是最好的"
		},
		{
			"timestamps": {
				"from": "00:04:01,060",
				"to": "00:04:07,200"
			},
			"offsets": {
				"from": 241060,
				"to": 247200
			},
			"text": "张雪峰有很多类似理论就这种小中专业器这些现在也却全部可以覆盖"
		},
		{
			"timestamps": {
				"from": "00:04:07,460",
				"to": "00:04:10,020"
			},
			"offsets": {
				"from": 247460,
				"to": 250020
			},
			"text": "所以你就是我觉得就先不急着下决定"
		},
		{
			"timestamps": {
				"from": "00:04:10,280",
				"to": "00:04:12,320"
			},
			"offsets": {
				"from": 250280,
				"to": 252320
			},
			"text": "你可以先看它一百个转移"
		},
		{
			"timestamps": {
				"from": "00:04:13,100",
				"to": "00:04:13,600"
			},
			"offsets": {
				"from": 253100,
				"to": 253600
			},
			"text": "对不对"
		},
		{
			"timestamps": {
				"from": "00:04:13,860",
				"to": "00:04:20,260"
			},
			"offsets": {
				"from": 253860,
				"to": 260260
			},
			"text": "就有时候我们这个人很多做决定最大以前的一个问题就是受限于信息太傻"
		},
		{
			"timestamps": {
				"from": "00:04:20,780",
				"to": "00:04:24,100"
			},
			"offsets": {
				"from": 260780,
				"to": 264100
			},
			"text": "现在你个决定也无所谓对错但你不知道吧"
		},
		{
			"timestamps": {
				"from": "00:04:24,360",
				"to": "00:04:28,200"
			},
			"offsets": {
				"from": 264360,
				"to": 268200
			},
			"text": "就现在我们就先把信息打开先把地图打开"
		},
		{
			"timestamps": {
				"from": "00:04:28,200",
				"to": "00:04:32,280"
			},
			"offsets": {
				"from": 268200,
				"to": 272280
			},
			"text": "跟我们玩大家知道我老的也玩过红井星期对吧"
		},
		{
			"timestamps": {
				"from": "00:04:32,280",
				"to": "00:04:34,280"
			},
			"offsets": {
				"from": 272280,
				"to": 274280
			},
			"text": "开图全图打开"
		},
		{
			"timestamps": {
				"from": "00:04:34,280",
				"to": "00:04:36,920"
			},
			"offsets": {
				"from": 274280,
				"to": 276920
			},
			"text": "对开图现在就吃到怎么玩"
		},
		{
			"timestamps": {
				"from": "00:04:36,920",
				"to": "00:04:41,880"
			},
			"offsets": {
				"from": 276920,
				"to": 281880
			},
			"text": "开图对吧我们这个玩游戏里边一个基本的一个理论"
		},
		{
			"timestamps": {
				"from": "00:04:41,880",
				"to": "00:04:42,840"
			},
			"offsets": {
				"from": 281880,
				"to": 282840
			},
			"text": "开图开图"
		},
		{
			"timestamps": {
				"from": "00:04:42,840",
				"to": "00:04:46,120"
			},
			"offsets": {
				"from": 282840,
				"to": 286120
			},
			"text": "开挂就是开图所以有了AI类似于开挂"
		},
		{
			"timestamps": {
				"from": "00:04:46,120",
				"to": "00:04:47,720"
			},
			"offsets": {
				"from": 286120,
				"to": 287720
			},
			"text": "你就有了更多的信息"
		},
		{
			"timestamps": {
				"from": "00:04:47,720",
				"to": "00:04:49,400"
			},
			"offsets": {
				"from": 287720,
				"to": 289400
			},
			"text": "有了信息之后就不需要做决定"
		},
		{
			"timestamps": {
				"from": "00:04:49,400",
				"to": "00:04:50,480"
			},
			"offsets": {
				"from": 289400,
				"to": 290480
			},
			"text": "因为你有足够的信息"
		},
		{
			"timestamps": {
				"from": "00:04:50,480",
				"to": "00:04:53,080"
			},
			"offsets": {
				"from": 290480,
				"to": 293080
			},
			"text": "你就这做决定是在没有信息的情况下"
		},
		{
			"timestamps": {
				"from": "00:04:53,080",
				"to": "00:04:55,900"
			},
			"offsets": {
				"from": 293080,
				"to": 295900
			},
			"text": "你可以有了信息之后 你就知道该选什么"
		},
		{
			"timestamps": {
				"from": "00:04:55,900",
				"to": "00:04:59,360"
			},
			"offsets": {
				"from": 295900,
				"to": 299360
			},
			"text": "你说太对了 我再给大家举个例子 玩游戏的人都懂"
		},
		{
			"timestamps": {
				"from": "00:04:59,360",
				"to": "00:05:00,260"
			},
			"offsets": {
				"from": 299360,
				"to": 300260
			},
			"text": "是什么呢"
		},
		{
			"timestamps": {
				"from": "00:05:00,260",
				"to": "00:05:05,020"
			},
			"offsets": {
				"from": 300260,
				"to": 305020
			},
			"text": "好多人以前我们玩红警玩星机 以前我们的同促车搭一起玩"
		},
		{
			"timestamps": {
				"from": "00:05:05,020",
				"to": "00:05:07,660"
			},
			"offsets": {
				"from": 305020,
				"to": 307660
			},
			"text": "有很多人很适合逼门造车"
		},
		{
			"timestamps": {
				"from": "00:05:07,660",
				"to": "00:05:10,220"
			},
			"offsets": {
				"from": 307660,
				"to": 310220
			},
			"text": "对他自己就让他一直重填 一直发展"
		},
		{
			"timestamps": {
				"from": "00:05:10,220",
				"to": "00:05:13,080"
			},
			"offsets": {
				"from": 310220,
				"to": 313080
			},
			"text": "然后就生产兵就去打别人"
		},
		{
			"timestamps": {
				"from": "00:05:13,080",
				"to": "00:05:16,120"
			},
			"offsets": {
				"from": 313080,
				"to": 316120
			},
			"text": "这种其实就是一种稍微背一点做"
		},
		{
			"timestamps": {
				"from": "00:05:16,120",
				"to": "00:05:17,920"
			},
			"offsets": {
				"from": 316120,
				"to": 317920
			},
			"text": "聪明一点的做到什么呢"
		},
		{
			"timestamps": {
				"from": "00:05:17,920",
				"to": "00:05:19,960"
			},
			"offsets": {
				"from": 317920,
				"to": 319960
			},
			"text": "先造一些翅后"
		},
		{
			"timestamps": {
				"from": "00:05:19,960",
				"to": "00:05:21,480"
			},
			"offsets": {
				"from": 319960,
				"to": 321480
			},
			"text": "先探图"
		},
		{
			"timestamps": {
				"from": "00:05:21,480",
				"to": "00:05:24,820"
			},
			"offsets": {
				"from": 321480,
				"to": 324820
			},
			"text": "那麼那個土豆炭了哪裏有資源"
		},
		{
			"timestamps": {
				"from": "00:05:24,820",
				"to": "00:05:28,780"
			},
			"offsets": {
				"from": 324820,
				"to": 328780
			},
			"text": "哪裏有黃金哪裏有對方的兵"
		},
		{
			"timestamps": {
				"from": "00:05:28,780",
				"to": "00:05:31,220"
			},
			"offsets": {
				"from": 328780,
				"to": 331220
			},
			"text": "然後對方的兵他煮造什麼"
		},
		{
			"timestamps": {
				"from": "00:05:31,220",
				"to": "00:05:33,980"
			},
			"offsets": {
				"from": 331220,
				"to": 333980
			},
			"text": "你全部都心裡都門清了"
		},
		{
			"timestamps": {
				"from": "00:05:34,480",
				"to": "00:05:36,960"
			},
			"offsets": {
				"from": 334480,
				"to": 336960
			},
			"text": "然後你針對性的造"
		},
		{
			"timestamps": {
				"from": "00:05:36,960",
				"to": "00:05:38,460"
			},
			"offsets": {
				"from": 336960,
				"to": 338460
			},
			"text": "針對性的才"
		},
		{
			"timestamps": {
				"from": "00:05:38,460",
				"to": "00:05:41,320"
			},
			"offsets": {
				"from": 338460,
				"to": 341320
			},
			"text": "他如果比如說造這個戰象"
		},
		{
			"timestamps": {
				"from": "00:05:41,320",
				"to": "00:05:43,760"
			},
			"offsets": {
				"from": 341320,
				"to": 343760
			},
			"text": "你就單造長毛病不得了"
		},
		{
			"timestamps": {
				"from": "00:05:43,760",
				"to": "00:05:44,960"
			},
			"offsets": {
				"from": 343760,
				"to": 344960
			},
			"text": "對吧 一會兒站著一打"
		},
		{
			"timestamps": {
				"from": "00:05:44,960",
				"to": "00:05:48,060"
			},
			"offsets": {
				"from": 344960,
				"to": 348060
			},
			"text": "你的長毛病打他戰象都成五倍傷害"
		},
		{
			"timestamps": {
				"from": "00:05:48,060",
				"to": "00:05:49,960"
			},
			"offsets": {
				"from": 348060,
				"to": 349960
			},
			"text": "一下子戰象就給你幹死了"
		},
		{
			"timestamps": {
				"from": "00:05:49,960",
				"to": "00:05:52,960"
			},
			"offsets": {
				"from": 349960,
				"to": 352960
			},
			"text": "就这么简单的一个道理 就是我觉得的"
		},
		{
			"timestamps": {
				"from": "00:05:53,920",
				"to": "00:05:57,840"
			},
			"offsets": {
				"from": 353920,
				"to": 357840
			},
			"text": "不要急着就是赵兵急着赵"
		},
		{
			"timestamps": {
				"from": "00:05:57,840",
				"to": "00:06:04,800"
			},
			"offsets": {
				"from": 357840,
				"to": 364800
			},
			"text": "咱们可以先造几个赤后把这个图 更何况现在探图都是免费的"
		},
		{
			"timestamps": {
				"from": "00:06:04,800",
				"to": "00:06:10,280"
			},
			"offsets": {
				"from": 364800,
				"to": 370280
			},
			"text": "我相信大家就先把图探比 比什么都强"
		},
		{
			"timestamps": {
				"from": "00:06:10,280",
				"to": "00:06:16,360"
			},
			"offsets": {
				"from": 370280,
				"to": 376360
			},
			"text": "就是这个探完图在作决定 玩游戏也是这么玩的"
		},
		{
			"timestamps": {
				"from": "00:06:16,960",
				"to": "00:06:19,060"
			},
			"offsets": {
				"from": 376960,
				"to": 379060
			},
			"text": "了解了解 非常有企伐性"
		},
		{
			"timestamps": {
				"from": "00:06:19,060",
				"to": "00:06:21,900"
			},
			"offsets": {
				"from": 379060,
				"to": 381900
			},
			"text": "就是说 类似于就是用游戏理解的话"
		},
		{
			"timestamps": {
				"from": "00:06:21,900",
				"to": "00:06:23,960"
			},
			"offsets": {
				"from": 381900,
				"to": 383960
			},
			"text": "就是你前期投资一点点钱"
		},
		{
			"timestamps": {
				"from": "00:06:23,960",
				"to": "00:06:26,320"
			},
			"offsets": {
				"from": 383960,
				"to": 386320
			},
			"text": "让这个农民去探图"
		},
		{
			"timestamps": {
				"from": "00:06:26,320",
				"to": "00:06:28,240"
			},
			"offsets": {
				"from": 386320,
				"to": 388240
			},
			"text": "相当于这个钱就是投在AI上面"
		},
		{
			"timestamps": {
				"from": "00:06:28,240",
				"to": "00:06:29,400"
			},
			"offsets": {
				"from": 388240,
				"to": 389400
			},
			"text": "然后有了这个图之后"
		},
		{
			"timestamps": {
				"from": "00:06:29,400",
				"to": "00:06:31,880"
			},
			"offsets": {
				"from": 389400,
				"to": 391880
			},
			"text": "你就能够更好的制定战略"
		},
		{
			"timestamps": {
				"from": "00:06:31,880",
				"to": "00:06:33,540"
			},
			"offsets": {
				"from": 391880,
				"to": 393540
			},
			"text": "对 而且还不光是农民了"
		},
		{
			"timestamps": {
				"from": "00:06:33,540",
				"to": "00:06:35,000"
			},
			"offsets": {
				"from": 393540,
				"to": 395000
			},
			"text": "你可以先用赤后去探图"
		},
		{
			"timestamps": {
				"from": "00:06:35,000",
				"to": "00:06:38,000"
			},
			"offsets": {
				"from": 395000,
				"to": 398000
			},
			"text": "它有一些 马的那个兵移动速特别快"
		},
		{
			"timestamps": {
				"from": "00:06:38,000",
				"to": "00:06:38,960"
			},
			"offsets": {
				"from": 398000,
				"to": 398960
			},
			"text": "攻进力很弱"
		},
		{
			"timestamps": {
				"from": "00:06:38,960",
				"to": "00:06:40,960"
			},
			"offsets": {
				"from": 398960,
				"to": 400960
			},
			"text": "但是就是可以探图用的"
		},
		{
			"timestamps": {
				"from": "00:06:40,960",
				"to": "00:06:43,840"
			},
			"offsets": {
				"from": 400960,
				"to": 403840
			},
			"text": "你就先用它把整个地图探一边"
		},
		{
			"timestamps": {
				"from": "00:06:43,840",
				"to": "00:06:46,840"
			},
			"offsets": {
				"from": 403840,
				"to": 406840
			},
			"text": "然后把资源该标注的全标注了"
		},
		{
			"timestamps": {
				"from": "00:06:46,840",
				"to": "00:06:47,840"
			},
			"offsets": {
				"from": 406840,
				"to": 407840
			},
			"text": "这个很关键"
		},
		{
			"timestamps": {
				"from": "00:06:47,840",
				"to": "00:06:49,040"
			},
			"offsets": {
				"from": 407840,
				"to": 409040
			},
			"text": "就是在做决定"
		},
		{
			"timestamps": {
				"from": "00:06:49,040",
				"to": "00:06:50,320"
			},
			"offsets": {
				"from": 409040,
				"to": 410320
			},
			"text": "在做决定不迟"
		},
		{
			"timestamps": {
				"from": "00:06:50,320",
				"to": "00:06:52,240"
			},
			"offsets": {
				"from": 410320,
				"to": 412240
			},
			"text": "我见过有的人"
		},
		{
