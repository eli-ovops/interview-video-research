				"to": "00:03:19,120"
			},
			"offsets": {
				"from": 198120,
				"to": 199120
			},
			"text": "我们要拥抱它"
		},
		{
			"timestamps": {
				"from": "00:03:19,120",
				"to": "00:03:19,620"
			},
			"offsets": {
				"from": 199120,
				"to": 199620
			},
			"text": "对"
		},
		{
			"timestamps": {
				"from": "00:03:19,620",
				"to": "00:03:22,760"
			},
			"offsets": {
				"from": 199620,
				"to": 202760
			},
			"text": "而不能说我们把这个技术挡在外面"
		},
		{
			"timestamps": {
				"from": "00:03:22,760",
				"to": "00:03:23,280"
			},
			"offsets": {
				"from": 202760,
				"to": 203280
			},
			"text": "对吧"
		},
		{
			"timestamps": {
				"from": "00:03:23,280",
				"to": "00:03:24,360"
			},
			"offsets": {
				"from": 203280,
				"to": 204360
			},
			"text": "这个AI既然来了"
		},
		{
			"timestamps": {
				"from": "00:03:24,360",
				"to": "00:03:25,320"
			},
			"offsets": {
				"from": 204360,
				"to": 205320
			},
			"text": "我们拥抱它"
		},
		{
			"timestamps": {
				"from": "00:03:25,320",
				"to": "00:03:26,160"
			},
			"offsets": {
				"from": 205320,
				"to": 206160
			},
			"text": "拥抱它"
		},
		{
			"timestamps": {
				"from": "00:03:26,160",
				"to": "00:03:27,120"
			},
			"offsets": {
				"from": 206160,
				"to": 207120
			},
			"text": "适应了"
		},
		{
			"timestamps": {
				"from": "00:03:27,120",
				"to": "00:03:27,720"
			},
			"offsets": {
				"from": 207120,
				"to": 207720
			},
			"text": "对吧"
		},
		{
			"timestamps": {
				"from": "00:03:27,720",
				"to": "00:03:29,960"
			},
			"offsets": {
				"from": 207720,
				"to": 209960
			},
			"text": "而不要说是我要把AI控制住"
		},
		{
			"timestamps": {
				"from": "00:03:29,960",
				"to": "00:03:30,960"
			},
			"offsets": {
				"from": 209960,
				"to": 210960
			},
			"text": "不让AI发展"
		},
		{
			"timestamps": {
				"from": "00:03:30,960",
				"to": "00:03:32,040"
			},
			"offsets": {
				"from": 210960,
				"to": 212040
			},
			"text": "这个肯定是错误的"
		},
		{
			"timestamps": {
				"from": "00:03:32,040",
				"to": "00:03:35,200"
			},
			"offsets": {
				"from": 212040,
				"to": 215200
			},
			"text": "因为我们要把这个要适应"
		},
		{
			"timestamps": {
				"from": "00:03:35,200",
				"to": "00:03:36,320"
			},
			"offsets": {
				"from": 215200,
				"to": 216320
			},
			"text": "这个要适应"
		},
		{
			"timestamps": {
				"from": "00:03:36,320",
				"to": "00:03:39,080"
			},
			"offsets": {
				"from": 216320,
				"to": 219080
			},
			"text": "当然这个从我们年轻人角度来讲"
		},
		{
			"timestamps": {
				"from": "00:03:39,080",
				"to": "00:03:39,660"
			},
			"offsets": {
				"from": 219080,
				"to": 219660
			},
			"text": "比较容易啊"
		},
		{
			"timestamps": {
				"from": "00:03:39,660",
				"to": "00:03:41,160"
			},
			"offsets": {
				"from": 219660,
				"to": 221160
			},
			"text": "因为我们年轻嘛"
		},
		{
			"timestamps": {
				"from": "00:03:41,160",
				"to": "00:03:44,160"
			},
			"offsets": {
				"from": 221160,
				"to": 224160
			},
			"text": "二到四岁你吸收新鲜这个新鲜"
		},
		{
			"timestamps": {
				"from": "00:03:46,160",
				"to": "00:03:49,160"
			},
			"offsets": {
				"from": 226160,
				"to": 229160
			},
			"text": "你要六七十了你不愿意改变"
		},
		{
			"timestamps": {
				"from": "00:03:49,160",
				"to": "00:03:51,160"
			},
			"offsets": {
				"from": 229160,
				"to": 231160
			},
			"text": "因为你这屁股决定哪个南法"
		},
		{
			"timestamps": {
				"from": "00:03:53,160",
				"to": "00:03:57,160"
			},
			"offsets": {
				"from": 233160,
				"to": 237160
			},
			"text": "但是我们年纪人我觉得大家如果是二到四岁去厌的"
		},
		{
			"timestamps": {
				"from": "00:03:57,160",
				"to": "00:03:58,160"
			},
			"offsets": {
				"from": 237160,
				"to": 238160
			},
			"text": "那更是"
		},
		{
			"timestamps": {
				"from": "00:03:59,160",
				"to": "00:04:02,160"
			},
			"offsets": {
				"from": 239160,
				"to": 242160
			},
			"text": "我要先吸收先改变"
		},
		{
			"timestamps": {
				"from": "00:04:04,160",
				"to": "00:04:06,160"
			},
			"offsets": {
				"from": 244160,
				"to": 246160
			},
			"text": "我觉得就是这么一个理念"
		},
		{
			"timestamps": {
				"from": "00:04:06,160",
				"to": "00:04:10,160"
			},
			"offsets": {
				"from": 246160,
				"to": 250160
			},
			"text": "因为这个东西它不需要你去接不接收"
		},
		{
			"timestamps": {
				"from": "00:04:10,160",
				"to": "00:04:11,160"
			},
			"offsets": {
				"from": 250160,
				"to": 251160
			},
			"text": "一定会发生"
		},
		{
			"timestamps": {
				"from": "00:04:11,160",
				"to": "00:04:13,640"
			},
			"offsets": {
				"from": 251160,
				"to": 253640
			},
			"text": "所以如果你不参与的话你就会下车了"
		},
		{
			"timestamps": {
				"from": "00:04:13,640",
				"to": "00:04:14,720"
			},
			"offsets": {
				"from": 253640,
				"to": 254720
			},
			"text": "所以这不是一个个"
		},
		{
			"timestamps": {
				"from": "00:04:14,720",
				"to": "00:04:16,840"
			},
			"offsets": {
				"from": 254720,
				"to": 256840
			},
			"text": "所以你不接受"
		},
		{
			"timestamps": {
				"from": "00:04:16,840",
				"to": "00:04:20,560"
			},
			"offsets": {
				"from": 256840,
				"to": 260560
			},
			"text": "历史还是会进程会推进不管你上不上车"
		},
		{
			"timestamps": {
				"from": "00:04:20,560",
				"to": "00:04:23,560"
			},
			"offsets": {
				"from": 260560,
				"to": 263560
			},
			"text": "所以那你作为个人最大利益的话你就应该上车"
		},
		{
			"timestamps": {
				"from": "00:04:23,560",
				"to": "00:04:24,920"
			},
			"offsets": {
				"from": 263560,
				"to": 264920
			},
			"text": "对 就是这种点"
		},
		{
			"timestamps": {
				"from": "00:04:24,920",
				"to": "00:04:27,440"
			},
			"offsets": {
				"from": 264920,
				"to": 267440
			},
			"text": "对吧 跟其练伯吉也是一个死亡"
		}
	]
}
