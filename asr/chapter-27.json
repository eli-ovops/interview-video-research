				"from": "00:04:09,640",
				"to": "00:04:13,660"
			},
			"offsets": {
				"from": 249640,
				"to": 253660
			},
			"text": "容易骨折 得病也恢復不了 所有東西都來了"
		},
		{
			"timestamps": {
				"from": "00:04:13,660",
				"to": "00:04:17,180"
			},
			"offsets": {
				"from": 253660,
				"to": 257180
			},
			"text": "所以就是 我覺得就是這個財富自由"
		},
		{
			"timestamps": {
				"from": "00:04:17,180",
				"to": "00:04:19,140"
			},
			"offsets": {
				"from": 257180,
				"to": 259140
			},
			"text": "和這個東西也都是一整套"
		},
		{
			"timestamps": {
				"from": "00:04:19,140",
				"to": "00:04:23,380"
			},
			"offsets": {
				"from": 259140,
				"to": 263380
			},
			"text": "比如說 你進入這個復循環也是循環加強了"
		},
		{
			"timestamps": {
				"from": "00:04:23,380",
				"to": "00:04:25,180"
			},
			"offsets": {
				"from": 263380,
				"to": 265180
			},
			"text": "对对对你不自由"
		},
		{
			"timestamps": {
				"from": "00:04:25,940",
				"to": "00:04:28,500"
			},
			"offsets": {
				"from": 265940,
				"to": 268500
			},
			"text": "就要稍前就比如说我刚才举个例子你"
		},
		{
			"timestamps": {
				"from": "00:04:28,760",
				"to": "00:04:29,780"
			},
			"offsets": {
				"from": 268760,
				"to": 269780
			},
			"text": "你买了个房子"
		},
		{
			"timestamps": {
				"from": "00:04:30,040",
				"to": "00:04:32,580"
			},
			"offsets": {
				"from": 270040,
				"to": 272580
			},
			"text": "这个房子的维护要花你时间"
		},
		{
			"timestamps": {
				"from": "00:04:32,840",
				"to": "00:04:33,620"
			},
			"offsets": {
				"from": 272840,
				"to": 273620
			},
			"text": "花你的钱"
		},
		{
			"timestamps": {
				"from": "00:04:33,880",
				"to": "00:04:37,460"
			},
			"offsets": {
				"from": 273880,
				"to": 277460
			},
			"text": "然后呢他买了个房子导致你更多的机会你失去"
		},
		{
			"timestamps": {
				"from": "00:04:37,980",
				"to": "00:04:40,020"
			},
			"offsets": {
				"from": 277980,
				"to": 280020
			},
			"text": "然后更多的机会你失去"
		},
		{
			"timestamps": {
				"from": "00:04:40,280",
				"to": "00:04:41,820"
			},
			"offsets": {
				"from": 280280,
				"to": 281820
			},
			"text": "跟少的小质你钱更少"
		},
		{
			"timestamps": {
				"from": "00:04:42,580",
				"to": "00:04:43,100"
			},
			"offsets": {
				"from": 282580,
				"to": 283100
			},
			"text": "对啊"
		},
		{
			"timestamps": {
				"from": "00:04:43,340",
				"to": "00:04:45,660"
			},
			"offsets": {
				"from": 283340,
				"to": 285660
			},
			"text": "创台跟差也就无限循环"
		},
		{
			"timestamps": {
				"from": "00:04:46,420",
				"to": "00:04:48,980"
			},
			"offsets": {
				"from": 286420,
				"to": 288980
			},
			"text": "啊我选循环下架"
		},
		{
			"timestamps": {
				"from": "00:04:49,240",
				"to": "00:04:51,480"
			},
			"offsets": {
				"from": 289240,
				"to": 291480
			},
			"text": "我觉得人生真的他没有保持的"
		},
		{
			"timestamps": {
				"from": "00:04:51,480",
				"to": "00:04:53,000"
			},
			"offsets": {
				"from": 291480,
				"to": 293000
			},
			"text": "他就是要么往上 要么是要往下"
		},
		{
			"timestamps": {
				"from": "00:04:53,000",
				"to": "00:04:54,240"
			},
			"offsets": {
				"from": 293000,
				"to": 294240
			},
			"text": "没有保持"
		},
		{
			"timestamps": {
				"from": "00:04:54,240",
				"to": "00:04:56,240"
			},
			"offsets": {
				"from": 294240,
				"to": 296240
			},
			"text": "你说太对了"
		},
		{
			"timestamps": {
				"from": "00:04:56,240",
				"to": "00:05:00,440"
			},
			"offsets": {
				"from": 296240,
				"to": 300440
			},
			"text": "这个就是AI我们里面也也是一个"
		},
		{
			"timestamps": {
				"from": "00:05:00,440",
				"to": "00:05:02,440"
			},
			"offsets": {
				"from": 300440,
				"to": 302440
			},
			"text": "AI们一个挺出名的一个模型"
		},
		{
			"timestamps": {
				"from": "00:05:02,440",
				"to": "00:05:03,440"
			},
			"offsets": {
				"from": 302440,
				"to": 303440
			},
			"text": "是什么呢"
		},
		{
			"timestamps": {
				"from": "00:05:03,440",
				"to": "00:05:07,440"
			},
			"offsets": {
				"from": 303440,
				"to": 307440
			},
			"text": "它就是AI的线"
		},
		{
			"timestamps": {
				"from": "00:05:07,440",
				"to": "00:05:13,440"
			},
			"offsets": {
				"from": 307440,
				"to": 313440
			},
			"text": "就是最早的模型以及信息输入的差距"
		},
		{
			"timestamps": {
				"from": "00:05:13,440",
				"to": "00:05:16,440"
			},
			"offsets": {
				"from": 313440,
				"to": 316440
			},
			"text": "对于后面的AI"
		},
		{
			"timestamps": {
				"from": "00:05:16,440",
				"to": "00:05:18,640"
			},
			"offsets": {
				"from": 316440,
				"to": 318640
			},
			"text": "由于RSI的原因"
		},
		{
			"timestamps": {
				"from": "00:05:18,640",
				"to": "00:05:21,960"
			},
			"offsets": {
				"from": 318640,
				"to": 321960
			},
			"text": "就是 RSI就是自我地規更新的"
		},
		{
			"timestamps": {
				"from": "00:05:22,720",
				"to": "00:05:27,860"
			},
			"offsets": {
				"from": 322720,
				"to": 327860
			},
			"text": "后面导致你们俩就是出现罗选上升和罗选下降的这个情况"
		},
		{
			"timestamps": {
				"from": "00:05:28,360",
				"to": "00:05:31,940"
			},
			"offsets": {
				"from": 328360,
				"to": 331940
			},
			"text": "就是你是要去越聪明的AI越能 RSI"
		},
		{
			"timestamps": {
				"from": "00:05:32,200",
				"to": "00:05:33,740"
			},
			"offsets": {
				"from": 332200,
				"to": 333740
			},
			"text": "RSI就越聪明"
		},
		{
			"timestamps": {
				"from": "00:05:34,000",
				"to": "00:05:39,880"
			},
			"offsets": {
				"from": 334000,
				"to": 339880
			},
			"text": "越聪明就越更新越聪明越聪明越越多越越越聪明"
		},
		{
			"timestamps": {
				"from": "00:05:40,140",
				"to": "00:05:43,220"
			},
			"offsets": {
				"from": 340140,
				"to": 343220
			},
			"text": "让你的笨蛋啊就 RSI的方向也错了"
		},
		{
			"timestamps": {
				"from": "00:05:43,480",
				"to": "00:05:46,040"
			},
			"offsets": {
				"from": 343480,
				"to": 346040
			},
			"text": "愈错愈离谱 愈爱错愈离谱"
		},
		{
			"timestamps": {
				"from": "00:05:46,300",
				"to": "00:05:48,340"
			},
			"offsets": {
				"from": 346300,
				"to": 348340
			},
			"text": "你们俩之后就这个差距愈来愿了"
		},
		{
			"timestamps": {
				"from": "00:05:48,600",
				"to": "00:05:51,420"
			},
			"offsets": {
				"from": 348600,
				"to": 351420
			},
			"text": "所以呢就是一开始的一点点"
		},
		{
			"timestamps": {
				"from": "00:05:51,680",
				"to": "00:05:53,200"
			},
			"offsets": {
				"from": 351680,
				"to": 353200
			},
			"text": "很重要不一样"
		},
		{
			"timestamps": {
				"from": "00:05:53,720",
				"to": "00:05:55,000"
			},
			"offsets": {
				"from": 353720,
				"to": 355000
			},
			"text": "都会导致后面有"
		},
		{
			"timestamps": {
				"from": "00:05:55,260",
				"to": "00:05:56,280"
			},
			"offsets": {
				"from": 355260,
				"to": 356280
			},
			"text": "很大结果的变化"
		},
		{
			"timestamps": {
				"from": "00:05:56,540",
				"to": "00:05:59,340"
			},
			"offsets": {
				"from": 356540,
				"to": 359340
			},
			"text": "所以从这个角度来说 我觉得就是"
		},
		{
			"timestamps": {
				"from": "00:05:59,600",
				"to": "00:06:02,420"
			},
			"offsets": {
				"from": 359600,
				"to": 362420
			},
			"text": "这个年轻人的这个认知这个提升"
		},
		{
			"timestamps": {
				"from": "00:06:02,680",
				"to": "00:06:04,480"
			},
			"offsets": {
				"from": 362680,
				"to": 364480
			},
			"text": "其实是非常非常关键"
		},
		{
			"timestamps": {
				"from": "00:06:04,740",
				"to": "00:06:07,800"
			},
			"offsets": {
				"from": 364740,
				"to": 367800
			},
			"text": "那他要比这个 我觉得要比大家"
		},
		{
			"timestamps": {
				"from": "00:06:08,060",
				"to": "00:06:10,360"
			},
			"offsets": {
				"from": 368060,
				"to": 370360
			},
			"text": "日常生活中看到一些显化的东西"
		},
		{
			"timestamps": {
				"from": "00:06:10,620",
				"to": "00:06:12,660"
			},
			"offsets": {
				"from": 370620,
				"to": 372660
			},
			"text": "比如说前具体有多少啊"
		},
		{
			"timestamps": {
				"from": "00:06:12,920",
				"to": "00:06:17,920"
			},
			"offsets": {
				"from": 372920,
				"to": 377920
			},
			"text": "這個權力啊這個什麼智商啊"
