				"to": "00:06:20,520"
			},
			"offsets": {
				"from": 377920,
				"to": 380520
			},
			"text": "一些我們大家看到很外在的東西"
		},
		{
			"timestamps": {
				"from": "00:06:20,520",
				"to": "00:06:23,120"
			},
			"offsets": {
				"from": 380520,
				"to": 383120
			},
			"text": "是不是有車有房啊"
		},
		{
			"timestamps": {
				"from": "00:06:23,120",
				"to": "00:06:24,120"
			},
			"offsets": {
				"from": 383120,
				"to": 384120
			},
			"text": "接外在的東西"
		},
		{
			"timestamps": {
				"from": "00:06:24,120",
				"to": "00:06:27,120"
			},
			"offsets": {
				"from": 384120,
				"to": 387120
			},
			"text": "其實都要更要深刻的多"
		},
		{
			"timestamps": {
				"from": "00:06:27,120",
				"to": "00:06:28,320"
			},
			"offsets": {
				"from": 387120,
				"to": 388320
			},
			"text": "要深刻的多"
		},
		{
			"timestamps": {
				"from": "00:06:28,320",
				"to": "00:06:30,320"
			},
			"offsets": {
				"from": 388320,
				"to": 390320
			},
			"text": "其實你要是的理解這些東西"
		},
		{
			"timestamps": {
				"from": "00:06:30,320",
				"to": "00:06:35,320"
			},
			"offsets": {
				"from": 390320,
				"to": 395320
			},
			"text": "才能我覺得是理解最最根本的財富的"
		},
		{
			"timestamps": {
				"from": "00:06:35,320",
				"to": "00:06:38,320"
			},
			"offsets": {
				"from": 395320,
				"to": 398320
			},
			"text": "來源核心這些東西"
		},
		{
			"timestamps": {
				"from": "00:06:38,320",
				"to": "00:06:47,120"
			},
			"offsets": {
				"from": 398320,
				"to": 407120
			},
			"text": "对,可以理解为薄级是财富最后的第一步,然后不练薄级就是失去财富最后的第一步,然后认知提升非常多。"
		}
	]
}
