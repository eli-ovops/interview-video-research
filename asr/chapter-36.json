				"to": "00:00:12,080"
			},
			"offsets": {
				"from": 8480,
				"to": 12080
			},
			"text": "那比如说一个人他不是商业版图的"
		},
		{
			"timestamps": {
				"from": "00:00:12,080",
				"to": "00:00:17,560"
			},
			"offsets": {
				"from": 12080,
				"to": 17560
			},
			"text": "他比如说就是挣钱 存了笔钱 投资 实际上财富自由"
