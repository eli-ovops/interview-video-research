		{
			"timestamps": {
				"from": "00:03:01,780",
				"to": "00:03:06,640"
			},
			"offsets": {
				"from": 181780,
				"to": 186640
			},
			"text": "我前两天不设立孙省奖 我也提到这个诺贝尔的人生"
