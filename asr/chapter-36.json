				"to": "00:00:38,860"
			},
			"offsets": {
				"from": 36560,
				"to": 38860
			},
			"text": "或者說給自己設一個標準區 練博物機"
		},
		{
			"timestamps": {
				"from": "00:00:39,120",
				"to": "00:00:40,140"
			},
			"offsets": {
				"from": 39120,
				"to": 40140
			},
			"text": "就是它是一個"
		},
		{
			"timestamps": {
				"from": "00:00:40,660",
				"to": "00:00:43,220"
			},
			"offsets": {
				"from": 40660,
				"to": 43220
			},
			"text": "這是隨便你怎麼玩"
		},
		{
			"timestamps": {
				"from": "00:00:43,720",
				"to": "00:00:44,500"
			},
			"offsets": {
				"from": 43720,
				"to": 44500
			},
			"text": "沒有正確答案"
