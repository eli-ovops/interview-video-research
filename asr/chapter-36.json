		{
			"timestamps": {
				"from": "00:01:04,720",
				"to": "00:01:09,840"
			},
			"offsets": {
				"from": 64720,
				"to": 69840
			},
			"text": "没有说前面发誓我要成为世界上最伟大的物理学家"
		},
		{
			"timestamps": {
				"from": "00:01:10,360",
				"to": "00:01:17,020"
			},
			"offsets": {
				"from": 70360,
				"to": 77020
			},
			"text": "安隐斯坦你知道他以前是一个瑞士的一个专利注册员"
		},
		{
			"timestamps": {
				"from": "00:01:18,300",
				"to": "00:01:20,340"
			},
			"offsets": {
				"from": 78300,
				"to": 80340
			},
			"text": "职业是给人注册专利的"
		},
		{
			"timestamps": {
				"from": "00:01:21,360",
				"to": "00:01:27,000"
			},
			"offsets": {
				"from": 81360,
				"to": 87000
			},
			"text": "當然你說這個註冊專利員跟這個物理有沒有一點相同可能也是有一點相同"
