				"to": "00:00:53,200"
			},
			"offsets": {
				"from": 49620,
				"to": 53200
			},
			"text": "其實所有成為正確答案的人"
		},
		{
			"timestamps": {
				"from": "00:00:54,740",
				"to": "00:00:58,320"
			},
			"offsets": {
				"from": 54740,
				"to": 58320
			},
			"text": "他在他成为正确的案子前他不知道这是正确的"
