				"to": 194540
			},
			"text": "这个这个这个这个这个 所以呢 就是说"
		},
		{
			"timestamps": {
				"from": "00:03:14,540",
				"to": "00:03:18,820"
			},
			"offsets": {
				"from": 194540,
				"to": 198820
			},
			"text": "我其实还是回到刚才那个体验说"
		},
		{
			"timestamps": {
				"from": "00:03:19,900",
				"to": "00:03:22,420"
			},
			"offsets": {
				"from": 199900,
				"to": 202420
			},
			"text": "其实我觉得所有的刚才讲才不是最后也好"
		},
		{
			"timestamps": {
				"from": "00:03:22,420",
				"to": "00:03:24,420"
			},
			"offsets": {
				"from": 202420,
				"to": 204420
			},
			"text": "这个思组也好 都是个密子"
		},
		{
			"timestamps": {
				"from": "00:03:24,420",
				"to": "00:03:28,540"
			},
			"offsets": {
				"from": 204420,
				"to": 208540
			},
			"text": "其实都是一个神话 都是要被打破的"
		},
		{
			"timestamps": {
				"from": "00:03:29,380",
				"to": "00:03:33,300"
			},
			"offsets": {
				"from": 209380,
				"to": 213300
			},
			"text": "或者一种迷思的 中文翻译一下 迷思 是什么呢"
		},
		{
			"timestamps": {
				"from": "00:03:33,300",
				"to": "00:03:37,340"
			},
			"offsets": {
				"from": 213300,
				"to": 217340
			},
			"text": "就是说你以为你缺这个东西 你以为你想要的东西"
		},
		{
			"timestamps": {
				"from": "00:03:37,340",
				"to": "00:03:42,700"
			},
			"offsets": {
				"from": 217340,
				"to": 222700
			},
			"text": "但是等你到达那个笔案 等到达那个 你也发觉我又缺回来了"
		},
		{
			"timestamps": {
				"from": "00:03:44,220",
				"to": "00:03:48,560"
			},
			"offsets": {
				"from": 224220,
				"to": 228560
			},
			"text": "其他是一個循環"
		},
		{
			"timestamps": {
				"from": "00:03:49,840",
				"to": "00:03:52,160"
			},
			"offsets": {
				"from": 229840,
				"to": 232160
			},
			"text": "就是這個"
		},
		{
			"timestamps": {
				"from": "00:03:52,660",
				"to": "00:03:55,740"
			},
			"offsets": {
				"from": 232660,
				"to": 235740
			},
			"text": "我創業之後我最缺的其實是上班"
		},
		{
			"timestamps": {
				"from": "00:03:56,520",
				"to": "00:04:01,120"
			},
			"offsets": {
				"from": 236520,
				"to": 241120
			},
			"text": "因為我覺得上班一區去好的公司上班能給我提供很多"
		},
		{
			"timestamps": {
				"from": "00:04:02,920",
				"to": "00:04:03,680"
			},
			"offsets": {
				"from": 242920,
				"to": 243680
			},
			"text": "Banchmark"
		},
		{
			"timestamps": {
				"from": "00:04:04,180",
				"to": "00:04:08,280"
			},
			"offsets": {
				"from": 244180,
				"to": 248280
			},
			"text": "能給我提供很多這樣開船的時候我就知道怎麼開大概一個情況"
		},
		{
			"timestamps": {
				"from": "00:04:09,300",
				"to": "00:04:14,180"
			},
			"offsets": {
				"from": 249300,
				"to": 254180
			},
			"text": "這個東西可能這個肌肉記憶只有我在那公司上班我才能體驗出"
		},
		{
			"timestamps": {
				"from": "00:04:14,220",
				"to": "00:04:44,140"
			},
			"offsets": {
				"from": 254220,
				"to": 284140
			},
			"text": "但是如果我没上班的时候,我光在那个公司上班,我可能觉得好枯燥,好没意思,对吧,被人管着,好不爽,对不对,是不是感觉,就是我觉得就是其实是个互补,但我后来觉得我觉得人生其实是个互补,所以我有时候还喜欢玩游戏,我电脑游戏啊,我专门喜欢玩,现在就是什么什么模拟器我特别想啊,就是体验别人的人生,"
		},
		{
			"timestamps": {
				"from": "00:04:44,220",
				"to": "00:05:14,140"
			},
			"offsets": {
				"from": 284220,
				"to": 314140
			},
			"text": "对,对,这个,你别说真的这个模拟器挺有意思什么呢,就你不真玩啊,你是进入不到那个视角的,你玩一下就进入那个视角了,一下很多东西就想碰了,你要不玩,不玩这个模拟器,算这个模拟器已经比这个人生,我觉得只剩,可能看,看了,把来百分百的体验都已经看了只剩二十了,但是这个二十分的体验对我来说,都,"
		},
		{
			"timestamps": {
				"from": "00:05:14,220",
				"to": "00:05:17,800"
			},
			"offsets": {
				"from": 314220,
				"to": 317800
			},
			"text": "因為他也給我提供了一個全新事件"
		},
		{
			"timestamps": {
				"from": "00:05:19,340",
				"to": "00:05:21,900"
			},
			"offsets": {
				"from": 319340,
				"to": 321900
			},
			"text": "就是這個是我其實覺得挺有意思啊"
		},
		{
			"timestamps": {
				"from": "00:05:23,180",
				"to": "00:05:28,300"
			},
			"offsets": {
				"from": 323180,
				"to": 328300
			},
			"text": "我甚至玩過那種流浪漢模擬氣就是在每個不同程度之間流浪啊"
		},
		{
			"timestamps": {
				"from": "00:05:28,560",
				"to": "00:05:32,660"
			},
			"offsets": {
				"from": 328560,
				"to": 332660
			},
			"text": "然後去白陸一點錢啊免貪活著就是"
		},
		{
			"timestamps": {
				"from": "00:05:32,920",
				"to": "00:05:35,720"
			},
			"offsets": {
				"from": 332920,
				"to": 335720
			},
			"text": "打工流浪漢模擬氣的我的玩過啊"
		},
		{
			"timestamps": {
				"from": "00:05:35,980",
				"to": "00:05:40,580"
			},
			"offsets": {
				"from": 335980,
				"to": 340580
			},
			"text": "我經常玩著模擬氣就是模擬氣給我的感覺就是提供個不同事件"
		},
		{
			"timestamps": {
				"from": "00:05:40,840",
				"to": "00:05:42,680"
			},
			"offsets": {
				"from": 340840,
				"to": 342680
			},
			"text": "我觉得就是这个其实"
		},
		{
			"timestamps": {
				"from": "00:05:42,880",
				"to": "00:05:47,240"
			},
			"offsets": {
				"from": 342880,
				"to": 347240
			},
			"text": "就有点是说你自己不珍惜的东西可能在别人眼中很宝贵呀"
		},
		{
			"timestamps": {
				"from": "00:05:48,520",
				"to": "00:05:51,080"
			},
			"offsets": {
				"from": 348520,
				"to": 351080
			},
			"text": "其实就是一个这个人生的这么一个"
		},
		{
			"timestamps": {
				"from": "00:05:52,360",
				"to": "00:05:53,120"
			},
			"offsets": {
				"from": 352360,
				"to": 353120
			},
			"text": "体验"
		},
		{
			"timestamps": {
				"from": "00:05:54,660",
				"to": "00:05:57,480"
			},
			"offsets": {
				"from": 354660,
				"to": 357480
			},
			"text": "所以您的意思就是说那人生"
		},
		{
			"timestamps": {
				"from": "00:05:57,740",
				"to": "00:06:01,320"
			},
			"offsets": {
				"from": 357740,
				"to": 361320
			},
			"text": "你是偏向这个体验论的那基于体验论的情况下"
		},
		{
			"timestamps": {
				"from": "00:06:01,580",
				"to": "00:06:02,080"
			},
			"offsets": {
				"from": 361580,
				"to": 362080
			},
			"text": "当你"
		},
		{
			"timestamps": {
				"from": "00:06:02,340",
				"to": "00:06:05,420"
			},
			"offsets": {
				"from": 362340,
				"to": 365420
			},
			"text": "达到了财富自由之后他其实可能只是一个"
		},
		{
			"timestamps": {
				"from": "00:06:05,680",
				"to": "00:06:06,700"
			},
			"offsets": {
				"from": 365680,
				"to": 366700
			},
			"text": "只是一个门票"
		},
		{
			"timestamps": {
				"from": "00:06:06,960",
				"to": "00:06:10,020"
			},
			"offsets": {
				"from": 366960,
				"to": 370020
			},
			"text": "让你能玩这个游戏了然后接下来的任务其实说"
		},
		{
			"timestamps": {
				"from": "00:06:10,280",
				"to": "00:06:12,080"
			},
			"offsets": {
				"from": 370280,
				"to": 372080
			},
			"text": "去不同扩大市角和体验"
		},
		{
			"timestamps": {
				"from": "00:06:12,320",
				"to": "00:06:13,080"
			},
			"offsets": {
				"from": 372320,
				"to": 373080
			},
			"text": "然后去"
		},
		{
			"timestamps": {
				"from": "00:06:13,600",
				"to": "00:06:14,640"
			},
			"offsets": {
				"from": 373600,
				"to": 374640
			},
			"text": "说非有这个"
		},
		{
			"timestamps": {
				"from": "00:06:15,400",
				"to": "00:06:16,160"
			},
			"offsets": {
				"from": 375400,
				"to": 376160
			},
			"text": "体验论"
		},
		{
			"timestamps": {
				"from": "00:06:16,680",
				"to": "00:06:17,200"
			},
			"offsets": {
				"from": 376680,
				"to": 377200
			},
			"text": "获得"
		},
		{
			"timestamps": {
				"from": "00:06:17,460",
				"to": "00:06:18,480"
			},
			"offsets": {
				"from": 377460,
				"to": 378480
			},
			"text": "对最大体验"
		},
		{
			"timestamps": {
				"from": "00:06:18,980",
				"to": "00:06:21,540"
			},
			"offsets": {
				"from": 378980,
				"to": 381540
			},
			"text": "对但是而且但不同的人有不同体验模式"
		},
		{
			"timestamps": {
				"from": "00:06:21,800",
				"to": "00:06:23,080"
			},
			"offsets": {
				"from": 381800,
				"to": 383080
			},
			"text": "我一个朋友"
		},
		{
			"timestamps": {
				"from": "00:06:24,100",
				"to": "00:06:25,380"
			},
			"offsets": {
				"from": 384100,
				"to": 385380
			},
			"text": "也是上太空的"
		},
		{
			"timestamps": {
				"from": "00:06:25,900",
				"to": "00:06:28,200"
			},
			"offsets": {
				"from": 385900,
				"to": 388200
			},
			"text": "叫王纯也是其实一个中文"
		},
		{
			"timestamps": {
				"from": "00:06:29,480",
				"to": "00:06:33,060"
			},
			"offsets": {
				"from": 389480,
				"to": 393060
			},
			"text": "他就是体验他就是要全是他也跟我做备不走的"
		},
		{
			"timestamps": {
				"from": "00:06:33,320",
				"to": "00:06:35,360"
			},
			"offsets": {
				"from": 393320,
				"to": 395360
			},
			"text": "但他不像我就是做商业"
		},
		{
			"timestamps": {
				"from": "00:06:35,880",
				"to": "00:06:38,440"
			},
			"offsets": {
				"from": 395880,
				"to": 398440
			},
			"text": "他想反很低调他就是"
		},
		{
			"timestamps": {
				"from": "00:06:39,460",
				"to": "00:06:42,280"
			},
			"offsets": {
				"from": 399460,
				"to": 402280
			},
			"text": "出钱让别人把他名字删掉这种看见"
		},
		{
			"timestamps": {
				"from": "00:06:43,560",
				"to": "00:06:46,380"
			},
			"offsets": {
				"from": 403560,
				"to": 406380
			},
			"text": "他就不走这个路线 但他也跟我一样"
		},
		{
			"timestamps": {
				"from": "00:06:46,640",
				"to": "00:06:47,400"
			},
			"offsets": {
				"from": 406640,
				"to": 407400
			},
			"text": "碰巧我们俩"
		},
		{
			"timestamps": {
				"from": "00:06:47,660",
				"to": "00:06:51,240"
			},
			"offsets": {
				"from": 407660,
				"to": 411240
			},
			"text": "太空探索的这个路我们俩通了 只有我们俩还挺熟的"
		},
		{
			"timestamps": {
				"from": "00:06:51,500",
				"to": "00:06:52,780"
			},
			"offsets": {
				"from": 411500,
				"to": 412780
			},
			"text": "因为我们俩都探索太空"
		},
		{
			"timestamps": {
				"from": "00:06:53,800",
				"to": "00:06:55,080"
			},
			"offsets": {
				"from": 413800,
				"to": 415080
			},
			"text": "还碰巧都是华人"
		},
		{
			"timestamps": {
				"from": "00:06:55,340",
				"to": "00:06:56,100"
			},
			"offsets": {
				"from": 415340,
				"to": 416100
			},
			"text": "探索太空"
		},
		{
			"timestamps": {
				"from": "00:06:56,620",
				"to": "00:06:58,660"
			},
			"offsets": {
				"from": 416620,
				"to": 418660
			},
			"text": "然后他的体验他就要走"
		},
		{
			"timestamps": {
				"from": "00:06:58,920",
				"to": "00:06:59,940"
			},
			"offsets": {
				"from": 418920,
				"to": 419940
			},
			"text": "周游全世界"
		},
		{
			"timestamps": {
				"from": "00:07:00,460",
				"to": "00:07:02,500"
			},
			"offsets": {
				"from": 420460,
				"to": 422500
			},
			"text": "他这个周游全世界是字面以上周游全世界"
		},
		{
			"timestamps": {
				"from": "00:07:02,760",
				"to": "00:07:05,060"
			},
			"offsets": {
				"from": 422760,
				"to": 425060
			},
			"text": "他就是全世界的每个国家他都要去"
		},
		{
			"timestamps": {
				"from": "00:07:07,360",
				"to": "00:07:10,560"
			},
			"offsets": {
				"from": 427360,
				"to": 430560
			},
			"text": "就是说这一套火车他都要做 他没有证据答案"
		},
		{
			"timestamps": {
				"from": "00:07:10,560",
				"to": "00:07:13,500"
			},
			"offsets": {
				"from": 430560,
				"to": 433500
			},
			"text": "就是他给自己设施的这个体验 好适量"
		},
		{
			"timestamps": {
				"from": "00:07:13,760",
				"to": "00:07:15,560"
			},
			"offsets": {
				"from": 433760,
				"to": 435560
			},
			"text": "对对对对"
		},
		{
			"timestamps": {
				"from": "00:07:16,060",
				"to": "00:07:18,560"
			},
			"offsets": {
				"from": 436060,
				"to": 438560
			},
			"text": "我相信他的这个体验视角也会很有意思"
		},
		{
			"timestamps": {
				"from": "00:07:18,560",
				"to": "00:07:20,160"
			},
			"offsets": {
				"from": 438560,
				"to": 440160
			},
			"text": "他去过 太多地方我没去过了"
		},
		{
			"timestamps": {
				"from": "00:07:20,660",
				"to": "00:07:25,020"
			},
			"offsets": {
				"from": 440660,
				"to": 445020
			},
			"text": "他去过诺威 他去过南级 他做那种"
		},
		{
			"timestamps": {
				"from": "00:07:25,280",
				"to": "00:07:31,160"
			},
			"offsets": {
				"from": 445280,
				"to": 451160
			},
			"text": "南级那种图部瓦塞 就是你讲就是完全是可能我没有体验过这个视点"
		},
		{
			"timestamps": {
				"from": "00:07:32,460",
				"to": "00:07:32,960"
			},
			"offsets": {
				"from": 452460,
				"to": 452960
			},
			"text": "就是"
		},
		{
			"timestamps": {
				"from": "00:07:33,220",
				"to": "00:07:33,980"
			},
			"offsets": {
				"from": 453220,
				"to": 453980
			},
			"text": "就是"
		},
		{
			"timestamps": {
				"from": "00:07:34,240",
				"to": "00:07:36,800"
			},
			"offsets": {
				"from": 454240,
				"to": 456800
			},
			"text": "但他就去做他这个视角的事"
		},
		{
			"timestamps": {
				"from": "00:07:37,320",
				"to": "00:07:47,560"
			},
			"offsets": {
				"from": 457320,
