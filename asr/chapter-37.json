		{
			"timestamps": {
				"from": "00:00:58,600",
				"to": "00:01:01,840"
			},
			"offsets": {
				"from": 58600,
				"to": 61840
			},
			"text": "你看每个人在这人生就有点不装"
		},
		{
			"timestamps": {
				"from": "00:01:01,840",
				"to": "00:01:04,800"
			},
			"offsets": {
				"from": 61840,
				"to": 64800
			},
			"text": "就是他后来成名的这个东西"
		},
