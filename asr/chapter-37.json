			"timestamps": {
				"from": "00:02:10,540",
				"to": "00:02:13,580"
			},
			"offsets": {
				"from": 130540,
				"to": 133580
			},
			"text": "要礼遇一下就成了中国最有名的词"
		},
		{
			"timestamps": {
				"from": "00:02:13,580",
				"to": "00:02:43,580"
			},
			"offsets": {
				"from": 133580,
				"to": 163580
			},
			"text": "這個詞大家說當華麗媒得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得得"
		},
		{
			"timestamps": {
				"from": "00:02:43,580",
				"to": "00:02:48,580"
			},
			"offsets": {
