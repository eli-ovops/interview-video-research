				"to": "00:01:16,840"
			},
			"offsets": {
				"from": 73600,
				"to": 76840
			},
			"text": "李玉南堂的一个皇帝"
		},
		{
			"timestamps": {
				"from": "00:01:16,840",
				"to": "00:01:20,800"
			},
			"offsets": {
				"from": 76840,
				"to": 80800
			},
			"text": "然后这个李玉"
		},
