			"offsets": {
				"from": 192480,
				"to": 194800
			},
			"text": "那你不就体现出你的价值对不对"
		},
		{
			"timestamps": {
				"from": "00:03:14,800",
				"to": "00:03:16,620"
			},
			"offsets": {
				"from": 194800,
				"to": 196620
			},
			"text": "这是一个最简单的一个"
		},
		{
			"timestamps": {
				"from": "00:03:16,620",
				"to": "00:03:22,500"
			},
			"offsets": {
				"from": 196620,
				"to": 202500
			},
			"text": "當然我覺得我的思路覺得比較有先進性的就是第一度兩橫要變"
		},
		{
			"timestamps": {
				"from": "00:03:22,500",
				"to": "00:03:29,660"
			},
			"offsets": {
				"from": 202500,
				"to": 209660
			},
			"text": "你千萬不能是只考慮本國或者只是只考慮我們本地區"
		},
		{
			"timestamps": {
				"from": "00:03:29,660",
				"to": "00:03:33,780"
			},
			"offsets": {
				"from": 209660,
				"to": 213780
			},
			"text": "甚至我們本事的一個情況你得全球看統一全球看"
		},
		{
			"timestamps": {
				"from": "00:03:33,780",
				"to": "00:03:40,300"
			},
			"offsets": {
				"from": 213780,
				"to": 220300
			},
			"text": "然後與此同時全球範圍內你覺得能不能提升出我的價值"
		},
		{
			"timestamps": {
				"from": "00:03:40,300",
				"to": "00:03:44,780"
			},
			"offsets": {
				"from": 220300,
				"to": 224780
			},
			"text": "能不能把我的價值體現在我的客戶面前"
		},
		{
			"timestamps": {
				"from": "00:03:44,780",
				"to": "00:03:46,640"
			},
			"offsets": {
				"from": 224780,
				"to": 226640
			},
			"text": "我無論做什麼"
		},
		{
			"timestamps": {
				"from": "00:03:46,640",
				"to": "00:03:50,180"
			},
			"offsets": {
				"from": 226640,
				"to": 230180
			},
			"text": "你說能不能把我的價值體現在我的客戶面前"
		},
		{
			"timestamps": {
				"from": "00:03:50,180",
				"to": "00:03:55,100"
			},
			"offsets": {
				"from": 230180,
				"to": 235100
			},
			"text": "其實在今天的中國就是機會變低都是假白了"
		},
		{
			"timestamps": {
				"from": "00:03:55,100",
				"to": "00:03:59,200"
			},
			"offsets": {
				"from": 235100,
				"to": 239200
			},
			"text": "我們中國是世界級工廠"
		},
		{
			"timestamps": {
				"from": "00:03:59,200",
				"to": "00:04:04,700"
			},
			"offsets": {
				"from": 239200,
				"to": 244700
			},
			"text": "其實有一個我自己當然不是做這種傳統行業"
		},
		{
			"timestamps": {
				"from": "00:04:04,700",
				"to": "00:04:06,860"
			},
			"offsets": {
				"from": 244700,
				"to": 246860
			},
			"text": "但這哪怕做傳統行業機會非常多"
		},
		{
			"timestamps": {
				"from": "00:04:06,860",
				"to": "00:04:09,540"
			},
			"offsets": {
				"from": 246860,
				"to": 249540
			},
			"text": "因為中國世界工廠 中國產能過勝"
		},
		{
			"timestamps": {
				"from": "00:04:09,540",
				"to": "00:04:13,640"
			},
			"offsets": {
				"from": 249540,
				"to": 253640
			},
			"text": "中国的产能,价阶到全世界都是赚钱的"
		},
		{
			"timestamps": {
				"from": "00:04:13,900",
				"to": "00:04:19,260"
			},
			"offsets": {
				"from": 253900,
				"to": 259260
			},
			"text": "实际上,你只要能把东西卖到全世界,当然中国我们不就这么崛起嘛"
		},
		{
			"timestamps": {
				"from": "00:04:19,780",
				"to": "00:04:22,600"
			},
			"offsets": {
				"from": 259780,
				"to": 262600
			},
			"text": "对吧,帮全世界生产东西,就这么崛起的"
		},
		{
			"timestamps": {
				"from": "00:04:23,100",
				"to": "00:04:27,980"
			},
			"offsets": {
				"from": 263100,
				"to": 267980
			},
			"text": "东西卖到全世界,主义想法卖到全世界"
		},
		{
			"timestamps": {
				"from": "00:04:28,480",
				"to": "00:04:31,820"
			},
			"offsets": {
				"from": 268480,
				"to": 271820
			},
			"text": "所有东西,你把全世界的人当作你的客户"
		},
		{
			"timestamps": {
				"from": "00:04:32,080",
				"to": "00:04:35,140"
			},
			"offsets": {
				"from": 272080,
				"to": 275140
			},
			"text": "只要你能怎么样体现出你的价值"
		},
		{
			"timestamps": {
				"from": "00:04:35,660",
				"to": "00:04:38,220"
			},
			"offsets": {
				"from": 275660,
				"to": 278220
			},
			"text": "你根本就不用怕仇卖,实话实说"
		},
		{
			"timestamps": {
				"from": "00:04:39,240",
				"to": "00:04:42,300"
			},
			"offsets": {
				"from": 279240,
				"to": 282300
			},
			"text": "這個時候我就是這麼多年吧"
		},
		{
			"timestamps": {
				"from": "00:04:42,300",
				"to": "00:04:45,100"
			},
			"offsets": {
				"from": 282300,
				"to": 285100
			},
			"text": "我覺得一個最重要的一個私下"
		},
		{
			"timestamps": {
				"from": "00:04:45,100",
				"to": "00:04:47,880"
			},
			"offsets": {
				"from": 285100,
				"to": 287880
			},
			"text": "就是我們這也是為什麼就是我們"
		},
		{
			"timestamps": {
				"from": "00:04:47,880",
				"to": "00:04:50,000"
			},
			"offsets": {
				"from": 287880,
				"to": 290000
			},
			"text": "其實這個節目當然是個華語的節目"
		},
		{
			"timestamps": {
				"from": "00:04:50,000",
				"to": "00:04:51,640"
			},
			"offsets": {
				"from": 290000,
				"to": 291640
			},
			"text": "說面向全中國年輕人"
		},
		{
			"timestamps": {
				"from": "00:04:51,640",
				"to": "00:04:53,280"
			},
			"offsets": {
				"from": 291640,
				"to": 293280
			},
			"text": "對嗎 私意中國年輕人"
		},
		{
			"timestamps": {
				"from": "00:04:53,280",
				"to": "00:04:56,600"
			},
			"offsets": {
				"from": 293280,
				"to": 296600
			},
			"text": "但是我覺得我們是這個節目是希望"
		},
		{
			"timestamps": {
				"from": "00:04:56,600",
				"to": "00:05:01,000"
			},
			"offsets": {
				"from": 296600,
				"to": 301000
			},
			"text": "就是這個私意年輕人走向世界用的"
		},
		{
			"timestamps": {
				"from": "00:05:01,000",
				"to": "00:05:03,720"
			},
			"offsets": {
				"from": 301000,
				"to": 303720
			},
			"text": "我們絕對不是說內卷說"
		},
		{
			"timestamps": {
				"from": "00:05:03,720",
				"to": "00:05:05,640"
			},
			"offsets": {
				"from": 303720,
				"to": 305640
			},
			"text": "這個私意年輕人這個想法"
		},
		{
			"timestamps": {
				"from": "00:05:05,640",
				"to": "00:05:07,680"
			},
			"offsets": {
				"from": 305640,
				"to": 307680
			},
			"text": "就是在這私意年輕人中消費"
		},
		{
			"timestamps": {
				"from": "00:05:07,680",
				"to": "00:05:10,120"
			},
			"offsets": {
				"from": 307680,
				"to": 310120
			},
			"text": "那自己卷自己没有任何意义去抓外国"
		},
		{
			"timestamps": {
				"from": "00:05:10,120",
				"to": "00:05:11,840"
			},
			"offsets": {
				"from": 310120,
				"to": 311840
			},
			"text": "我们是想全球的钱"
		},
		{
			"timestamps": {
				"from": "00:05:11,840",
				"to": "00:05:15,640"
			},
			"offsets": {
				"from": 311840,
				"to": 315640
			},
			"text": "四亿年轻人被AI武装"
		},
		{
			"timestamps": {
				"from": "00:05:15,640",
				"to": "00:05:19,160"
			},
			"offsets": {
				"from": 315640,
				"to": 319160
			},
			"text": "被我们黄毛博基申学的理论武装之后"
		},
		{
			"timestamps": {
				"from": "00:05:19,160",
				"to": "00:05:22,360"
			},
			"offsets": {
				"from": 319160,
				"to": 322360
			},
			"text": "去为全世界的80亿人服务"
		},
		{
			"timestamps": {
				"from": "00:05:22,360",
				"to": "00:05:25,240"
			},
			"offsets": {
				"from": 322360,
				"to": 325240
			},
			"text": "80亿人为了很快还有20亿AI"
		},
		{
			"timestamps": {
				"from": "00:05:25,240",
				"to": "00:05:27,160"
			},
			"offsets": {
				"from": 325240,
				"to": 327160
			},
			"text": "为了20亿AI服务上"
		},
		{
			"timestamps": {
				"from": "00:05:27,160",
				"to": "00:05:31,520"
			},
			"offsets": {
				"from": 327160,
				"to": 331520
			},
			"text": "就全世界的100亿的人和AI都需要服务"
		},
		{
			"timestamps": {
				"from": "00:05:31,520",
				"to": "00:05:33,240"
			},
			"offsets": {
				"from": 331520,
				"to": 333240
			},
			"text": "我们4亿人去服务他们"
		},
		{
			"timestamps": {
				"from": "00:05:33,240",
				"to": "00:05:35,760"
			},
			"offsets": {
				"from": 333240,
				"to": 335760
			},
			"text": "那你想一你就不用内卷了"
		},
		{
			"timestamps": {
				"from": "00:05:35,760",
				"to": "00:05:37,560"
			},
			"offsets": {
				"from": 335760,
				"to": 337560
			},
			"text": "这个不是卷的很厉害"
		},
		{
			"timestamps": {
				"from": "00:05:37,560",
				"to": "00:05:40,340"
			},
			"offsets": {
				"from": 337560,
				"to": 340340
			},
			"text": "因为巴西人总有空隙"
		},
		{
			"timestamps": {
				"from": "00:05:40,340",
				"to": "00:05:42,840"
			},
			"offsets": {
				"from": 340340,
				"to": 342840
			},
			"text": "其次总有机会"
		},
		{
			"timestamps": {
				"from": "00:05:42,840",
				"to": "00:05:44,040"
			},
			"offsets": {
				"from": 342840,
				"to": 344040
			},
			"text": "你今天做这个行也不行"
		},
		{
			"timestamps": {
				"from": "00:05:44,040",
				"to": "00:05:45,280"
			},
			"offsets": {
				"from": 344040,
				"to": 345280
			},
			"text": "明天可以换别的行"
		},
		{
			"timestamps": {
				"from": "00:05:45,280",
				"to": "00:05:46,400"
			},
			"offsets": {
				"from": 345280,
				"to": 346400
			},
			"text": "这个总有机会"
		},
		{
			"timestamps": {
				"from": "00:05:46,400",
				"to": "00:05:48,760"
			},
			"offsets": {
				"from": 346400,
				"to": 348760
			},
			"text": "因为他的需求持足高"
		},
		{
			"timestamps": {
				"from": "00:05:48,760",
				"to": "00:05:55,200"
			},
			"offsets": {
				"from": 348760,
				"to": 355200
			},
			"text": "所以跳出你的境遇"
		},
		{
			"timestamps": {
				"from": "00:05:55,200",
				"to": "00:05:56,640"
			},
			"offsets": {
				"from": 355200,
				"to": 356640
			},
			"text": "因为这个AI时代"
		},
		{
			"timestamps": {
				"from": "00:05:56,640",
				"to": "00:05:59,240"
			},
			"offsets": {
				"from": 356640,
				"to": 359240
			},
			"text": "他所有东西都给你路都打开了"
		},
		{
			"timestamps": {
				"from": "00:05:59,240",
				"to": "00:06:00,840"
			},
			"offsets": {
				"from": 359240,
				"to": 360840
			},
			"text": "所以有时候也不要"
		},
		{
			"timestamps": {
				"from": "00:06:00,840",
				"to": "00:06:02,520"
			},
			"offsets": {
				"from": 360840,
				"to": 362520
			},
			"text": "我建议还有一点"
		},
		{
			"timestamps": {
				"from": "00:06:02,520",
				"to": "00:06:04,080"
			},
			"offsets": {
				"from": 362520,
				"to": 364080
			},
			"text": "确实也不要关键"
		}
	]
}
