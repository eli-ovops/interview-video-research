			},
			"offsets": {
				"from": 399220,
				"to": 429220
			},
			"text": "也有点想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想想"
		},
		{
			"timestamps": {
				"from": "00:07:09,220",
				"to": "00:07:12,620"
			},
			"offsets": {
				"from": 429220,
				"to": 432620
			},
			"text": "就你知道那個不然你在原本在媒體工作"
		},
		{
			"timestamps": {
				"from": "00:07:12,620",
				"to": "00:07:14,120"
			},
			"offsets": {
				"from": 432620,
				"to": 434120
			},
			"text": "我在媒體工作過"
		},
		{
			"timestamps": {
				"from": "00:07:14,120",
				"to": "00:07:17,720"
			},
			"offsets": {
				"from": 434120,
				"to": 437720
			},
			"text": "媒體就是一個很簡單的一個結構是什麼呢"
		},
		{
			"timestamps": {
				"from": "00:07:17,720",
				"to": "00:07:21,820"
			},
			"offsets": {
				"from": 437720,
				"to": 441820
			},
			"text": "主編定選題記者做執行"
		},
		{
			"timestamps": {
				"from": "00:07:21,820",
				"to": "00:07:26,020"
			},
			"offsets": {
				"from": 441820,
				"to": 446020
			},
			"text": "所以基本是這個主編自己的思維"
		},
		{
			"timestamps": {
				"from": "00:07:26,020",
				"to": "00:07:28,220"
			},
			"offsets": {
				"from": 446020,
				"to": 448220
			},
			"text": "就決定所有人怎麼想"
		},
		{
			"timestamps": {
				"from": "00:07:28,220",
				"to": "00:07:30,720"
			},
			"offsets": {
				"from": 448220,
				"to": 450720
			},
			"text": "因為主編定死"
		},
		{
			"timestamps": {
				"from": "00:07:30,720",
				"to": "00:07:32,320"
			},
			"offsets": {
				"from": 450720,
				"to": 452320
			},
			"text": "你說但這個其實是錯誤的"
		},
		{
			"timestamps": {
				"from": "00:07:32,320",
				"to": "00:07:34,520"
			},
			"offsets": {
				"from": 452320,
				"to": 454520
			},
			"text": "你說這個主編又不是神仙"
		},
		{
			"timestamps": {
				"from": "00:07:34,520",
				"to": "00:07:36,920"
			},
			"offsets": {
				"from": 454520,
				"to": 456920
			},
			"text": "主編所有東西就一定是對的嗎"
		},
		{
			"timestamps": {
				"from": "00:07:36,920",
				"to": "00:07:37,940"
			},
			"offsets": {
				"from": 456920,
				"to": 457940
			},
			"text": "这就中心不对"
		},
		{
			"timestamps": {
				"from": "00:07:38,700",
				"to": "00:07:43,320"
			},
			"offsets": {
				"from": 458700,
				"to": 463320
			},
			"text": "对中心吧 你其实原则他应该允许自媒体 允许所有人发言"
		},
		{
			"timestamps": {
				"from": "00:07:43,580",
				"to": "00:07:48,180"
			},
			"offsets": {
				"from": 463580,
				"to": 468180
			},
			"text": "因为所有人发言才大概率能够接近真理嘛 每个人都发言"
		},
		{
			"timestamps": {
				"from": "00:07:48,440",
				"to": "00:07:51,500"
			},
			"offsets": {
				"from": 468440,
				"to": 471500
			},
			"text": "每个人都表达自己的观点 都变论"
		},
		{
			"timestamps": {
				"from": "00:07:51,780",
				"to": "00:07:55,100"
			},
			"offsets": {
				"from": 471780,
				"to": 475100
			},
			"text": "但以前没有自媒体时代那不行嘛 不可以跟你说"
		},
		{
			"timestamps": {
				"from": "00:07:55,860",
				"to": "00:07:56,880"
			},
			"offsets": {
				"from": 475860,
				"to": 476880
			},
			"text": "不可以跟你说"
		},
		{
			"timestamps": {
				"from": "00:07:57,400",
				"to": "00:08:01,760"
			},
			"offsets": {
				"from": 477400,
				"to": 481760
			},
			"text": "我觉得自媒体时代很重要 就是给了大家一个什么"
		},
		{
			"timestamps": {
				"from": "00:08:02,260",
				"to": "00:08:04,060"
			},
			"offsets": {
				"from": 482260,
				"to": 484060
			},
			"text": "所有人都可以发言的机会"
		},
		{
			"timestamps": {
				"from": "00:08:04,820",
				"to": "00:08:08,480"
			},
			"offsets": {
				"from": 484820,
				"to": 488480
			},
			"text": "所以這就是為什麼你看這個抖音啊YouTube吧"
		},
		{
			"timestamps": {
				"from": "00:08:08,480",
				"to": "00:08:10,400"
			},
			"offsets": {
				"from": 488480,
				"to": 490400
			},
			"text": "對吧 推特寫就興起了"
		},
		{
			"timestamps": {
				"from": "00:08:10,400",
				"to": "00:08:14,920"
			},
			"offsets": {
				"from": 490400,
				"to": 494920
			},
			"text": "因為這些都是上面 大概都可以發言那麼大概率啊 大概率"
		},
		{
			"timestamps": {
				"from": "00:08:14,920",
				"to": "00:08:20,660"
			},
			"offsets": {
				"from": 494920,
				"to": 500660
			},
			"text": "這個事上面這些平台產出的觀點 大概率是對"
		},
		{
			"timestamps": {
				"from": "00:08:22,660",
				"to": "00:08:27,020"
			},
			"offsets": {
				"from": 502660,
				"to": 507020
			},
			"text": "因為它是個市場精神的解 對吧"
		},
		{
			"timestamps": {
				"from": "00:08:27,020",
				"to": "00:08:29,400"
			},
			"offsets": {
				"from": 507020,
				"to": 509400
			},
			"text": "你別的 你沒有市場精神"
		},
		{
			"timestamps": {
				"from": "00:08:29,400",
				"to": "00:08:32,780"
			},
			"offsets": {
				"from": 509400,
				"to": 512780
			},
			"text": "你就很有可能誤導 很有可能屁股決定腦袋"
		},
		{
			"timestamps": {
				"from": "00:08:32,780",
				"to": "00:08:35,080"
			},
			"offsets": {
				"from": 512780,
				"to": 515080
			},
			"text": "很有可能就是大家没有充分思考"
		},
		{
			"timestamps": {
				"from": "00:08:36,120",
				"to": "00:08:37,380"
			},
			"offsets": {
				"from": 516120,
				"to": 517380
			},
			"text": "然后所有人都被误导了"
		},
		{
			"timestamps": {
				"from": "00:08:37,380",
				"to": "00:08:38,920"
			},
			"offsets": {
				"from": 517380,
				"to": 518920
			},
			"text": "因为他这个报纸啊"
		},
