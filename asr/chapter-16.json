				"to": "00:00:57,840"
			},
			"offsets": {
				"from": 54240,
				"to": 57840
			},
			"text": "那么这个东西就没有下去 正了也白症"
		},
		{
			"timestamps": {
				"from": "00:00:58,600",
				"to": "00:01:03,440"
			},
			"offsets": {
				"from": 58600,
				"to": 63440
			},
			"text": "对吧 因为你正出来的 你全世界你怎么正的 这个思路几个人知道没有人知道"
		},
		{
			"timestamps": {
				"from": "00:01:03,960",
				"to": "00:01:09,840"
			},
			"offsets": {
				"from": 63960,
				"to": 69840
			},
			"text": "你必须把他形式化了 传到AI 让计算基督总了 采算是消化"
		},
		{
			"timestamps": {
				"from": "00:01:10,880",
				"to": "00:01:17,280"
			},
			"offsets": {
				"from": 70880,
				"to": 77280
			},
			"text": "对吧 就就是这么一个理念 就是说你如果没有这个东西"
		},
		{
			"timestamps": {
				"from": "00:01:17,540",
				"to": "00:01:21,120"
			},
			"offsets": {
				"from": 77540,
				"to": 81120
			},
			"text": "机器没督动 其实人类节发明就没有意义"
		},
		{
			"timestamps": {
				"from": "00:01:21,380",
				"to": "00:01:26,000"
			},
			"offsets": {
				"from": 81380,
				"to": 86000
			},
			"text": "所以我们人类现在处于一个就是从人类向机器的这么一个过渡"
		},
		{
			"timestamps": {
				"from": "00:01:26,000",
				"to": "00:01:28,400"
			},
			"offsets": {
				"from": 86000,
				"to": 88400
			},
			"text": "从探机向规机的这么一个过渡"
		},
		{
			"timestamps": {
				"from": "00:01:28,400",
				"to": "00:01:32,060"
			},
			"offsets": {
				"from": 88400,
				"to": 92060
			},
			"text": "所以在这个中间你充当一个翻译官很关键"
		},
		{
			"timestamps": {
				"from": "00:01:32,060",
				"to": "00:01:35,140"
			},
			"offsets": {
				"from": 92060,
				"to": 95140
			},
			"text": "就说这个机器要得懂"
		},
		{
			"timestamps": {
				"from": "00:01:35,140",
				"to": "00:01:37,040"
			},
			"offsets": {
				"from": 95140,
				"to": 97040
			},
			"text": "你把数学要翻译给机器"
		},
		{
			"timestamps": {
