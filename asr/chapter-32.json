				"to": 409260
			},
			"text": "对 所以我觉得就是可能"
		},
		{
			"timestamps": {
				"from": "00:06:49,260",
				"to": "00:06:53,100"
			},
			"offsets": {
				"from": 409260,
				"to": 413100
			},
			"text": "就是这个意义本身"
		},
		{
			"timestamps": {
				"from": "00:06:53,100",
				"to": "00:06:55,240"
			},
			"offsets": {
				"from": 413100,
				"to": 415240
			},
			"text": "可能並沒有那麼大"
		},
		{
			"timestamps": {
				"from": "00:06:55,240",
				"to": "00:07:00,060"
			},
			"offsets": {
				"from": 415240,
				"to": 420060
			},
			"text": "這個東西我推薦大家看一個"
		},
		{
			"timestamps": {
				"from": "00:07:00,060",
				"to": "00:07:02,560"
			},
			"offsets": {
				"from": 420060,
				"to": 422560
			},
			"text": "就是一個句 挺有意思的"
		},
		{
			"timestamps": {
				"from": "00:07:02,560",
				"to": "00:07:04,280"
			},
			"offsets": {
				"from": 422560,
				"to": 424280
			},
			"text": "叫Rick and Morty"
		},
		{
			"timestamps": {
				"from": "00:07:04,280",
				"to": "00:07:06,620"
			},
			"offsets": {
				"from": 424280,
				"to": 426620
			},
			"text": "Rick and Morty"
		},
		{
			"timestamps": {
				"from": "00:07:06,620",
				"to": "00:07:08,960"
			},
			"offsets": {
				"from": 426620,
				"to": 428960
			},
			"text": "Rick and Morty裡面那個Morty"
		},
		{
			"timestamps": {
				"from": "00:07:08,960",
				"to": "00:07:11,960"
			},
			"offsets": {
				"from": 428960,
				"to": 431960
			},
			"text": "就是經常會問爺爺一些"
		},
		{
			"timestamps": {
				"from": "00:07:11,960",
				"to": "00:07:14,100"
			},
			"offsets": {
				"from": 431960,
				"to": 434100
			},
			"text": "就是他Morty是一個小孩"
		},
		{
			"timestamps": {
				"from": "00:07:14,100",
				"to": "00:07:16,400"
			},
			"offsets": {
				"from": 434100,
				"to": 436400
			},
			"text": "那個Rick是他爺爺"
		},
		{
			"timestamps": {
				"from": "00:07:16,400",
				"to": "00:07:20,660"
			},
			"offsets": {
				"from": 436400,
				"to": 440660
			},
			"text": "然後他就經常就是會問爺爺一些人生有什麼意義啊"
		},
		{
			"timestamps": {
				"from": "00:07:20,660",
				"to": "00:07:24,500"
			},
			"offsets": {
				"from": 440660,
				"to": 444500
			},
			"text": "然後他爺爺那就是就笑不語"
		},
		{
			"timestamps": {
				"from": "00:07:24,500",
				"to": "00:07:29,060"
			},
			"offsets": {
				"from": 444500,
				"to": 449060
			},
			"text": "然後呢Rick那個摩地那就會給爺爺馬上講一個結論"
		},
		{
			"timestamps": {
				"from": "00:07:29,900",
				"to": "00:07:34,180"
			},
			"offsets": {
				"from": 449900,
				"to": 454180
			},
			"text": "然後呢那個爺爺那馬上這個爺爺很很惡搞"
		},
		{
			"timestamps": {
				"from": "00:07:34,180",
				"to": "00:07:35,780"
			},
			"offsets": {
				"from": 454180,
				"to": 455780
			},
			"text": "但爺爺是個惡搞的角色"
		},
		{
			"timestamps": {
				"from": "00:07:36,020",
				"to": "00:07:39,140"
			},
			"offsets": {
				"from": 456020,
				"to": 459140
			},
			"text": "就那個摩地那每次講一個無論什麼樣的結論"
		},
		{
			"timestamps": {
				"from": "00:07:40,020",
				"to": "00:07:44,340"
			},
			"offsets": {
				"from": 460020,
				"to": 464340
			},
			"text": "爺爺都能立刻在宇宙中帶他去宇宙的另外一個地方了"
		},
		{
			"timestamps": {
				"from": "00:07:44,340",
				"to": "00:07:45,860"
			},
			"offsets": {
				"from": 464340,
				"to": 465860
			},
			"text": "就是找出反力"
		},
		{
			"timestamps": {
				"from": "00:07:49,580",
				"to": "00:08:12,980"
			},
			"offsets": {
				"from": 469580,
				"to": 492980
			},
			"text": "就像魔帝根本无法总结这个宇宙,因为那无论怎么讲,他业力跟找到一个反力,然后就是挺有意思的一个,就是这么一个电视剧,但是某种程度,当然他业也都能找出这个反力,因为他业其实是一个宇宙之亡,"
		},
		{
			"timestamps": {
				"from": "00:08:12,980",
				"to": "00:08:17,780"
			},
			"offsets": {
				"from": 492980,
				"to": 497780
			},
			"text": "整個宇宙無事無事無小的一個角色"
		},
		{
			"timestamps": {
				"from": "00:08:17,780",
				"to": "00:08:21,240"
			},
			"offsets": {
				"from": 497780,
				"to": 501240
			},
			"text": "但是他也是通過這個原因他才能"
		},
		{
			"timestamps": {
				"from": "00:08:21,240",
				"to": "00:08:23,960"
			},
			"offsets": {
				"from": 501240,
				"to": 503960
			},
			"text": "也某人說明我們剛才這個問題"
		},
		{
			"timestamps": {
				"from": "00:08:23,960",
				"to": "00:08:27,560"
			},
			"offsets": {
				"from": 503960,
				"to": 507560
			},
			"text": "就是在那瑞克的角度"
		},
		{
			"timestamps": {
				"from": "00:08:27,560",
				"to": "00:08:28,840"
			},
			"offsets": {
				"from": 507560,
				"to": 508840
			},
			"text": "當然有點虛無來的"
		},
		{
			"timestamps": {
				"from": "00:08:28,840",
				"to": "00:08:30,340"
			},
			"offsets": {
				"from": 508840,
				"to": 510340
			},
			"text": "但是瑞克最後其實這個結論"
		},
		{
			"timestamps": {
				"from": "00:08:30,340",
				"to": "00:08:34,880"
			},
			"offsets": {
				"from": 510340,
				"to": 514880
			},
			"text": "其實就是可能他不再追求什麼意義了"
		},
		{
			"timestamps": {
				"from": "00:08:34,880",
				"to": "00:08:38,780"
			},
			"offsets": {
				"from": 514880,
				"to": 518780
			},
			"text": "而是整個人生就只有他體驗的一個集合"
		},
		{
			"timestamps": {
				"from": "00:08:38,780",
				"to": "00:08:40,340"
			},
			"offsets": {
				"from": 518780,
				"to": 520340
			},
			"text": "其實其實就是"
		}
	]
}
