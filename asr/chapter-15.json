				"to": 217420
			},
			"text": "那你说你我为什么练脖子这个东西"
		},
		{
			"timestamps": {
				"from": "00:03:37,420",
				"to": "00:03:39,180"
			},
			"offsets": {
				"from": 217420,
				"to": 219180
			},
			"text": "当然我们可以讲理论讲那个"
		},
		{
			"timestamps": {
				"from": "00:03:39,180",
				"to": "00:03:40,380"
			},
			"offsets": {
				"from": 219180,
				"to": 220380
			},
			"text": "但是其实很难解释"
		},
		{
			"timestamps": {
				"from": "00:03:40,380",
				"to": "00:03:42,660"
			},
			"offsets": {
				"from": 220380,
				"to": 222660
			},
			"text": "别人也很难证语和证实"
		},
		{
			"timestamps": {
				"from": "00:03:42,660",
				"to": "00:03:44,700"
			},
			"offsets": {
				"from": 222660,
				"to": 224700
			},
			"text": "因为这个动机它是个主观的"
		},
		{
			"timestamps": {
				"from": "00:03:44,700",
				"to": "00:03:48,940"
			},
			"offsets": {
				"from": 224700,
				"to": 228940
			},
			"text": "说区块链他们就归音就叫歌手餐"
		},
		{
			"timestamps": {
				"from": "00:03:48,940",
				"to": "00:03:51,340"
			},
			"offsets": {
				"from": 228940,
				"to": 231340
			},
			"text": "只要做区块链那你就是歌手餐"
		},
		{
			"timestamps": {
				"from": "00:03:51,340",
				"to": "00:03:55,300"
			},
			"offsets": {
				"from": 231340,
				"to": 235300
			},
			"text": "歌手餐的意思就是说你把一个没价值的东西"
		},
		{
			"timestamps": {
				"from": "00:03:55,300",
				"to": "00:03:57,780"
			},
			"offsets": {
				"from": 235300,
				"to": 237780
			},
			"text": "就是用高价格卖给点"
		},
		{
			"timestamps": {
				"from": "00:03:57,780",
				"to": "00:04:01,420"
			},
			"offsets": {
				"from": 237780,
				"to": 241420
			},
			"text": "然后给大家留下一个没有价值的东西"
		},
		{
			"timestamps": {
				"from": "00:04:01,420",
				"to": "00:04:05,940"
			},
			"offsets": {
				"from": 241420,
				"to": 245940
			},
			"text": "但是它是说你前面你的动机就是为了担心点事"
		},
		{
			"timestamps": {
				"from": "00:04:07,140",
				"to": "00:04:12,500"
			},
			"offsets": {
				"from": 247140,
				"to": 252500
			},
			"text": "但就不讲技术和这个东西对人类带来的好处了"
		},
		{
			"timestamps": {
				"from": "00:04:12,500",
				"to": "00:04:13,520"
			},
			"offsets": {
				"from": 252500,
				"to": 253520
			},
			"text": "他就不见"
		},
		{
			"timestamps": {
				"from": "00:04:13,780",
				"to": "00:04:16,080"
			},
			"offsets": {
				"from": 253780,
				"to": 256080
			},
			"text": "所以我觉得呢就是这个"
		}
	]
}
