	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:07,000"
			},
			"offsets": {
				"from": 0,
				"to": 7000
			},
			"text": "我继续讲一下 从小脖鸡就加上我自己的学习的心得"
		},
		{
			"timestamps": {
				"from": "00:00:07,000",
				"to": "00:00:13,000"
			},
			"offsets": {
				"from": 7000,
				"to": 13000
			},
			"text": "脖鸡也不光是练脖鸡 你得先购注整个身体健康的一个基础理论"
		},
		{
			"timestamps": {
				"from": "00:00:13,000",
				"to": "00:00:16,000"
			},
			"offsets": {
				"from": 13000,
				"to": 16000
			},
			"text": "认知现在看圣经 现在看脖鸡圣经"
		},
		{
			"timestamps": {
				"from": "00:00:16,000",
				"to": "00:00:21,000"
			},
			"offsets": {
				"from": 16000,
				"to": 21000
			},
			"text": "对 一些最基础的理论 对不对 一些最基础的理论"
		},
		{
			"timestamps": {
				"from": "00:00:21,000",
				"to": "00:00:28,000"
			},
			"offsets": {
				"from": 21000,
				"to": 28000
			},
			"text": "这些理论你都建立了 其实脖鸡只是你具体主动健康管理的一个"
		},
		{
			"timestamps": {
				"from": "00:00:28,000",
				"to": "00:00:29,520"
			},
			"offsets": {
				"from": 28000,
				"to": 29520
			},
			"text": "写信"
		},
		{
			"timestamps": {
				"from": "00:00:29,800",
				"to": "00:00:31,320"
			},
			"offsets": {
				"from": 29800,
				"to": 31320
			},
			"text": "对啊写信"
		},
		{
			"timestamps": {
				"from": "00:00:32,360",
				"to": "00:00:33,880"
			},
			"offsets": {
				"from": 32360,
				"to": 33880
			},
			"text": "她是一种"
		},
		{
			"timestamps": {
				"from": "00:00:34,140",
				"to": "00:00:38,500"
			},
			"offsets": {
				"from": 34140,
				"to": 38500
			},
			"text": "所以说我一直说伯吉是一种认知的体现高齿力的体现和自控力的体现"
		},
		{
			"timestamps": {
				"from": "00:00:39,000",
				"to": "00:00:40,040"
			},
			"offsets": {
				"from": 39000,
				"to": 40040
			},
			"text": "它不是一个单纯的"
		},
		{
			"timestamps": {
				"from": "00:00:40,800",
				"to": "00:00:41,580"
			},
			"offsets": {
				"from": 40800,
				"to": 41580
			},
			"text": "表面的"
		},
		{
			"timestamps": {
				"from": "00:00:41,840",
				"to": "00:00:42,340"
			},
			"offsets": {
				"from": 41840,
				"to": 42340
			},
			"text": "肌肉"
		},
		{
			"timestamps": {
				"from": "00:00:42,840",
				"to": "00:00:44,640"
			},
			"offsets": {
				"from": 42840,
				"to": 44640
			},
			"text": "对你讲太对了"
		},
		{
			"timestamps": {
				"from": "00:00:44,900",
				"to": "00:00:47,720"
			},
			"offsets": {
				"from": 44900,
				"to": 47720
			},
			"text": "你你知道这概念吗就是"
		},
		{
			"timestamps": {
				"from": "00:00:48,220",
				"to": "00:00:51,560"
			},
			"offsets": {
				"from": 48220,
				"to": 51560
			},
			"text": "我在这个例子我觉得就是大家就理解更深刻"
		},
		{
			"timestamps": {
				"from": "00:00:52,060",
				"to": "00:00:54,360"
			},
			"offsets": {
				"from": 52060,
				"to": 54360
			},
			"text": "就比如说这个农民工也有伯吉"
		},
		{
			"timestamps": {
				"from": "00:00:54,880",
				"to": "00:00:57,700"
			},
			"offsets": {
				"from": 54880,
				"to": 57700
			},
			"text": "但是农民工和我们的伯吉不是一样"
		},
		{
			"timestamps": {
				"from": "00:00:58,000",
				"to": "00:01:01,080"
			},
			"offsets": {
				"from": 58000,
				"to": 61080
			},
			"text": "因為農民工的那個伯吉是被動臉的"
		},
		{
			"timestamps": {
				"from": "00:01:01,580",
				"to": "00:01:03,900"
			},
			"offsets": {
				"from": 61580,
				"to": 63900
			},
			"text": "所以很多農民工可能在成立"
		},
		{
			"timestamps": {
				"from": "00:01:04,140",
				"to": "00:01:07,220"
			},
			"offsets": {
				"from": 64140,
				"to": 67220
			},
			"text": "當建築工人的時候有伯吉回家就很快就吹肥了"
		},
		{
			"timestamps": {
				"from": "00:01:07,480",
				"to": "00:01:10,540"
			},
			"offsets": {
				"from": 67480,
				"to": 70540
			},
			"text": "因為他這個伯吉只是他的一個工作帶來的"
		},
		{
			"timestamps": {
				"from": "00:01:10,800",
				"to": "00:01:12,600"
			},
			"offsets": {
				"from": 70800,
				"to": 72600
			},
			"text": "班端帶來伯吉"
		},
		{
			"timestamps": {
				"from": "00:01:13,100",
				"to": "00:01:17,460"
			},
			"offsets": {
				"from": 73100,
				"to": 77460
			},
			"text": "但是呢為什麼這個給農民工沒有帶來相應的壽命的提升的什麼提升"
		},
		{
			"timestamps": {
				"from": "00:01:17,720",
				"to": "00:01:21,560"
			},
			"offsets": {
				"from": 77720,
				"to": 81560
			},
			"text": "第一個他回去可能就沒伯吉了因為他沒有想過這個主動家的管理"
		},
		{
			"timestamps": {
				"from": "00:01:21,800",
				"to": "00:01:23,600"
			},
			"offsets": {
				"from": 81800,
				"to": 83600
			},
			"text": "沒有想過這個熱量缺口"
		},
		{
			"timestamps": {
				"from": "00:01:23,860",
				"to": "00:01:24,620"
			},
			"offsets": {
				"from": 83860,
				"to": 84620
			},
			"text": "沒有想過這個"
		},
		{
			"timestamps": {
				"from": "00:01:24,880",
				"to": "00:01:26,420"
			},
			"offsets": {
				"from": 84880,
				"to": 86420
			},
			"text": "對他不短也沒想過這些"
		},
		{
			"timestamps": {
				"from": "00:01:26,680",
				"to": "00:01:29,720"
			},
			"offsets": {
				"from": 86680,
				"to": 89720
			},
			"text": "一样学他不懂 但白志节不懂"
		},
		{
			"timestamps": {
				"from": "00:01:29,720",
				"to": "00:01:33,040"
			},
			"offsets": {
				"from": 89720,
				"to": 93040
			},
			"text": "他只是可能被动的练肌肉"
		},
		{
			"timestamps": {
				"from": "00:01:33,040",
				"to": "00:01:35,040"
			},
			"offsets": {
				"from": 93040,
				"to": 95040
			},
			"text": "其实蛋白志补充也不充分"
		},
		{
			"timestamps": {
				"from": "00:01:35,040",
				"to": "00:01:38,120"
			},
			"offsets": {
				"from": 95040,
				"to": 98120
			},
			"text": "只不过他是肌肉也是练了一点"
		},
		{
			"timestamps": {
				"from": "00:01:38,120",
				"to": "00:01:40,320"
			},
			"offsets": {
				"from": 98120,
				"to": 100320
			},
			"text": "然后那个脂肪肯定记得也不了吗"
		},
		{
			"timestamps": {
				"from": "00:01:40,320",
				"to": "00:01:41,680"
			},
			"offsets": {
				"from": 100320,
				"to": 101680
			},
			"text": "暴露出来"
		},
		{
			"timestamps": {
				"from": "00:01:41,680",
				"to": "00:01:43,960"
			},
			"offsets": {
				"from": 101680,
				"to": 103960
			},
			"text": "但是他营养学这背后都没有"
		},
		{
			"timestamps": {
				"from": "00:01:43,960",
				"to": "00:01:47,360"
			},
			"offsets": {
				"from": 103960,
				"to": 107360
			},
			"text": "但是跟我们孙学博基黄毛理论的就不一样"
		},
		{
			"timestamps": {
				"from": "00:01:47,360",
				"to": "00:01:50,360"
			},
			"offsets": {
				"from": 107360,
				"to": 110360
			},
			"text": "我们是最早就屋了"
		},
		{
			"timestamps": {
				"from": "00:01:50,360",
				"to": "00:01:53,360"
			},
			"offsets": {
				"from": 110360,
				"to": 113360
			},
			"text": "是有架构的 他地基很稳"
		},
		{
			"timestamps": {
				"from": "00:01:53,360",
				"to": "00:01:55,920"
			},
			"offsets": {
				"from": 113360,
				"to": 115920
			},
			"text": "啊 低级稳 而且我们最早就不来"
		},
		{
			"timestamps": {
				"from": "00:01:56,700",
				"to": "00:02:00,780"
			},
			"offsets": {
				"from": 116700,
				"to": 120780
			},
			"text": "然后我现在比如说我现在可能啊 但我要得看我自己的执行"
		},
		{
			"timestamps": {
				"from": "00:02:01,040",
				"to": "00:02:04,360"
			},
			"offsets": {
				"from": 121040,
				"to": 124360
			},
			"text": "但我现在就可以说我六个月后就将拥有脖袭"
		},
		{
			"timestamps": {
				"from": "00:02:04,620",
				"to": "00:02:07,700"
			},
			"offsets": {
				"from": 124620,
				"to": 127700
			},
			"text": "可能这个没看我们这个节目的人看我现在大肚子还嘲笑我的"
		},
		{
			"timestamps": {
				"from": "00:02:07,940",
				"to": "00:02:09,740"
			},
			"offsets": {
				"from": 127940,
				"to": 129740
			},
			"text": "但我告诉你我六个月以后就会脖袭"
		},
		{
			"timestamps": {
				"from": "00:02:10,260",
				"to": "00:02:15,880"
			},
			"offsets": {
				"from": 130260,
				"to": 135880
			},
			"text": "他可能在他眼里有肌肉和没肌肉 两个人就是两类"
		},
		{
			"timestamps": {
				"from": "00:02:16,140",
				"to": "00:02:20,240"
			},
			"offsets": {
				"from": 136140,
				"to": 140240
			},
			"text": "但是在我看来我可能六个月前我就有肌肉了 为什么呢 因为我"
		},
		{
			"timestamps": {
				"from": "00:02:21,260",
				"to": "00:02:23,940"
			},
			"offsets": {
				"from": 141260,
				"to": 143940
			},
			"text": "这个也是我一六年的岁也没什么钱"
		},
		{
			"timestamps": {
				"from": "00:02:24,660",
				"to": "00:02:30,140"
			},
			"offsets": {
				"from": 144660,
				"to": 150140
			},
			"text": "但是我前辈可能这个当然我不是一六年的一客户的"
		},
		{
			"timestamps": {
				"from": "00:02:30,140",
				"to": "00:02:32,500"
			},
			"offsets": {
				"from": 150140,
				"to": 152500
			},
			"text": "因为一六年我的理论已经写出来了"
		},
		{
			"timestamps": {
				"from": "00:02:32,500",
				"to": "00:02:34,340"
			},
			"offsets": {
				"from": 152500,
				"to": 154340
			},
			"text": "我可能这一二年就开机杂"
		},
		{
			"timestamps": {
				"from": "00:02:34,340",
				"to": "00:02:35,980"
			},
			"offsets": {
				"from": 154340,
				"to": 155980
			},
			"text": "一年我开始误误对吧"
		},
		{
			"timestamps": {
				"from": "00:02:36,380",
				"to": "00:02:37,980"
			},
			"offsets": {
				"from": 156380,
				"to": 157980
			},
			"text": "一六年我理论程庆了"
		},
		{
			"timestamps": {
				"from": "00:02:38,220",
				"to": "00:02:39,940"
			},
			"offsets": {
				"from": 158220,
				"to": 159940
			},
			"text": "在我理论程庆的一客呢"
		},
		{
			"timestamps": {
				"from": "00:02:39,940",
				"to": "00:02:41,740"
			},
			"offsets": {
				"from": 159940,
				"to": 161740
			},
			"text": "我也没什么钱 说话是说"
		},
		{
			"timestamps": {
				"from": "00:02:42,500",
				"to": "00:02:44,540"
			},
			"offsets": {
				"from": 162500,
				"to": 164540
			},
			"text": "至少是比现代的差远了"
		},
		{
			"timestamps": {
				"from": "00:02:44,540",
				"to": "00:02:46,740"
			},
			"offsets": {
				"from": 164540,
				"to": 166740
			},
			"text": "可能差一千倍一万倍的财富"
		},
		{
			"timestamps": {
				"from": "00:02:47,900",
				"to": "00:02:50,220"
			},
			"offsets": {
				"from": 167900,
				"to": 170220
			},
			"text": "但是我那个时候就误误了"
		},
		{
			"timestamps": {
				"from": "00:02:51,260",
				"to": "00:02:53,560"
			},
			"offsets": {
				"from": 171260,
				"to": 173560
			},
			"text": "那時候我跟毛澤東可能差得很遠"
		},
		{
			"timestamps": {
				"from": "00:02:53,560",
				"to": "00:02:56,640"
			},
			"offsets": {
				"from": 173560,
				"to": 176640
			},
			"text": "那毛澤東把甩尾一百條街 對吧"
		},
		{
			"timestamps": {
				"from": "00:02:58,160",
				"to": "00:03:00,200"
			},
			"offsets": {
				"from": 178160,
				"to": 180200
			},
			"text": "但是呢 我那個時候都誤"
		},
		{
			"timestamps": {
				"from": "00:03:00,200",
				"to": "00:03:02,260"
			},
			"offsets": {
				"from": 180200,
				"to": 182260
			},
			"text": "但時間會這裡分之恨"
		},
		{
			"timestamps": {
				"from": "00:03:03,040",
				"to": "00:03:05,340"
			},
			"offsets": {
				"from": 183040,
				"to": 185340
			},
			"text": "對 時間對面是這點很關鍵"
		},
		{
			"timestamps": {
				"from": "00:03:05,340",
				"to": "00:03:07,900"
			},
			"offsets": {
				"from": 185340,
				"to": 187900
			},
			"text": "因為他誤了和沒誤"
		},
		{
			"timestamps": {
				"from": "00:03:08,420",
				"to": "00:03:11,480"
			},
			"offsets": {
				"from": 188420,
				"to": 191480
			},
			"text": "其實並不是光看 其實是光看錢"
		},
		{
			"timestamps": {
				"from": "00:03:11,740",
				"to": "00:03:13,540"
			},
			"offsets": {
				"from": 191740,
				"to": 193540
			},
			"text": "他是誤了沒誤這個"
		},
		{
			"timestamps": {
				"from": "00:03:14,040",
				"to": "00:03:16,100"
			},
			"offsets": {
				"from": 194040,
				"to": 196100
			},
			"text": "未後是以後他理論的"
		},
		{
			"timestamps": {
				"from": "00:03:16,860",
				"to": "00:03:23,760"
			},
			"offsets": {
				"from": 196860,
				"to": 203760
			},
			"text": "基本上脑子,大脑认知决定一切,钱肌肉"
		},
		{
			"timestamps": {
				"from": "00:03:23,760",
				"to": "00:03:27,160"
			},
			"offsets": {
				"from": 203760,
				"to": 207160
			},
			"text": "什么是都是写钱,都是任职的写钱"
		},
		{
			"timestamps": {
