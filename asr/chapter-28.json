				"from": "00:10:42,060",
				"to": "00:10:42,060"
			},
			"offsets": {
				"from": 642060,
				"to": 642060
			},
			"text": "对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对对"
		},
		{
			"timestamps": {
				"from": "00:10:42,060",
				"to": "00:10:46,300"
			},
			"offsets": {
				"from": 642060,
				"to": 646300
			},
			"text": "對吧伊龍罵斯克特朗普巴斯特朗普都不如我們的人家"
		},
