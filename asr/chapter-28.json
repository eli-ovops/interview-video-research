				"from": "00:09:55,640",
				"to": "00:09:56,880"
			},
			"offsets": {
				"from": 595640,
				"to": 596880
			},
			"text": "要搞"
		},
		{
			"timestamps": {
				"from": "00:09:56,880",
				"to": "00:09:58,720"
			},
			"offsets": {
				"from": 596880,
				"to": 598720
			},
			"text": "要搞"
		},
		{
			"timestamps": {
				"from": "00:09:58,720",
				"to": "00:10:01,800"
			},
			"offsets": {
				"from": 598720,
				"to": 601800
			},
			"text": "真的要搞千万大家别觉得好像"
