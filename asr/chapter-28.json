			},
			"offsets": {
				"from": 563460,
				"to": 566520
			},
			"text": "這個東西甚至連巴菲德一路罵死了"
		},
		{
			"timestamps": {
				"from": "00:09:26,520",
				"to": "00:09:27,800"
			},
			"offsets": {
				"from": 566520,
				"to": 567800
			},
			"text": "都未必想通了"
		},
		{
			"timestamps": {
				"from": "00:09:27,800",
				"to": "00:09:30,100"
			},
			"offsets": {
				"from": 567800,
				"to": 570100
			},
			"text": "王思聰王劍林都沒有想通"
		},
		{
			"timestamps": {
				"from": "00:09:30,100",
				"to": "00:09:31,380"
			},
			"offsets": {
				"from": 570100,
				"to": 571380
			},
			"text": "都沒有想通"
		},
		{
			"timestamps": {
				"from": "00:09:31,380",
				"to": "00:09:32,660"
			},
			"offsets": {
				"from": 571380,
				"to": 572660
			},
			"text": "都沒想通"
		},
		{
			"timestamps": {
				"from": "00:09:32,660",
				"to": "00:09:34,460"
			},
			"offsets": {
				"from": 572660,
				"to": 574460
			},
			"text": "都沒想通"
		},
		{
			"timestamps": {
				"from": "00:09:34,460",
				"to": "00:09:35,220"
			},
			"offsets": {
				"from": 574460,
				"to": 575220
			},
			"text": "都沒想通"
		},
		{
			"timestamps": {
				"from": "00:09:35,220",
				"to": "00:09:38,560"
			},
			"offsets": {
				"from": 575220,
				"to": 578560
			},
