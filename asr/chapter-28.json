				"from": "00:10:25,420",
				"to": "00:10:27,120"
			},
			"offsets": {
				"from": 625420,
				"to": 627120
			},
			"text": "但是那股收的人"
		},
		{
			"timestamps": {
				"from": "00:10:27,360",
				"to": "00:10:28,660"
			},
			"offsets": {
				"from": 627360,
				"to": 628660
			},
			"text": "就孔子都没你懂了"
		},
		{
			"timestamps": {
				"from": "00:10:28,660",
				"to": "00:10:29,780"
			},
			"offsets": {
				"from": 628660,
				"to": 629780
			},
			"text": "孔子以为是"
		},
		{
			"timestamps": {
				"from": "00:10:29,780",
				"to": "00:10:33,360"
			},
			"offsets": {
				"from": 629780,
				"to": 633360
			},
			"text": "这个地球太阳谁绕谁转的不一定呢"
		},
		{
			"timestamps": {
				"from": "00:10:33,620",
				"to": "00:10:35,400"
			},
			"offsets": {
				"from": 633620,
				"to": 635400
			},
			"text": "所以这个任职的更新是"
