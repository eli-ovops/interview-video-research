		},
		{
			"timestamps": {
				"from": "00:09:38,560",
				"to": "00:09:39,720"
			},
			"offsets": {
				"from": 578560,
				"to": 579720
			},
			"text": "反正要不断更新"
		},
		{
			"timestamps": {
				"from": "00:09:39,720",
				"to": "00:09:39,720"
			},
			"offsets": {
				"from": 579720,
				"to": 579720
			},
			"text": "反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反反"
		},
		{
			"timestamps": {
				"from": "00:09:39,720",
				"to": "00:09:42,040"
			},
			"offsets": {
				"from": 579720,
				"to": 582040
			},
			"text": "但不能太依靠"
		},
		{
			"timestamps": {
				"from": "00:09:42,040",
				"to": "00:09:43,600"
			},
			"offsets": {
				"from": 582040,
				"to": 583600
			},
			"text": "对依靠太大"
		},
		{
			"timestamps": {
				"from": "00:09:43,600",
				"to": "00:09:46,280"
			},
			"offsets": {
				"from": 583600,
				"to": 586280
			},
			"text": "但是我不敢说咱俩想捧"
		},
		{
