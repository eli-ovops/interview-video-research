	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:09,500"
			},
			"offsets": {
				"from": 0,
				"to": 9500
			},
			"text": "然后呢 别人也经常有的人就问过啊 说对吧 说哎 你瞬诚 你花六百万美金 买了一根香椒"
		},
		{
			"timestamps": {
				"from": "00:00:09,500",
				"to": "00:00:20,500"
			},
			"offsets": {
				"from": 9500,
				"to": 20500
			},
			"text": "为什么不花六百万美金 买黄金 买这个算十买猪吧 也是这个点"
		},
		{
			"timestamps": {
				"from": "00:00:20,500",
				"to": "00:00:26,300"
			},
			"offsets": {
				"from": 20500,
				"to": 26300
			},
			"text": "就是这个香椒啊 它是个概念艺术 它是在网络上传播的"
		},
		{
			"timestamps": {
				"from": "00:00:26,300",
				"to": "00:00:29,980"
			},
			"offsets": {
				"from": 26300,
				"to": 29980
			},
			"text": "他其實是個流動的IP"
		},
		{
			"timestamps": {
				"from": "00:00:29,980",
				"to": "00:00:33,220"
			},
			"offsets": {
				"from": 29980,
				"to": 33220
			},
			"text": "我孫先生講的同意"
		},
		{
			"timestamps": {
				"from": "00:00:33,220",
				"to": "00:00:35,020"
			},
			"offsets": {
				"from": 33220,
				"to": 35020
			},
			"text": "在全世界任何一個國管"
		},
		{
			"timestamps": {
				"from": "00:00:35,020",
				"to": "00:00:37,180"
			},
			"offsets": {
				"from": 35020,
				"to": 37180
			},
			"text": "明天就可以貼上了就可以講了"
		},
		{
			"timestamps": {
				"from": "00:00:37,180",
				"to": "00:00:39,780"
			},
			"offsets": {
				"from": 37180,
				"to": 39780
			},
			"text": "他非常流動"
		},
		{
			"timestamps": {
				"from": "00:00:39,780",
				"to": "00:00:41,780"
			},
			"offsets": {
				"from": 39780,
				"to": 41780
			},
			"text": "他都概念一說"
		},
		{
			"timestamps": {
				"from": "00:00:41,780",
				"to": "00:00:44,220"
			},
			"offsets": {
				"from": 41780,
				"to": 44220
			},
			"text": "但是這個什麼不是"
		},
		{
			"timestamps": {
				"from": "00:00:44,220",
				"to": "00:00:46,220"
			},
			"offsets": {
				"from": 44220,
				"to": 46220
			},
			"text": "黃金珠吧"
		},
		{
			"timestamps": {
				"from": "00:00:46,220",
				"to": "00:00:47,980"
			},
			"offsets": {
				"from": 46220,
				"to": 47980
			},
			"text": "借東西是死的"
		},
		{
			"timestamps": {
				"from": "00:00:47,980",
				"to": "00:00:52,940"
			},
			"offsets": {
				"from": 47980,
				"to": 52940
			},
			"text": "而且你帶一個地方定路帶不走的"
		},
		{
			"timestamps": {
				"from": "00:00:52,940",
				"to": "00:00:56,060"
			},
			"offsets": {
				"from": 52940,
				"to": 56060
			},
			"text": "而且還容易被人偷了"
		},
		{
			"timestamps": {
				"from": "00:00:56,060",
				"to": "00:00:59,140"
			},
			"offsets": {
				"from": 56060,
				"to": 59140
			},
			"text": "对吧 讲实话 你说这个怎么偷呢"
		},
		{
			"timestamps": {
				"from": "00:00:59,400",
				"to": "00:01:00,940"
			},
			"offsets": {
				"from": 59400,
				"to": 60940
			},
			"text": "这个"
		},
		{
			"timestamps": {
				"from": "00:01:01,700",
				"to": "00:01:05,540"
			},
			"offsets": {
				"from": 61700,
				"to": 65540
			},
			"text": "相交偷不了啊 永远跟我的名字绑在一起"
		},
		{
			"timestamps": {
				"from": "00:01:05,540",
				"to": "00:01:07,320"
			},
			"offsets": {
				"from": 65540,
				"to": 67320
			},
			"text": "他是一个数次资产的偷次"
		},
		{
			"timestamps": {
				"from": "00:01:07,580",
				"to": "00:01:09,120"
			},
			"offsets": {
				"from": 67580,
				"to": 69120
			},
			"text": "啊对对对对对"
		},
		{
			"timestamps": {
				"from": "00:01:09,380",
				"to": "00:01:13,220"
			},
			"offsets": {
				"from": 69380,
				"to": 73220
			},
			"text": "但很多人不理解 我跟你讲这个跟我们讲伯基理论一样就是"
		},
		{
			"timestamps": {
				"from": "00:01:13,980",
				"to": "00:01:15,780"
			},
			"offsets": {
				"from": 73980,
				"to": 75780
			},
			"text": "很前言 很心"
		},
		{
			"timestamps": {
				"from": "00:01:17,040",
				"to": "00:01:20,120"
			},
			"offsets": {
				"from": 77040,
				"to": 80120
			},
			"text": "绝大多数今天的中国人接受不了这个理念"
		},
		{
			"timestamps": {
				"from": "00:01:20,380",
				"to": "00:01:22,680"
			},
			"offsets": {
				"from": 80380,
				"to": 82680
			},
			"text": "对 但是是对的"
		},
		{
			"timestamps": {
				"from": "00:01:23,460",
				"to": "00:01:24,480"
			},
			"offsets": {
				"from": 83460,
				"to": 84480
			},
			"text": "但是是对的"
		},
		{
			"timestamps": {
				"from": "00:01:24,740",
				"to": "00:01:27,140"
			},
			"offsets": {
				"from": 84740,
				"to": 87140
			},
			"text": "然后哪儿且 我觉得是这样"
		},
		{
			"timestamps": {
				"from": "00:01:27,140",
				"to": "00:01:31,020"
			},
			"offsets": {
				"from": 87140,
				"to": 91020
			},
			"text": "我们作为步道者的价值也就在这"
		},
		{
			"timestamps": {
				"from": "00:01:31,020",
				"to": "00:01:33,140"
			},
			"offsets": {
				"from": 91020,
				"to": 93140
			},
			"text": "如果我讲的全中国人都知道对的"
		},
		{
			"timestamps": {
				"from": "00:01:33,140",
				"to": "00:01:35,540"
			},
			"offsets": {
				"from": 93140,
				"to": 95540
			},
			"text": "我天天讲一加一等于二也没有意义"
		},
		{
			"timestamps": {
				"from": "00:01:35,540",
				"to": "00:01:39,700"
			},
			"offsets": {
				"from": 95540,
				"to": 99700
			},
			"text": "对不对 大家说你讲一加一等于二也没有什么心意也没有什么"
		},
		{
			"timestamps": {
				"from": "00:01:39,700",
				"to": "00:01:41,700"
			},
			"offsets": {
				"from": 99700,
				"to": 101700
			},
			"text": "特别的 为什么还讲一加一等于二呢"
		},
		{
			"timestamps": {
				"from": "00:01:41,700",
				"to": "00:01:43,860"
			},
			"offsets": {
				"from": 101700,
				"to": 103860
			},
			"text": "我们都知道了 对吧 也都这样说"
		},
		{
			"timestamps": {
				"from": "00:01:43,860",
				"to": "00:01:46,380"
			},
			"offsets": {
				"from": 103860,
				"to": 106380
			},
			"text": "所以我觉得就是这个理论"
		},
		{
			"timestamps": {
				"from": "00:01:46,380",
				"to": "00:01:48,540"
			},
			"offsets": {
				"from": 106380,
				"to": 108540
			},
			"text": "小众其实好事"
		},
		{
			"timestamps": {
				"from": "00:01:48,540",
				"to": "00:01:50,420"
			},
			"offsets": {
				"from": 108540,
				"to": 110420
			},
			"text": "小众说明是风格啊"
		},
		{
			"timestamps": {
				"from": "00:01:50,420",
				"to": "00:01:54,060"
			},
			"offsets": {
				"from": 110420,
				"to": 114060
			},
			"text": "哎 小众说明是风格啊 你讲得太对了"
		},
		{
			"timestamps": {
				"from": "00:01:54,060",
				"to": "00:01:57,140"
			},
			"offsets": {
				"from": 114060,
				"to": 117140
			},
			"text": "小众就没有风稿 你八众都没有意义了嘛"
		},
		{
			"timestamps": {
				"from": "00:01:57,140",
				"to": "00:02:02,260"
			},
			"offsets": {
				"from": 117140,
				"to": 122260
			},
			"text": "所以反而大家不接受骂的多好事 因为我就给你传播啊"
		},
		{
			"timestamps": {
				"from": "00:02:02,260",
				"to": "00:02:06,860"
			},
			"offsets": {
				"from": 122260,
				"to": 126860
			},
			"text": "就传播正确理论 这它以前是我的价值嘛 对不对"
		},
		{
			"timestamps": {
				"from": "00:02:06,860",
				"to": "00:02:12,220"
			},
			"offsets": {
				"from": 126860,
				"to": 132220
			},
			"text": "这个让我推广博弃理论又变得更加坚定了"
		},
		{
			"timestamps": {
				"from": "00:02:12,220",
				"to": "00:02:15,820"
			},
			"offsets": {
				"from": 132220,
				"to": 135820
			},
			"text": "那我想画风一转 换一个话题 就是说"
		}
	]
