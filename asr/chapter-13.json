			},
			"offsets": {
				"from": 377460,
				"to": 382320
			},
			"text": "所以我就讲的是这个确实我觉得就是激动性要强"
		},
		{
			"timestamps": {
				"from": "00:06:22,840",
				"to": "00:06:24,120"
			},
			"offsets": {
				"from": 382840,
				"to": 384120
			},
			"text": "嗯激动性要强"
		},
		{
			"timestamps": {
				"from": "00:06:24,620",
				"to": "00:06:26,920"
			},
			"offsets": {
				"from": 384620,
				"to": 386920
			},
			"text": "所以我自己你看我很少"
		},
		{
			"timestamps": {
				"from": "00:06:27,180",
				"to": "00:06:31,280"
			},
			"offsets": {
				"from": 387180,
				"to": 391280
			},
			"text": "很少就是投资于这个激动性不是太强的事业"
		},
		{
			"timestamps": {
				"from": "00:06:31,800",
				"to": "00:06:33,080"
			},
			"offsets": {
				"from": 391800,
				"to": 393080
			},
			"text": "激动性大强"
		},
		{
			"timestamps": {
				"from": "00:06:33,340",
				"to": "00:06:38,960"
			},
			"offsets": {
				"from": 393340,
				"to": 398960
			},
			"text": "然后当然我就觉得这个理论就是逐水塔而居哪里有哪里能发挥最大价值"
		},
		{
			"timestamps": {
				"from": "00:06:39,220",
				"to": "00:06:41,780"
			},
			"offsets": {
				"from": 399220,
				"to": 401780
			},
			"text": "哪里能让我们就是"
