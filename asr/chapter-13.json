				"from": "00:07:48,080",
				"to": "00:07:50,400"
			},
			"offsets": {
				"from": 468080,
				"to": 470400
			},
			"text": "你另外就走了 对吧"
		},
		{
			"timestamps": {
				"from": "00:07:50,400",
				"to": "00:07:52,560"
			},
			"offsets": {
				"from": 470400,
				"to": 472560
			},
