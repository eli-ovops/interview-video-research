			"timestamps": {
				"from": "00:06:46,640",
				"to": "00:06:49,840"
			},
			"offsets": {
				"from": 406640,
				"to": 409840
			},
			"text": "这个就是我的什么一个理论"
		},
		{
			"timestamps": {
				"from": "00:06:49,840",
				"to": "00:06:51,440"
			},
			"offsets": {
				"from": 409840,
				"to": 411440
			},
			"text": "所以也是一个理论"
		},
		{
			"timestamps": {
				"from": "00:06:51,440",
				"to": "00:06:54,000"
			},
			"offsets": {
				"from": 411440,
				"to": 414000
			},
			"text": "非常同意 我觉得是很有参考价值的"
