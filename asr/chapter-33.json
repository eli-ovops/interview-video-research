				"from": 402460,
				"to": 405520
			},
			"text": "這樣一個概念一直往上去突破"
		},
		{
			"timestamps": {
				"from": "00:06:45,520",
				"to": "00:06:47,420"
			},
			"offsets": {
				"from": 405520,
				"to": 407420
			},
			"text": "你說得太對了"
		},
		{
			"timestamps": {
				"from": "00:06:47,420",
				"to": "00:06:50,380"
			},
			"offsets": {
				"from": 407420,
				"to": 410380
			},
			"text": "我呢 還問我AI"
		},
		{
			"timestamps": {
				"from": "00:06:50,380",
				"to": "00:06:53,580"
			},
			"offsets": {
				"from": 410380,
				"to": 413580
			},
			"text": "就是當然我現在也也也也也也不好說"
		},
		{
			"timestamps": {
				"from": "00:06:53,580",
				"to": "00:06:54,480"
			},
			"offsets": {
				"from": 413580,
				"to": 414480
			},
			"text": "我賺到多少錢 對吧"
		},
		{
			"timestamps": {
				"from": "00:06:54,480",
				"to": "00:06:57,140"
			},
			"offsets": {
				"from": 414480,
				"to": 417140
			},
			"text": "但是我呢"
		},
		{
			"timestamps": {
				"from": "00:06:57,140",
				"to": "00:07:00,540"
			},
			"offsets": {
				"from": 417140,
				"to": 420540
			},
			"text": "試圖問我AI 我們倆都討論過"
		},
		{
			"timestamps": {
				"from": "00:07:00,540",
				"to": "00:07:01,980"
			},
			"offsets": {
				"from": 420540,
				"to": 421980
			},
			"text": "沒說 比如說這個數字"
		},
		{
			"timestamps": {
				"from": "00:07:01,980",
				"to": "00:07:03,360"
			},
			"offsets": {
				"from": 421980,
				"to": 423360
			},
			"text": "也不是个无穷质嘛"
		},
		{
			"timestamps": {
				"from": "00:07:03,360",
				"to": "00:07:04,860"
			},
			"offsets": {
				"from": 423360,
				"to": 424860
			},
			"text": "那肯定有编借"
		},
		{
			"timestamps": {
				"from": "00:07:04,860",
				"to": "00:07:06,540"
			},
			"offsets": {
				"from": 424860,
				"to": 426540
			},
			"text": "我就问挨挨一个很简单的"
		},
		{
			"timestamps": {
				"from": "00:07:06,940",
				"to": "00:07:10,820"
			},
			"offsets": {
				"from": 426940,
				"to": 430820
			},
			"text": "我说就现在我发现现在世界首富一东马斯克"
		},
		{
			"timestamps": {
				"from": "00:07:11,540",
				"to": "00:07:13,980"
			},
			"offsets": {
				"from": 431540,
				"to": 433980
			},
			"text": "可能也就是正两千亿美金"
		},
		{
			"timestamps": {
				"from": "00:07:15,140",
				"to": "00:07:17,540"
			},
			"offsets": {
				"from": 435140,
				"to": 437540
			},
			"text": "我说这位为什么吃这个道理"
		},
		{
			"timestamps": {
				"from": "00:07:17,540",
				"to": "00:07:19,380"
			},
			"offsets": {
				"from": 437540,
				"to": 439380
			},
			"text": "为什么没有人能正义万亿美金"
		},
		{
			"timestamps": {
				"from": "00:07:19,380",
				"to": "00:07:21,900"
			},
			"offsets": {
				"from": 439380,
				"to": 441900
			},
			"text": "为什么没有人能正五万亿美金"
		},
		{
			"timestamps": {
				"from": "00:07:21,900",
				"to": "00:07:23,300"
			},
			"offsets": {
				"from": 441900,
				"to": 443300
			},
			"text": "就是继续往上呢"
		},
		{
			"timestamps": {
				"from": "00:07:24,340",
				"to": "00:07:27,420"
			},
			"offsets": {
				"from": 444340,
				"to": 447420
			},
			"text": "挨挨就给了我一个很很有意思的答案"
		},
		{
			"timestamps": {
				"from": "00:07:28,060",
				"to": "00:07:30,540"
			},
			"offsets": {
				"from": 448060,
				"to": 450540
			},
			"text": "挨挨就说你首先你正多少钱不重要"
		},
		{
			"timestamps": {
				"from": "00:07:30,540",
				"to": "00:07:31,740"
			},
			"offsets": {
				"from": 450540,
				"to": 451740
			},
			"text": "你首先得看"
		},
		{
			"timestamps": {
				"from": "00:07:31,980",
				"to": "00:07:42,980"
			},
			"offsets": {
				"from": 451980,
				"to": 462980
			},
			"text": "其实这个金钱是整个衡量 整个 可接触范围内的经济活动的一个种子"
		},
		{
			"timestamps": {
				"from": "00:07:42,980",
				"to": "00:07:52,980"
			},
			"offsets": {
				"from": 462980,
				"to": 472980
			},
			"text": "比如说你说你美联储 美国的GDP一年也就比如说十一万一 十四万一 十五万一 二十万一"
		},
		{
			"timestamps": {
				"from": "00:07:52,980",
				"to": "00:07:58,980"
			},
			"offsets": {
				"from": 472980,
				"to": 478980
			},
			"text": "再加上中国十万一美金 你总共比如全球GDP可能就四五十万一"
		},
		{
			"timestamps": {
				"from": "00:07:58,980",
				"to": "00:08:06,500"
			},
			"offsets": {
				"from": 478980,
				"to": 486500
			},
			"text": "你说你一个人 一个人 你挣最多钱你就挣地球GDP的1%"
		},
		{
			"timestamps": {
				"from": "00:08:06,500",
				"to": "00:08:10,140"
			},
			"offsets": {
				"from": 486500,
				"to": 490140
			},
			"text": "对不对 那就不想能全地球人的钱都让你一个人挣了吧"
		},
		{
			"timestamps": {
				"from": "00:08:10,140",
				"to": "00:08:15,380"
			},
			"offsets": {
				"from": 490140,
				"to": 495380
			},
			"text": "对不对 那你就是前面他这个经济总职 比如说50万亿"
		},
		{
			"timestamps": {
				"from": "00:08:15,380",
				"to": "00:08:18,980"
			},
			"offsets": {
				"from": 495380,
				"to": 498980
			},
			"text": "对 就决定了你1% 你就最多挣到50万亿"
		},
		{
			"timestamps": {
				"from": "00:08:18,980",
				"to": "00:08:21,260"
			},
			"offsets": {
				"from": 498980,
				"to": 501260
			},
			"text": "对吧"
		},
		{
			"timestamps": {
				"from": "00:08:21,260",
				"to": "00:08:27,540"
			},
			"offsets": {
				"from": 501260,
				"to": 507540
			},
			"text": "然后这个 这个 这个 这个 这个 再加总 说科技本身"
		},
		{
			"timestamps": {
				"from": "00:08:27,540",
				"to": "00:08:30,520"
			},
			"offsets": {
				"from": 507540,
				"to": 510520
			},
			"text": "可能会提升这个调化吧"
		},
		{
			"timestamps": {
				"from": "00:08:30,520",
				"to": "00:08:32,660"
			},
			"offsets": {
				"from": 510520,
				"to": 512660
			},
			"text": "就比如说如果前面没有AI"
		},
		{
			"timestamps": {
				"from": "00:08:32,660",
				"to": "00:08:34,200"
			},
			"offsets": {
				"from": 512660,
				"to": 514200
			},
			"text": "没有这个是东西"
		},
		{
			"timestamps": {
				"from": "00:08:34,200",
				"to": "00:08:36,160"
			},
			"offsets": {
				"from": 514200,
				"to": 516160
			},
			"text": "那正最多钱就只能凭我"
		},
		{
			"timestamps": {
				"from": "00:08:36,160",
				"to": "00:08:37,260"
			},
			"offsets": {
				"from": 516160,
				"to": 517260
			},
			"text": "就把智能手机"
		},
		{
			"timestamps": {
				"from": "00:08:37,260",
				"to": "00:08:40,020"
			},
			"offsets": {
				"from": 517260,
				"to": 520020
			},
			"text": "算以一个美金一个公司就得极限"
		},
		{
			"timestamps": {
				"from": "00:08:40,020",
				"to": "00:08:42,540"
			},
			"offsets": {
				"from": 520020,
				"to": 522540
			},
			"text": "但是现在可能又统博了"
		},
		{
			"timestamps": {
				"from": "00:08:42,540",
				"to": "00:08:43,820"
			},
			"offsets": {
				"from": 522540,
				"to": 523820
			},
			"text": "你未来有AI有这个"
		},
		{
			"timestamps": {
				"from": "00:08:43,820",
				"to": "00:08:45,420"
			},
			"offsets": {
				"from": 523820,
				"to": 525420
			},
			"text": "因为AI会增加集中度"
		},
		{
			"timestamps": {
				"from": "00:08:45,420",
				"to": "00:08:45,900"
			},
			"offsets": {
				"from": 525420,
				"to": 525900
			},
			"text": "对吧"
		},
		{
			"timestamps": {
				"from": "00:08:45,900",
				"to": "00:08:47,460"
			},
			"offsets": {
				"from": 525900,
				"to": 527460
			},
			"text": "这个新行业这个节目"
		},
		{
			"timestamps": {
				"from": "00:08:47,460",
				"to": "00:08:49,900"
			},
			"offsets": {
				"from": 527460,
				"to": 529900
			},
			"text": "你不排出可能有10万亿"
		},
		{
			"timestamps": {
				"from": "00:08:49,900",
				"to": "00:08:52,220"
			},
			"offsets": {
				"from": 529900,
				"to": 532220
			},
			"text": "但是它都是有极限"
		},
		{
			"timestamps": {
				"from": "00:08:52,220",
				"to": "00:08:54,620"
			},
			"offsets": {
				"from": 532220,
				"to": 534620
			},
			"text": "所以就是这个"
		},
		{
			"timestamps": {
				"from": "00:08:54,620",
				"to": "00:08:56,780"
			},
			"offsets": {
				"from": 534620,
				"to": 536780
			},
			"text": "但是这个极限也在不断的"
		},
		{
			"timestamps": {
				"from": "00:08:56,780",
				"to": "00:08:58,820"
			},
			"offsets": {
				"from": 536780,
				"to": 538820
			},
			"text": "被往前退"
		},
		{
			"timestamps": {
				"from": "00:09:00,100",
				"to": "00:09:01,860"
			},
			"offsets": {
				"from": 540100,
				"to": 541860
			},
			"text": "未来举个最简单的意思"
		},
		{
			"timestamps": {
				"from": "00:09:01,860",
				"to": "00:09:03,340"
			},
			"offsets": {
				"from": 541860,
				"to": 543340
			},
			"text": "可能人类发现外星人了"
		},
		{
			"timestamps": {
				"from": "00:09:03,340",
				"to": "00:09:05,420"
			},
			"offsets": {
				"from": 543340,
				"to": 545420
			},
			"text": "我考我们开始星际贸易了"
		},
		{
			"timestamps": {
				"from": "00:09:05,420",
				"to": "00:09:08,700"
			},
			"offsets": {
				"from": 545420,
				"to": 548700
			},
			"text": "那整个基地匹就空前膨胀了"
		},
		{
			"timestamps": {
				"from": "00:09:08,700",
				"to": "00:09:12,660"
			},
			"offsets": {
				"from": 548700,
				"to": 552660
			},
			"text": "的话可能从50万亿直接干到1000万亿了"
		},
		{
			"timestamps": {
				"from": "00:09:12,660",
				"to": "00:09:13,660"
			},
			"offsets": {
				"from": 552660,
				"to": 553660
			},
			"text": "对吧"
		},
		{
			"timestamps": {
				"from": "00:09:14,660",
				"to": "00:09:18,020"
			},
			"offsets": {
				"from": 554660,
				"to": 558020
			},
			"text": "所以我觉得这些东西全部都是动态"
		},
		{
			"timestamps": {
				"from": "00:09:18,020",
				"to": "00:09:20,380"
			},
			"offsets": {
				"from": 558020,
				"to": 560380
			},
			"text": "所以其实正多少钱"
		},
		{
			"timestamps": {
				"from": "00:09:20,380",
				"to": "00:09:21,620"
			},
			"offsets": {
				"from": 560380,
				"to": 561620
			},
			"text": "本质上也是"
		},
		{
			"timestamps": {
				"from": "00:09:21,620",
				"to": "00:09:25,980"
			},
			"offsets": {
				"from": 561620,
				"to": 565980
			},
			"text": "其实只是衡量这个所有动态东西的一个"
		},
		{
			"timestamps": {
				"from": "00:09:25,980",
				"to": "00:09:34,860"
			},
			"offsets": {
				"from": 565980,
				"to": 574860
			},
			"text": "一个度量衡,你刚刚讲的很对,其实就是一个纸,其实除了这个纸之外,不代表正好东西。"
		}
	]
}
