		},
		{
			"timestamps": {
				"from": "00:03:13,320",
				"to": "00:03:14,480"
			},
			"offsets": {
				"from": 193320,
				"to": 194480
			},
			"text": "我們覺得對的"
		},
		{
			"timestamps": {
				"from": "00:03:14,480",
				"to": "00:03:16,540"
			},
			"offsets": {
				"from": 194480,
				"to": 196540
			},
			"text": "那就赶紧可以下检论了"
		},
		{
			"timestamps": {
				"from": "00:03:16,780",
				"to": "00:03:19,600"
			},
			"offsets": {
				"from": 196780,
				"to": 199600
			},
			"text": "就是基本是这么一个理论框架"
		},
		{
			"timestamps": {
				"from": "00:03:19,860",
				"to": "00:03:22,920"
			},
			"offsets": {
				"from": 199860,
				"to": 202920
			},
			"text": "所以我们今天给大家讲的这些博弃孙学这理论"
		},
		{
			"timestamps": {
				"from": "00:03:23,180",
				"to": "00:03:24,460"
			},
			"offsets": {
				"from": 203180,
				"to": 204460
			},
			"text": "这真的是体"
		},
		{
			"timestamps": {
				"from": "00:03:25,240",
				"to": "00:03:26,520"
			},
			"offsets": {
				"from": 205240,
				"to": 206520
			},
			"text": "一线的物"
		},
		{
			"timestamps": {
				"from": "00:03:28,820",
				"to": "00:03:30,860"
			},
			"offsets": {
				"from": 208820,
				"to": 210860
			},
			"text": "最新资料有点像这个"
		},
		{
			"timestamps": {
				"from": "00:03:31,120",
				"to": "00:03:33,160"
			},
			"offsets": {
				"from": 211120,
				"to": 213160
			},
			"text": "最新资料而且是一线人员"
		},
		{
			"timestamps": {
				"from": "00:03:33,680",
				"to": "00:03:35,220"
			},
			"offsets": {
				"from": 213680,
				"to": 215220
			},
			"text": "我们这很多东西不是"
		},
		{
			"timestamps": {
				"from": "00:03:35,480",
				"to": "00:03:36,500"
			},
			"offsets": {
				"from": 215480,
				"to": 216500
			},
			"text": "是自己吹的"
		},
		{
			"timestamps": {
				"from": "00:03:37,000",
				"to": "00:03:40,080"
			},
			"offsets": {
				"from": 217000,
				"to": 220080
			},
			"text": "我现在就是没有发言权的我还不说"
		},
		{
			"timestamps": {
				"from": "00:03:40,080",
				"to": "00:03:41,880"
			},
			"offsets": {
				"from": 220080,
				"to": 221880
			},
			"text": "我就真的物都不通了"
		},
		{
			"timestamps": {
				"from": "00:03:42,640",
				"to": "00:03:43,400"
			},
			"offsets": {
				"from": 222640,
				"to": 223400
			},
			"text": "才说"
		},
		{
			"timestamps": {
				"from": "00:03:43,920",
				"to": "00:03:47,760"
			},
			"offsets": {
				"from": 223920,
				"to": 227760
			},
			"text": "所以我們這個視頻是極其干貨"
		},
		{
			"timestamps": {
				"from": "00:03:47,760",
				"to": "00:03:50,320"
			},
			"offsets": {
				"from": 227760,
				"to": 230320
			},
			"text": "不不同也不敢輕易擦掉了"
		},
		{
			"timestamps": {
				"from": "00:03:50,320",
				"to": "00:03:52,880"
			},
			"offsets": {
				"from": 230320,
				"to": 232880
			},
			"text": "所以我對人生的意義我也想"
		},
		{
			"timestamps": {
				"from": "00:03:53,140",
				"to": "00:03:55,180"
			},
			"offsets": {
				"from": 233140,
				"to": 235180
			},
			"text": "你這樣以前"
		},
		{
			"timestamps": {
				"from": "00:03:55,440",
				"to": "00:03:58,260"
			},
			"offsets": {
				"from": 235440,
				"to": 238260
			},
			"text": "我小的時候就想過很多人生的意義"
		},
		{
			"timestamps": {
				"from": "00:03:58,520",
				"to": "00:04:00,040"
			},
			"offsets": {
				"from": 238520,
				"to": 240040
			},
			"text": "但都逐步被打破"
		},
		{
			"timestamps": {
				"from": "00:04:01,580",
				"to": "00:04:03,640"
			},
			"offsets": {
				"from": 241580,
				"to": 243640
			},
			"text": "比如說我跟你舉個最簡單的例子"
		},
		{
			"timestamps": {
				"from": "00:04:03,900",
				"to": "00:04:06,960"
			},
			"offsets": {
				"from": 243900,
				"to": 246960
			},
			"text": "就以前我小時候人生的意義我都想過"
		},
		{
			"timestamps": {
				"from": "00:04:07,720",
				"to": "00:04:10,040"
			},
			"offsets": {
				"from": 247720,
				"to": 250040
			},
			"text": "我就是為人類為地球做貢獻"
		},
		{
			"timestamps": {
				"from": "00:04:10,540",
				"to": "00:04:11,560"
			},
			"offsets": {
				"from": 250540,
				"to": 251560
			},
			"text": "我想過"
		},
		{
			"timestamps": {
				"from": "00:04:11,820",
				"to": "00:04:13,420"
			},
			"offsets": {
				"from": 251820,
				"to": 253420
			},
			"text": "但这个后来我发现被打破了"
		},
		{
			"timestamps": {
				"from": "00:04:13,420",
				"to": "00:04:15,140"
			},
			"offsets": {
				"from": 253420,
				"to": 255140
			},
			"text": "为什么呢我屈内汤太空"
		},
		{
			"timestamps": {
				"from": "00:04:15,400",
				"to": "00:04:16,420"
			},
			"offsets": {
				"from": 255400,
				"to": 256420
			},
			"text": "后来我发现都不对"
		},
		{
			"timestamps": {
				"from": "00:04:16,940",
				"to": "00:04:18,560"
			},
			"offsets": {
				"from": 256940,
				"to": 258560
			},
			"text": "可能我们人类过去年"
		},
		{
			"timestamps": {
				"from": "00:04:18,560",
				"to": "00:04:20,220"
			},
			"offsets": {
				"from": 258560,
				"to": 260220
			},
			"text": "说不定离开地球了我操"
		},
		{
			"timestamps": {
				"from": "00:04:20,220",
				"to": "00:04:21,300"
			},
			"offsets": {
				"from": 260220,
				"to": 261300
			},
			"text": "那被地球做"
		},
		{
			"timestamps": {
				"from": "00:04:21,540",
				"to": "00:04:22,780"
			},
			"offsets": {
				"from": 261540,
				"to": 262780
			},
			"text": "贡献也没有意义呀"
		},
		{
			"timestamps": {
				"from": "00:04:22,780",
				"to": "00:04:24,380"
			},
			"offsets": {
				"from": 262780,
				"to": 264380
			},
			"text": "我能够为火星做贡献"
		},
		{
			"timestamps": {
				"from": "00:04:24,380",
				"to": "00:04:26,140"
			},
			"offsets": {
				"from": 264380,
				"to": 266140
			},
			"text": "我为别的星球做贡献了"
		},
		{
			"timestamps": {
				"from": "00:04:26,140",
				"to": "00:04:26,420"
			},
			"offsets": {
				"from": 266140,
				"to": 266420
			},
			"text": "对不对"
		},
		{
			"timestamps": {
				"from": "00:04:26,420",
				"to": "00:04:27,940"
			},
			"offsets": {
				"from": 266420,
				"to": 267940
			},
			"text": "那些地球说太窄了"
		},
		{
			"timestamps": {
				"from": "00:04:28,460",
				"to": "00:04:28,780"
			},
			"offsets": {
				"from": 268460,
				"to": 268780
			},
			"text": "对吧"
		},
		{
			"timestamps": {
				"from": "00:04:28,980",
				"to": "00:04:30,500"
			},
			"offsets": {
				"from": 268980,
				"to": 270500
			},
			"text": "后面说为人类贡献"
		},
		{
			"timestamps": {
				"from": "00:04:30,500",
				"to": "00:04:31,180"
			},
			"offsets": {
				"from": 270500,
				"to": 271180
			},
			"text": "那还不一定"
		},
		{
			"timestamps": {
				"from": "00:04:31,180",
				"to": "00:04:32,620"
			},
			"offsets": {
				"from": 271180,
				"to": 272620
			},
			"text": "现在都AI都出来了"
		},
		{
			"timestamps": {
				"from": "00:04:32,620",
				"to": "00:04:33,060"
			},
			"offsets": {
				"from": 272620,
				"to": 273060
			},
			"text": "我看"
		},
		{
			"timestamps": {
				"from": "00:04:33,580",
				"to": "00:04:35,500"
			},
			"offsets": {
				"from": 273580,
				"to": 275500
			},
			"text": "后面有没有其他知名生命体"
		},
		{
			"timestamps": {
				"from": "00:04:35,500",
				"to": "00:04:37,020"
			},
			"offsets": {
				"from": 275500,
				"to": 277020
			},
			"text": "包括人类未来的有没有"
		},
		{
			"timestamps": {
				"from": "00:04:37,020",
				"to": "00:04:38,300"
			},
			"offsets": {
				"from": 277020,
				"to": 278300
			},
			"text": "你也不一定了"
		},
		{
			"timestamps": {
				"from": "00:04:39,460",
				"to": "00:04:40,740"
			},
			"offsets": {
				"from": 279460,
				"to": 280740
			},
			"text": "所以后来我就是"
		},
		{
			"timestamps": {
				"from": "00:04:41,020",
				"to": "00:04:44,340"
			},
			"offsets": {
				"from": 281020,
				"to": 284340
			},
			"text": "就知道的越多就越不敢下結論了"
		},
		{
			"timestamps": {
				"from": "00:04:44,600",
				"to": "00:04:45,640"
			},
			"offsets": {
				"from": 284600,
				"to": 285640
			},
			"text": "所以我現在就是"
		},
		{
			"timestamps": {
				"from": "00:04:45,880",
				"to": "00:04:48,780"
			},
			"offsets": {
				"from": 285880,
				"to": 288780
			},
			"text": "但是我覺得這個遊戲的規律還是能夠"
		},
		{
			"timestamps": {
				"from": "00:04:48,960",
				"to": "00:04:49,720"
			},
			"offsets": {
				"from": 288960,
				"to": 289720
			},
			"text": "體會"
		},
		{
			"timestamps": {
				"from": "00:04:49,980",
				"to": "00:04:51,520"
			},
			"offsets": {
				"from": 289980,
				"to": 291520
			},
			"text": "然後所以在這個遊戲中"
		},
		{
			"timestamps": {
				"from": "00:04:52,280",
				"to": "00:04:54,080"
			},
			"offsets": {
				"from": 292280,
				"to": 294080
			},
			"text": "現在我現在覺得就是"
		},
		{
			"timestamps": {
				"from": "00:04:54,340",
				"to": "00:04:57,920"
			},
			"offsets": {
				"from": 294340,
				"to": 297920
			},
			"text": "有個更深層次的一個話當然也是跟以前的一樣但是"
		}
	]
}
