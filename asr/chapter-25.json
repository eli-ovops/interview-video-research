			},
			"offsets": {
				"from": 203940,
				"to": 206420
			},
			"text": "我給你們都投是嘛 對不對"
		},
		{
			"timestamps": {
				"from": "00:03:26,420",
				"to": "00:03:28,720"
			},
			"offsets": {
				"from": 206420,
				"to": 208720
			},
			"text": "因為他有個新聞就是說"
		},
		{
			"timestamps": {
				"from": "00:03:28,720",
				"to": "00:03:31,060"
			},
			"offsets": {
				"from": 208720,
				"to": 211060
			},
			"text": "閉規員以前就是因為"
		},
		{
			"timestamps": {
				"from": "00:03:31,060",
				"to": "00:03:34,200"
			},
			"offsets": {
				"from": 211060,
				"to": 214200
			},
			"text": "都在合肥什麼做產業開發"
		},
		{
			"timestamps": {
				"from": "00:03:34,200",
				"to": "00:03:36,820"
			},
			"offsets": {
				"from": 214200,
				"to": 216820
			},
			"text": "莫名其妙就投上長心存儲了"
		},
		{
			"timestamps": {
				"from": "00:03:36,820",
				"to": "00:03:38,860"
			},
			"offsets": {
				"from": 216820,
				"to": 218860
			},
			"text": "結果閉規員什麼長心存儲"
		},
		{
			"timestamps": {
				"from": "00:03:38,860",
				"to": "00:03:40,620"
			},
			"offsets": {
				"from": 218860,
				"to": 220620
			},
			"text": "他賺了幾倍火素就給賣了"
		},
		{
			"timestamps": {
				"from": "00:03:40,620",
				"to": "00:03:41,360"
			},
			"offsets": {
				"from": 220620,
				"to": 221360
			},
			"text": "你知道嗎"
		},
		{
			"timestamps": {
				"from": "00:03:41,360",
				"to": "00:03:45,060"
			},
			"offsets": {
				"from": 221360,
				"to": 225060
			},
			"text": "美國是認識 但是這個我就說"
		},
		{
			"timestamps": {
				"from": "00:03:45,060",
				"to": "00:03:47,460"
			},
			"offsets": {
				"from": 225060,
				"to": 227460
			},
			"text": "就是每個大版本地球也會更新"
		},
		{
			"timestamps": {
				"from": "00:03:47,460",
				"to": "00:03:49,740"
			},
			"offsets": {
				"from": 227460,
				"to": 229740
			},
			"text": "你就這個版本就削弱房地產"
		},
		{
			"timestamps": {
				"from": "00:03:49,740",
				"to": "00:03:53,260"
			},
			"offsets": {
				"from": 229740,
				"to": 233260
			},
			"text": "你千万放这产状 想你会不会学乱AI又加成啊"
		},
		{
			"timestamps": {
				"from": "00:03:53,260",
				"to": "00:03:57,780"
			},
			"offsets": {
				"from": 233260,
				"to": 237780
			},
			"text": "有可能在过十年我也不知道会出这么新的AI可能还学乱了"
		},
		{
			"timestamps": {
				"from": "00:03:57,780",
				"to": "00:04:00,940"
			},
			"offsets": {
				"from": 237780,
				"to": 240940
			},
			"text": "对吧 就是它是保持学习 保持更新"
		},
		{
			"timestamps": {
				"from": "00:04:00,940",
				"to": "00:04:06,460"
			},
			"offsets": {
				"from": 240940,
				"to": 246460
			},
			"text": "所以就是 当然我们今天谈得起挺生澳的"
		},
		{
			"timestamps": {
				"from": "00:04:06,460",
				"to": "00:04:10,420"
			},
			"offsets": {
				"from": 246460,
				"to": 250420
			},
			"text": "就黄毛博基孙学 其实就是我们 是吧"
		},
		{
			"timestamps": {
				"from": "00:04:10,420",
				"to": "00:04:15,340"
			},
			"offsets": {
				"from": 250420,
				"to": 255340
			},
			"text": "就是打网这种药的时候 你得先领悟整个网这种药"
		},
		{
			"timestamps": {
				"from": "00:04:15,340",
				"to": "00:04:17,460"
			},
			"offsets": {
				"from": 255340,
				"to": 257460
			},
			"text": "这个游戏的规则 对"
		},
		{
			"timestamps": {
				"from": "00:04:17,460",
				"to": "00:04:20,540"
			},
			"offsets": {
				"from": 257460,
				"to": 260540
			},
			"text": "我们并不是说让你一上来就是苦恋后易"
		},
		{
			"timestamps": {
				"from": "00:04:20,540",
				"to": "00:04:22,580"
			},
			"offsets": {
				"from": 260540,
				"to": 262580
			},
			"text": "你就让他刚刚光光光的狂设见"
		},
		{
			"timestamps": {
				"from": "00:04:22,840",
				"to": "00:04:23,340"
			},
			"offsets": {
				"from": 262840,
				"to": 263340
			},
			"text": "对吧"
		},
		{
			"timestamps": {
				"from": "00:04:23,860",
				"to": "00:04:25,900"
			},
			"offsets": {
				"from": 263860,
				"to": 265900
			},
			"text": "你狂设见没用你一会儿给人抓了"
		},
		{
			"timestamps": {
				"from": "00:04:25,900",
				"to": "00:04:29,300"
			},
			"offsets": {
				"from": 265900,
				"to": 269300
			},
			"text": "一刀就那个刺客就给你给你耿了对不对"
		},
		{
			"timestamps": {
				"from": "00:04:29,300",
				"to": "00:04:32,820"
			},
			"offsets": {
				"from": 269300,
				"to": 272820
			},
			"text": "因为你没有学习整个网络主要的东西"
		},
		{
			"timestamps": {
				"from": "00:04:32,820",
				"to": "00:04:35,120"
			},
			"offsets": {
				"from": 272820,
				"to": 275120
			},
			"text": "你得先学整个网络呀"
		},
		{
			"timestamps": {
				"from": "00:04:35,380",
				"to": "00:04:38,700"
			},
			"offsets": {
				"from": 275380,
				"to": 278700
			},
			"text": "那整个网络重要的他就没有固定拿给你"
		},
		{
			"timestamps": {
				"from": "00:04:38,700",
				"to": "00:04:41,780"
			},
			"offsets": {
				"from": 278700,
				"to": 281780
			},
			"text": "说你说我要练哪个英雄怎么练怎么搞"
		},
		{
			"timestamps": {
				"from": "00:04:41,780",
				"to": "00:04:44,080"
			},
			"offsets": {
				"from": 281780,
				"to": 284080
			},
			"text": "我怎么手速拼手速的了"
		},
		{
			"timestamps": {
				"from": "00:04:44,340",
				"to": "00:04:45,100"
			},
			"offsets": {
				"from": 284340,
				"to": 285100
			},
			"text": "不是这样的"
		},
		{
			"timestamps": {
				"from": "00:04:45,620",
				"to": "00:04:47,920"
			},
			"offsets": {
				"from": 285620,
				"to": 287920
			},
			"text": "你得先搞清楚整個事"
		},
		{
			"timestamps": {
				"from": "00:04:47,920",
				"to": "00:04:49,980"
			},
			"offsets": {
				"from": 287920,
				"to": 289980
			},
			"text": "搞清楚的時候"
		},
		{
			"timestamps": {
				"from": "00:04:49,980",
				"to": "00:04:52,020"
			},
			"offsets": {
				"from": 289980,
				"to": 292020
			},
			"text": "版本還在不斷耕"
		},
		{
			"timestamps": {
				"from": "00:04:52,020",
				"to": "00:04:53,300"
			},
			"offsets": {
				"from": 292020,
				"to": 293300
			},
			"text": "對吧"
		},
		{
			"timestamps": {
				"from": "00:04:53,300",
				"to": "00:04:55,340"
			},
			"offsets": {
				"from": 293300,
				"to": 295340
			},
			"text": "然後你在不斷學"
		},
		{
			"timestamps": {
				"from": "00:04:55,340",
				"to": "00:04:59,020"
			},
			"offsets": {
				"from": 295340,
				"to": 299020
			},
			"text": "只不過唯一的差別是地球阿賴這個版本"
		},
		{
			"timestamps": {
				"from": "00:04:59,020",
				"to": "00:05:01,900"
			},
			"offsets": {
				"from": 299020,
				"to": 301900
			},
			"text": "耕得這個速度可能賣一點"
		},
		{
			"timestamps": {
				"from": "00:05:01,900",
				"to": "00:05:04,700"
			},
			"offsets": {
				"from": 301900,
				"to": 304700
			},
			"text": "倫年耕到兩年耕三年耕"
		},
		{
			"timestamps": {
				"from": "00:05:04,700",
				"to": "00:05:06,340"
			},
			"offsets": {
				"from": 304700,
				"to": 306340
			},
			"text": "忙著挖的版本快"
		},
		{
			"timestamps": {
				"from": "00:05:06,340",
				"to": "00:05:09,940"
			},
			"offsets": {
				"from": 306340,
				"to": 309940
			},
			"text": "一個季度就是幾個月就是一個版本"
		},
		{
			"timestamps": {
				"from": "00:05:09,940",
				"to": "00:05:12,420"
			},
			"offsets": {
				"from": 309940,
				"to": 312420
			},
			"text": "而且你這個鏈這個英雄不強勢了"
		},
		{
			"timestamps": {
				"from": "00:05:12,420",
				"to": "00:05:15,580"
			},
			"offsets": {
				"from": 312420,
				"to": 315580
			},
			"text": "对嘛 来一把你就知道 立刻就死了嘛"
		},
		{
			"timestamps": {
				"from": "00:05:15,580",
				"to": "00:05:18,160"
			},
			"offsets": {
				"from": 315580,
				"to": 318160
			},
			"text": "对吧 这个可能现实生活中你还是需要"
		},
		{
			"timestamps": {
				"from": "00:05:18,160",
				"to": "00:05:19,660"
			},
			"offsets": {
				"from": 318160,
				"to": 319660
			},
			"text": "对 他有质后性"
		},
		{
			"timestamps": {
				"from": "00:05:19,660",
				"to": "00:05:22,520"
			},
			"offsets": {
				"from": 319660,
				"to": 322520
			},
			"text": "他比如说 版本跟了之后你可能三年后才破产"
		},
		{
			"timestamps": {
				"from": "00:05:23,200",
				"to": "00:05:24,400"
			},
			"offsets": {
				"from": 323200,
				"to": 324400
			},
			"text": "对对对"
		},
		{
			"timestamps": {
				"from": "00:05:24,400",
				"to": "00:05:25,740"
			},
			"offsets": {
				"from": 324400,
				"to": 325740
			},
			"text": "他有质后性"
		},
		{
			"timestamps": {
				"from": "00:05:26,500",
				"to": "00:05:28,740"
			},
			"offsets": {
				"from": 326500,
				"to": 328740
			},
			"text": "但是什么随持淡刀"
		},
		{
			"timestamps": {
				"from": "00:05:28,740",
				"to": "00:05:30,200"
			},
			"offsets": {
				"from": 328740,
				"to": 330200
			},
			"text": "对 一定会发生 对"
		},
		{
			"timestamps": {
				"from": "00:05:30,880",
				"to": "00:05:31,720"
			},
			"offsets": {
				"from": 330880,
				"to": 331720
			},
			"text": "对不对 你"
		},
		{
			"timestamps": {
				"from": "00:05:32,040",
				"to": "00:05:34,020"
			},
			"offsets": {
				"from": 332040,
				"to": 334020
			},
			"text": "你就是这也是我刚才讲到这个"
		},
		{
			"timestamps": {
				"from": "00:05:35,220",
				"to": "00:05:37,360"
			},
			"offsets": {
				"from": 335220,
				"to": 337360
			},
			"text": "这个成功人士他不一定"
		},
		{
			"timestamps": {
				"from": "00:05:37,820",
				"to": "00:05:41,220"
			},
			"offsets": {
				"from": 337820,
				"to": 341220
			},
			"text": "对 对吧 那云龙网斯跟一直坚持说我不健身"
		},
		{
			"timestamps": {
				"from": "00:05:41,460",
				"to": "00:05:44,820"
			},
			"offsets": {
				"from": 341460,
				"to": 344820
			},
			"text": "那等一種罵死客這個肌肉掉到無可瓦迴的地步"
		},
		{
			"timestamps": {
				"from": "00:05:44,820",
				"to": "00:05:48,580"
			},
			"offsets": {
				"from": 344820,
				"to": 348580
			},
			"text": "可能要個十五年,對不對?要個十年十五年"
		},
		{
			"timestamps": {
				"from": "00:05:48,580",
				"to": "00:05:53,460"
			},
			"offsets": {
				"from": 348580,
				"to": 353460
			},
			"text": "對不對,但是我們知道就是你如果這樣扛下去"
		},
		{
			"timestamps": {
				"from": "00:05:53,460",
				"to": "00:05:56,020"
			},
			"offsets": {
				"from": 353460,
				"to": 356020
			},
			"text": "你不動絕對會發生"
		},
		{
			"timestamps": {
				"from": "00:05:56,020",
				"to": "00:05:59,060"
			},
			"offsets": {
				"from": 356020,
				"to": 359060
			},
			"text": "而且現在已經進入惡性循環了"
		},
		{
			"timestamps": {
				"from": "00:05:59,060",
				"to": "00:06:03,460"
			},
			"offsets": {
				"from": 359060,
				"to": 363460
			},
			"text": "對吧?你越胖,越打要,打要,越掉肌肉"
		},
		{
			"timestamps": {
				"from": "00:06:03,460",
				"to": "00:06:07,220"
			},
			"offsets": {
				"from": 363460,
				"to": 367220
			},
			"text": "那掉肌肉越容易出事,對吧?越容易出事,越胖"
		},
		{
			"timestamps": {
				"from": "00:06:07,220",
				"to": "00:06:13,360"
			},
			"offsets": {
				"from": 367220,
				"to": 373360
			},
			"text": "因為不練嘛,越胖,越沒救,因為你掉肌肉你也掉你的袋線啊"
		},
		{
			"timestamps": {
				"from": "00:06:13,620",
				"to": "00:06:17,200"
			},
			"offsets": {
				"from": 373620,
				"to": 377200
			},
			"text": "你默認的這個袋線你不就這樣嘛,包括我這麼胖"
		},
		{
			"timestamps": {
				"from": "00:06:17,720",
				"to": "00:06:19,520"
			},
			"offsets": {
				"from": 377720,
				"to": 379520
			},
			"text": "一個核心原因就是因為我"
		},
		{
			"timestamps": {
				"from": "00:06:19,760",
				"to": "00:06:25,140"
			},
			"offsets": {
				"from": 379760,
				"to": 385140
			},
			"text": "20歲的時候我也很帥呀,我還是節尼亞中國區代言人啊你這樣吧,我這是"
		},
		{
			"timestamps": {
				"from": "00:06:25,400",
				"to": "00:06:27,700"
			},
			"offsets": {
				"from": 385400,
				"to": 387700
			},
			"text": "很牛大,那時候這帥哥"
		},
		{
			"timestamps": {
				"from": "00:06:27,960",
				"to": "00:06:31,020"
			},
			"offsets": {
				"from": 387960,
				"to": 391020
			},
			"text": "那為什麼我到30歲就胖了呢,我沒動為什麼就胖了呢"
		},
		{
			"timestamps": {
				"from": "00:06:31,280",
				"to": "00:06:34,860"
			},
			"offsets": {
				"from": 391280,
				"to": 394860
			},
			"text": "就不是因為肌肉掉了,就袋線就掉了嘛,對吧"
		},
		{
			"timestamps": {
				"from": "00:06:35,120",
				"to": "00:06:38,780"
			},
			"offsets": {
				"from": 395120,
				"to": 398780
			},
			"text": "我就自然就吹起去喝水 喝水也長胖了"
		},
		{
			"timestamps": {
				"from": "00:06:38,780",
				"to": "00:06:41,180"
			},
			"offsets": {
				"from": 398780,
				"to": 401180
			},
			"text": "喝水也長胖了 因為你們不動嘛"
		},
		{
			"timestamps": {
				"from": "00:06:41,180",
				"to": "00:06:42,820"
			},
			"offsets": {
				"from": 401180,
				"to": 402820
			},
			"text": "是一樣的東西也胖"
		},
		{
			"timestamps": {
				"from": "00:06:42,820",
				"to": "00:06:46,300"
			},
			"offsets": {
				"from": 402820,
				"to": 406300
			},
			"text": "所以就是一羅罵斯哥 只不過是孫宇全的"
		},
		{
			"timestamps": {
				"from": "00:06:46,300",
				"to": "00:06:53,180"
			},
			"offsets": {
				"from": 406300,
				"to": 413180
			},
			"text": "加強吧 但是我的趕緊36歲 醒過了"
		},
		{
			"timestamps": {
				"from": "00:06:53,180",
				"to": "00:06:55,580"
			},
			"offsets": {
				"from": 413180,
				"to": 415580
			},
			"text": "更醒過了 答不定了"
		},
		{
			"timestamps": {
				"from": "00:06:55,580",
				"to": "00:07:00,380"
			},
			"offsets": {
				"from": 415580,
				"to": 420380
			},
			"text": "答不定了 趕緊加這個版本 加這個8個就修復了"
		},
		{
			"timestamps": {
				"from": "00:07:00,380",
				"to": "00:07:03,340"
			},
			"offsets": {
				"from": 420380,
				"to": 423340
			},
			"text": "我後面就沒有一羅罵斯哥的個問題"
		},
		{
			"timestamps": {
				"from": "00:07:03,340",
				"to": "00:07:05,940"
			},
			"offsets": {
				"from": 423340,
				"to": 425940
			},
			"text": "这个版本扛住不修复"
		},
		{
			"timestamps": {
				"from": "00:07:05,940",
				"to": "00:07:07,660"
			},
			"offsets": {
				"from": 425940,
				"to": 427660
			},
			"text": "那黑客就反复攻击"
		},
		{
			"timestamps": {
				"from": "00:07:07,660",
				"to": "00:07:10,860"
			},
			"offsets": {
				"from": 427660,
				"to": 430860
			},
			"text": "那无论道歉都被偷光了"
		},
		{
			"timestamps": {
				"from": "00:07:10,860",
				"to": "00:07:13,100"
			},
			"offsets": {
				"from": 430860,
				"to": 433100
			},
			"text": "对吧 都命都买了 对吧"
		},
		{
			"timestamps": {
				"from": "00:07:13,100",
				"to": "00:07:17,220"
			},
			"offsets": {
				"from": 433100,
				"to": 437220
			},
			"text": "其实这个英文网组如果尽早修复还来得及"
		},
		{
			"timestamps": {
				"from": "00:07:17,220",
				"to": "00:07:19,220"
			},
			"offsets": {
				"from": 437220,
				"to": 439220
			},
			"text": "但是我觉得英文网组很难了"
		},
		{
			"timestamps": {
				"from": "00:07:19,220",
				"to": "00:07:23,780"
			},
			"offsets": {
				"from": 439220,
				"to": 443780
			},
			"text": "就是除非英文网组已经到它的 level"
		},
		{
			"timestamps": {
				"from": "00:07:23,780",
				"to": "00:07:26,900"
			},
			"offsets": {
				"from": 443780,
				"to": 446900
			},
			"text": "只能是靠自己说服自己"
		},
		{
			"timestamps": {
				"from": "00:07:26,900",
				"to": "00:07:28,740"
			},
			"offsets": {
				"from": 446900,
				"to": 448740
			},
			"text": "对 别人的意见他不会听了"
		},
		{
			"timestamps": {
				"from": "00:07:28,740",
				"to": "00:07:30,500"
			},
			"offsets": {
				"from": 448740,
				"to": 450500
			},
			"text": "对 任何人给他说"
		},
		{
			"timestamps": {
				"from": "00:07:30,500",
				"to": "00:07:32,020"
			},
			"offsets": {
				"from": 450500,
				"to": 452020
			},
			"text": "他都听不进去"
		},
		{
			"timestamps": {
				"from": "00:07:32,020",
				"to": "00:07:33,900"
			},
			"offsets": {
				"from": 452020,
				"to": 453900
			},
			"text": "除非他自己私下"
		},
		{
			"timestamps": {
				"from": "00:07:33,900",
				"to": "00:07:35,060"
			},
			"offsets": {
				"from": 453900,
				"to": 455060
			},
			"text": "你有过了"
		},
		{
			"timestamps": {
				"from": "00:07:35,060",
				"to": "00:07:36,300"
			},
			"offsets": {
				"from": 455060,
				"to": 456300
			},
			"text": "否则就是"
		},
		{
			"timestamps": {
				"from": "00:07:36,300",
				"to": "00:07:37,800"
			},
			"offsets": {
				"from": 456300,
				"to": 457800
			},
			"text": "但是我觉得优骂是个很难的"
		},
		{
			"timestamps": {
				"from": "00:07:37,800",
				"to": "00:07:38,900"
			},
			"offsets": {
				"from": 457800,
				"to": 458900
			},
			"text": "因为他这个"
		},
		{
			"timestamps": {
				"from": "00:07:38,900",
				"to": "00:07:39,940"
			},
			"offsets": {
				"from": 458900,
				"to": 459940
			},
			"text": "细股决定脑袋"
		},
		{
			"timestamps": {
				"from": "00:07:39,940",
				"to": "00:07:42,060"
			},
			"offsets": {
				"from": 459940,
				"to": 462060
			},
			"text": "那边已经先入为主了"
		},
		{
			"timestamps": {
				"from": "00:07:42,060",
				"to": "00:07:42,320"
			},
			"offsets": {
				"from": 462060,
				"to": 462320
			},
			"text": "对"
		},
		{
			"timestamps": {
				"from": "00:07:42,320",
				"to": "00:07:45,780"
			},
			"offsets": {
				"from": 462320,
				"to": 465780
			},
			"text": "你让他实现一个180度的这个大转弯"
		},
		{
			"timestamps": {
				"from": "00:07:45,780",
				"to": "00:07:49,700"
			},
			"offsets": {
				"from": 465780,
				"to": 469700
			},
			"text": "除非就是他得达到这个为人的这个级别"
		},
		{
			"timestamps": {
				"from": "00:07:49,700",
				"to": "00:07:51,680"
			},
			"offsets": {
				"from": 469700,
				"to": 471680
			},
			"text": "或是我觉得有一个场景"
		},
		{
			"timestamps": {
				"from": "00:07:51,680",
				"to": "00:07:53,040"
			},
			"offsets": {
				"from": 471680,
				"to": 473040
			},
			"text": "就是他受一个情商"
		},
		{
			"timestamps": {
				"from": "00:07:53,040",
				"to": "00:07:55,300"
			},
			"offsets": {
				"from": 473040,
				"to": 475300
			},
			"text": "他受一个受一波情商应该可以"
		},
		{
			"timestamps": {
				"from": "00:07:55,300",
				"to": "00:07:56,740"
			},
			"offsets": {
				"from": 475300,
				"to": 476740
			},
			"text": "可以醒悟"
		},
		{
			"timestamps": {
				"from": "00:07:57,740",
				"to": "00:07:58,940"
			},
			"offsets": {
				"from": 477740,
				"to": 478940
			},
			"text": "我觉得也很大"
		},
		{
			"timestamps": {
				"from": "00:07:58,940",
				"to": "00:08:00,700"
			},
			"offsets": {
				"from": 478940,
				"to": 480700
			},
			"text": "因为优骂是个一个很大"
		},
		{
			"timestamps": {
				"from": "00:08:00,700",
				"to": "00:08:02,760"
			},
			"offsets": {
				"from": 480700,
				"to": 482760
			},
			"text": "我覺得它一個很大了"
		},
		{
			"timestamps": {
				"from": "00:08:02,760",
				"to": "00:08:08,200"
			},
			"offsets": {
				"from": 482760,
				"to": 488200
			},
			"text": "它很難去承認說我前面明確表態反對的一個東西"
		},
		{
			"timestamps": {
				"from": "00:08:08,200",
				"to": "00:08:12,060"
			},
			"offsets": {
				"from": 488200,
				"to": 492060
			},
			"text": "我180度打完了"
		},
		{
			"timestamps": {
				"from": "00:08:12,060",
				"to": "00:08:14,700"
			},
			"offsets": {
				"from": 492060,
				"to": 494700
			},
			"text": "能做到這種東西的人我告訴你"
		},
		{
			"timestamps": {
				"from": "00:08:14,700",
				"to": "00:08:18,000"
			},
			"offsets": {
				"from": 494700,
				"to": 498000
			},
			"text": "就是一般如果它還加上那麼強的能力"
		},
		{
			"timestamps": {
				"from": "00:08:18,000",
				"to": "00:08:20,160"
			},
			"offsets": {
				"from": 498000,
				"to": 500160
			},
			"text": "這就是委任幾年了"
		},
		{
			"timestamps": {
				"from": "00:08:20,160",
				"to": "00:08:21,840"
			},
			"offsets": {
				"from": 500160,
				"to": 501840
			},
			"text": "你覺得你能說到嗎"
		},
		{
			"timestamps": {
				"from": "00:08:21,840",
				"to": "00:08:24,940"
			},
			"offsets": {
				"from": 501840,
				"to": 504940
			},
			"text": "我覺得我現階段還是可以做到"
		},
		{
			"timestamps": {
				"from": "00:08:24,940",
				"to": "00:08:26,580"
			},
			"offsets": {
				"from": 504940,
				"to": 506580
			},
			"text": "我現在能夠做到"
		},
		{
			"timestamps": {
				"from": "00:08:26,580",
				"to": "00:08:28,540"
			},
			"offsets": {
				"from": 506580,
				"to": 508540
			},
			"text": "第一個原因我還不夠成功"
		},
		{
			"timestamps": {
				"from": "00:08:28,540",
				"to": "00:08:30,020"
			},
			"offsets": {
				"from": 508540,
				"to": 510020
			},
			"text": "除了我到英俄罵斯克那时候"
		},
		{
			"timestamps": {
				"from": "00:08:30,020",
				"to": "00:08:32,880"
			},
			"offsets": {
				"from": 510020,
				"to": 512880
			},
			"text": "可能英俄大到就是没办法转头了"
		},
		{
			"timestamps": {
				"from": "00:08:33,400",
				"to": "00:08:35,180"
			},
			"offsets": {
				"from": 513400,
				"to": 515180
			},
			"text": "这是第一个情况"
		},
		{
			"timestamps": {
				"from": "00:08:35,440",
				"to": "00:08:38,860"
			},
			"offsets": {
				"from": 515440,
				"to": 518860
			},
			"text": "第二个情况我觉得这个英俄大到能180度转完的人"
		},
		{
			"timestamps": {
				"from": "00:08:38,860",
				"to": "00:08:40,320"
			},
			"offsets": {
				"from": 518860,
				"to": 520320
			},
			"text": "绝对是属于美人"
		},
		{
			"timestamps": {
				"from": "00:08:40,580",
				"to": "00:08:43,900"
			},
			"offsets": {
				"from": 520580,
				"to": 523900
			},
			"text": "这种东西只有中国谁能看到邓小平以前就是这"
		},
		{
			"timestamps": {
				"from": "00:08:44,420",
				"to": "00:08:48,520"
			},
			"offsets": {
				"from": 524420,
				"to": 528520
			},
			"text": "就能从这个完全计划经济的转到市场经济"
		},
		{
			"timestamps": {
				"from": "00:08:49,020",
				"to": "00:08:51,580"
			},
			"offsets": {
				"from": 529020,
				"to": 531580
			},
			"text": "就说原来这个本来要争监预理的"
		},
		{
			"timestamps": {
				"from": "00:08:51,580",
				"to": "00:08:54,400"
			},
			"offsets": {
				"from": 531580,
				"to": 534400
			},
			"text": "我是现在是让他当时拿代表"
		},
		{
			"timestamps": {
				"from": "00:08:54,660",
				"to": "00:08:55,680"
			},
			"offsets": {
				"from": 534660,
				"to": 535680
			},
			"text": "让他开始搞经济"
		},
		{
			"timestamps": {
				"from": "00:08:55,940",
				"to": "00:09:00,940"
			},
			"offsets": {
				"from": 535940,
				"to": 540940
			},
			"text": "我这领导人的2个185转弯这二是太难了"
		},
		{
			"timestamps": {
				"from": "00:09:00,940",
				"to": "00:09:04,940"
			},
			"offsets": {
				"from": 540940,
				"to": 544940
			},
			"text": "尤其在他这种语境下车这种语境下"
		},
		{
			"timestamps": {
				"from": "00:09:04,940",
				"to": "00:09:09,940"
			},
			"offsets": {
				"from": 544940,
				"to": 549940
			},
			"text": "在他这种绝对权力的面前很少人能有这么大的转弯"
		},
		{
			"timestamps": {
				"from": "00:09:09,940",
				"to": "00:09:14,940"
			},
			"offsets": {
				"from": 549940,
				"to": 554940
			},
			"text": "所以我就觉得这个 但是这个其实就是讲白了"
		},
		{
			"timestamps": {
				"from": "00:09:14,940",
				"to": "00:09:18,940"
			},
			"offsets": {
				"from": 554940,
				"to": 558940
			},
			"text": "对于年轻人来说是个机会"
		},
		{
			"timestamps": {
				"from": "00:09:18,940",
				"to": "00:09:20,940"
			},
			"offsets": {
				"from": 558940,
				"to": 560940
			},
			"text": "因为这个转不够挖了"
		},
		{
			"timestamps": {
				"from": "00:09:20,940",
				"to": "00:09:22,940"
			},
			"offsets": {
				"from": 560940,
				"to": 562940
			},
			"text": "所以金融网是个待机时间就变短了"
		},
		{
			"timestamps": {
				"from": "00:09:22,940",
				"to": "00:09:32,340"
			},
			"offsets": {
				"from": 562940,
				"to": 572340
			},
			"text": "对 因为上一个版本的神如果他们不依靠他们不就是大意然后没有这种弱点的话那年轻人就没有机会了"
		},
		{
			"timestamps": {
				"from": "00:09:32,340",
				"to": "00:09:37,540"
			},
			"offsets": {
				"from": 572340,
				"to": 577540
			},
			"text": "所以说这个世界很公平的只有这样才会给人机会 机会"
		},
		{
			"timestamps": {
				"from": "00:09:37,540",
				"to": "00:09:39,340"
			},
			"offsets": {
				"from": 577540,
				"to": 579340
			},
			"text": "对 就是这个道理很公平"
		},
		{
			"timestamps": {
				"from": "00:09:39,340",
				"to": "00:09:45,940"
			},
			"offsets": {
				"from": 579340,
				"to": 585940
			},
			"text": "你知道年轻人为什么天然容易避免这个大意狗吗 有点很简单的原因就是因为他是零起步"
		},
		{
			"timestamps": {
				"from": "00:09:45,940",
				"to": "00:09:50,580"
			},
			"offsets": {
				"from": 585940,
				"to": 590580
			},
			"text": "所以有时候也不要觉得我们年轻零起步 你没钱是惶"
		},
		{
			"timestamps": {
				"from": "00:09:50,580",
				"to": "00:10:20,580"
			},
			"offsets": {
				"from": 590580,
				"to": 620580
			},
			"text": "好事啊,风哥讲的好不好,风哥互联网学,这好事啊,这是好事啊,听你讲完网络,七点很低,现在杀钱都没有,我靠,明天早上睡马路,风哥说,这是好事啊,这是更新孙学黄毛脖鸡的最好时机,好事啊,因为没有包袜,一楼罢子我们给他讲,说孙学黄毛脖鸡,瞧不上车啊,这是好事啊,听你讲完网络,七点很低,现在杀钱都没有,我靠,明天早上睡马路,风哥说,这是好事啊,这是更新孙学黄毛脖鸡的最好时机,好事啊,因为没有包袜,一楼罢子我们给"
		},
		{
			"timestamps": {
				"from": "00:10:20,580",
				"to": "00:10:26,980"
			},
			"offsets": {
				"from": 620580,
				"to": 626980
			},
			"text": "我們發揮的,瞧不上我們,拒絕更新,那你再怎麼也比不上拒絕更新啊,對吧?"
		},
		{
			"timestamps": {
				"from": "00:10:26,980",
				"to": "00:10:37,220"
			},
			"offsets": {
				"from": 626980,
				"to": 637220
			},
			"text": "深圳和我,大家一聽,年輕一聽,我就安裝,以及健安裝,那你就一見,你就要練了勃敬,你就一見跑到英俄色前面去。"
