		},
		{
			"timestamps": {
				"from": "00:02:21,320",
				"to": "00:02:23,480"
			},
			"offsets": {
				"from": 141320,
				"to": 143480
			},
			"text": "他做AI啊 包括做這些"
		},
		{
			"timestamps": {
				"from": "00:02:23,480",
				"to": "00:02:25,440"
			},
			"offsets": {
				"from": 143480,
				"to": 145440
			},
			"text": "都是為了奴隸全人類"
		},
		{
			"timestamps": {
				"from": "00:02:26,080",
				"to": "00:02:27,080"
			},
			"offsets": {
				"from": 146080,
				"to": 147080
			},
			"text": "你懂吧"
		},
		{
			"timestamps": {
				"from": "00:02:27,080",
				"to": "00:02:28,680"
			},
			"offsets": {
				"from": 147080,
				"to": 148680
			},
			"text": "说我这人是打大给我讲"
		},
		{
			"timestamps": {
				"from": "00:02:28,680",
				"to": "00:02:32,080"
			},
			"offsets": {
				"from": 148680,
				"to": 152080
			},
			"text": "他要努力全力才就作业"
		},
		{
			"timestamps": {
				"from": "00:02:32,080",
				"to": "00:02:35,080"
			},
			"offsets": {
				"from": 152080,
				"to": 155080
			},
			"text": "也是刚才讲的就是采取一个动机论"
		},
		{
			"timestamps": {
				"from": "00:02:35,080",
				"to": "00:02:36,080"
			},
			"offsets": {
				"from": 155080,
				"to": 156080
			},
			"text": "动机论"
		},
		{
			"timestamps": {
				"from": "00:02:36,080",
				"to": "00:02:39,080"
			},
			"offsets": {
				"from": 156080,
				"to": 159080
			},
			"text": "然后包括三毛泽满有一个弟弟"
		},
		{
			"timestamps": {
				"from": "00:02:39,080",
				"to": "00:02:40,080"
			},
			"offsets": {
				"from": 159080,
				"to": 160080
			},
			"text": "不知道还是一个妹妹"
		},
		{
			"timestamps": {
				"from": "00:02:40,080",
				"to": "00:02:41,580"
			},
			"offsets": {
				"from": 160080,
				"to": 161580
			},
			"text": "跟他关系也不好"
		},
		{
			"timestamps": {
				"from": "00:02:41,580",
				"to": "00:02:44,080"
			},
			"offsets": {
				"from": 161580,
				"to": 164080
			},
			"text": "然后那个人接受媒体采访经常说"
		},
		{
			"timestamps": {
				"from": "00:02:44,080",
				"to": "00:02:46,080"
			},
			"offsets": {
				"from": 164080,
				"to": 166080
			},
			"text": "大家千万不要相信三毛泽满"
		},
		{
			"timestamps": {
				"from": "00:02:46,080",
				"to": "00:02:50,080"
			},
			"offsets": {
				"from": 166080,
				"to": 170080
			},
			"text": "因为他就是做AI就是为了自私自立指"
		},
		{
			"timestamps": {
				"from": "00:02:50,080",
				"to": "00:02:52,080"
			},
			"offsets": {
				"from": 170080,
				"to": 172080
			},
			"text": "是为了获得"
		},
		{
			"timestamps": {
				"from": "00:02:52,080",
				"to": "00:02:54,080"
			},
			"offsets": {
				"from": 172080,
				"to": 174080
			},
			"text": "我获得利润"
		},
		{
			"timestamps": {
				"from": "00:02:54,080",
				"to": "00:02:59,480"
			},
			"offsets": {
				"from": 174080,
				"to": 179480
			},
			"text": "但是这个也是这个动机论嘛,因为三毛的埋英马斯克其实本质上"
		},
		{
			"timestamps": {
				"from": "00:02:59,480",
				"to": "00:03:03,480"
			},
			"offsets": {
				"from": 179480,
				"to": 183480
			},
			"text": "他做着什么东西这个平价是脱离他本人的"
		},
		{
			"timestamps": {
				"from": "00:03:03,480",
				"to": "00:03:06,480"
			},
			"offsets": {
				"from": 183480,
				"to": 186480
			},
			"text": "对吧,他这个做的这个东西有没有用呢"
		},
		{
			"timestamps": {
				"from": "00:03:06,480",
				"to": "00:03:10,680"
			},
			"offsets": {
				"from": 186480,
				"to": 190680
			},
			"text": "大家其实本质上是跟他人品讲白了也没什么太大关系"
		},
		{
			"timestamps": {
				"from": "00:03:10,680",
				"to": "00:03:17,880"
			},
			"offsets": {
				"from": 190680,
				"to": 197880
			},
			"text": "对,那类似于这个网上可能说我最近这些发言是推广博弃女人是吃黑柳"
		},
		{
			"timestamps": {
				"from": "00:03:17,880",
				"to": "00:03:22,080"
			},
			"offsets": {
				"from": 197880,
				"to": 202080
			},
			"text": "但是我觉得你不用在乎我吃黑柳,你要管的是我说的东西对你有没有价值"
		},
		{
			"timestamps": {
				"from": "00:03:22,080",
				"to": "00:03:23,280"
			},
			"offsets": {
				"from": 202080,
				"to": 203280
			},
			"text": "他是不是科学"
		},
		{
			"timestamps": {
				"from": "00:03:23,520",
				"to": "00:03:25,360"
			},
			"offsets": {
				"from": 203520,
				"to": 205360
			},
			"text": "应该对不要管我的动机"
		},
		{
			"timestamps": {
				"from": "00:03:25,360",
				"to": "00:03:26,560"
			},
			"offsets": {
				"from": 205360,
				"to": 206560
			},
			"text": "而是管这些现在对错"
		},
		{
			"timestamps": {
				"from": "00:03:26,560",
				"to": "00:03:27,360"
			},
			"offsets": {
				"from": 206560,
				"to": 207360
			},
			"text": "对"
		},
		{
			"timestamps": {
				"from": "00:03:27,680",
				"to": "00:03:28,880"
			},
			"offsets": {
				"from": 207680,
				"to": 208880
			},
			"text": "对是太对了"
		},
		{
			"timestamps": {
				"from": "00:03:28,880",
				"to": "00:03:29,360"
			},
			"offsets": {
				"from": 208880,
				"to": 209360
			},
			"text": "对啊"
		},
		{
			"timestamps": {
				"from": "00:03:29,360",
				"to": "00:03:30,800"
			},
			"offsets": {
				"from": 209360,
				"to": 210800
			},
			"text": "你就包括以前我们"
		},
		{
			"timestamps": {
				"from": "00:03:30,800",
				"to": "00:03:32,280"
			},
			"offsets": {
				"from": 210800,
				"to": 212280
			},
			"text": "但是这动机论了"
		},
		{
			"timestamps": {
				"from": "00:03:32,280",
				"to": "00:03:33,080"
			},
			"offsets": {
				"from": 212280,
				"to": 213080
			},
			"text": "屁股决定了"
		},
		{
			"timestamps": {
				"from": "00:03:33,080",
				"to": "00:03:34,960"
			},
			"offsets": {
				"from": 213080,
				"to": 214960
			},
			"text": "但是我很能说服励你万一"
		},
		{
			"timestamps": {
				"from": "00:03:34,960",
				"to": "00:03:36,080"
			},
			"offsets": {
				"from": 214960,
				"to": 216080
			},
			"text": "对对对"
		},
		{
			"timestamps": {
				"from": "00:03:36,080",
				"to": "00:03:36,400"
			},
			"offsets": {
				"from": 216080,
				"to": 216400
			},
			"text": "对吧"
		},
		{
			"timestamps": {
				"from": "00:03:36,400",
				"to": "00:03:38,080"
			},
			"offsets": {
				"from": 216400,
				"to": 218080
			},
			"text": "就是经常就我刚刚讲"
		},
		{
			"timestamps": {
				"from": "00:03:38,080",
				"to": "00:03:40,360"
			},
			"offsets": {
				"from": 218080,
				"to": 220360
			},
			"text": "但很多我以前也是受这个错误想念的"
		},
		{
			"timestamps": {
				"from": "00:03:40,360",
				"to": "00:03:41,000"
			},
			"offsets": {
				"from": 220360,
				"to": 221000
			},
			"text": "就是说"
		},
		{
			"timestamps": {
				"from": "00:03:41,000",
				"to": "00:03:43,080"
			},
			"offsets": {
				"from": 221000,
				"to": 223080
			},
			"text": "练肌肉就是为了泡牛"
		},
		{
			"timestamps": {
				"from": "00:03:43,080",
				"to": "00:03:45,040"
			},
			"offsets": {
				"from": 223080,
				"to": 225040
			},
			"text": "虽然是很没错的一个想法"
		},
		{
			"timestamps": {
				"from": "00:03:45,040",
				"to": "00:03:46,040"
			},
			"offsets": {
				"from": 225040,
				"to": 226040
			},
			"text": "咱不能泡牛"
		},
		{
			"timestamps": {
				"from": "00:03:46,040",
				"to": "00:03:47,440"
			},
			"offsets": {
				"from": 226040,
				"to": 227440
			},
			"text": "要任人学习的"
		},
		{
			"timestamps": {
				"from": "00:03:47,440",
				"to": "00:03:49,480"
			},
			"offsets": {
				"from": 227440,
				"to": 229480
			},
			"text": "就是这个以前这种思路的"
		},
		{
			"timestamps": {
				"from": "00:03:49,480",
				"to": "00:03:50,520"
			},
			"offsets": {
				"from": 229480,
				"to": 230520
			},
			"text": "打压这种"
		},
		{
			"timestamps": {
				"from": "00:03:50,520",
				"to": "00:03:51,920"
			},
			"offsets": {
				"from": 230520,
				"to": 231920
			},
			"text": "打压这种想法"
		},
		{
			"timestamps": {
				"from": "00:03:52,080",
				"to": "00:04:01,280"
			},
			"offsets": {
				"from": 232080,
				"to": 241280
			},
			"text": "所以说哎,那我就为了避嫌,对吧,避嫌怕大家觉得我是一个作风不正的人,看完一下讲的吧,我连肌肉都不敢量了"
		},
		{
			"timestamps": {
				"from": "00:04:01,280",
				"to": "00:04:06,980"
			},
			"offsets": {
				"from": 241280,
				"to": 246980
			},
			"text": "那我不电肌肉不就代表我就是好学生嘛,代表我远离这个思想"
		},
		{
			"timestamps": {
				"from": "00:04:06,980",
				"to": "00:04:11,980"
			},
			"offsets": {
				"from": 246980,
				"to": 251980
			},
			"text": "我要一进健身房很多人就说哎,你是不是最近要泡牛了,所以你去健身的"
		},
		{
			"timestamps": {
				"from": "00:04:11,980",
				"to": "00:04:18,980"
			},
			"offsets": {
				"from": 251980,
				"to": 258980
			},
			"text": "就不是经常很多人经常讲,就是说什么中年人就是一健身那就是可能要出会啊,中年危机了"
		},
		{
			"timestamps": {
				"from": "00:04:18,980",
				"to": "00:04:20,660"
			},
			"offsets": {
				"from": 258980,
				"to": 260660
			},
			"text": "对 他要出现威胁了"
		},
		{
			"timestamps": {
				"from": "00:04:20,660",
				"to": "00:04:23,540"
			},
			"offsets": {
				"from": 260660,
				"to": 263540
			},
			"text": "而且给你老婆进场演的那说"
		},
		{
			"timestamps": {
				"from": "00:04:23,540",
				"to": "00:04:26,220"
			},
			"offsets": {
				"from": 263540,
				"to": 266220
			},
			"text": "你要出轨 所以健身的"
		},
		{
			"timestamps": {
				"from": "00:04:26,220",
				"to": "00:04:30,740"
			},
			"offsets": {
				"from": 266220,
				"to": 270740
			},
			"text": "其实人家未必 人家为什么一定要是出轨的健身"
		},
		{
			"timestamps": {
				"from": "00:04:30,740",
				"to": "00:04:33,180"
			},
			"offsets": {
				"from": 270740,
				"to": 273180
			},
			"text": "对吧 二者都根本就没关系"
		},
		{
			"timestamps": {
				"from": "00:04:33,180",
				"to": "00:04:36,380"
			},
			"offsets": {
				"from": 273180,
				"to": 276380
			},
			"text": "但是就是为了抹黑马为了阻打你去做的这个事"
		},
		{
			"timestamps": {
				"from": "00:04:36,380",
				"to": "00:04:39,460"
			},
			"offsets": {
				"from": 276380,
				"to": 279460
			},
			"text": "所以就是各种动机论就来了"
		},
		{
			"timestamps": {
				"from": "00:04:39,460",
				"to": "00:04:42,500"
			},
			"offsets": {
				"from": 279460,
				"to": 282500
			},
			"text": "我想说一下就刚才聊到这Crypt的这个东西"
		},
		{
			"timestamps": {
				"from": "00:04:42,500",
				"to": "00:04:44,340"
			},
			"offsets": {
				"from": 282500,
				"to": 284340
			},
			"text": "其实我感觉他跟我很多的认知"
		},
		{
			"timestamps": {
				"from": "00:04:44,340",
				"to": "00:04:46,020"
			},
			"offsets": {
				"from": 284340,
				"to": 286020
			},
			"text": "就是你完全的reinforce"
		}
	]
}
